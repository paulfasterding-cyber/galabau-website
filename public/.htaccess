Options -MultiViews
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# ─── HTTPS-Weiterleitung ──────────────────────────────────────────────────────
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ─── Security Headers ─────────────────────────────────────────────────────────
<IfModule mod_headers.c>

  # Verhindert MIME-Type-Sniffing (Browser soll Dateityp nicht raten)
  Header always set X-Content-Type-Options "nosniff"

  # Verhindert Clickjacking (Seite darf nicht in Iframe eingebettet werden)
  Header always set X-Frame-Options "SAMEORIGIN"

  # HTTPS-Pflicht für 1 Jahr (Browser merkt sich: immer HTTPS für diese Domain)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Referrer: nur Domain weitergeben, kein voller Pfad
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Browser-APIs einschränken (Kamera, Mikrofon, Standort aus)
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # Content-Security-Policy:
  # - Eigene Domain: erlaubt
  # - Inline-Scripts/Styles: nötig (Astro nutzt sie intern)
  # - Google Analytics/Tag Manager: erlaubt
  # - Supabase API: erlaubt (für Onboarding-Seite)
  # - Vercel API: erlaubt (Lead-Formular sendet dorthin)
  # - Google Fonts: erlaubt (galabau-garantie nutzt Fraunces)
  # - Plugins (Flash etc.): komplett gesperrt
  Header always set Content-Security-Policy "\
default-src 'self'; \
script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://googleads.g.doubleclick.net https://www.googleadservices.com; \
style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; \
img-src 'self' data: blob: https://www.google-analytics.com https://www.googletagmanager.com; \
font-src 'self' data: https://fonts.gstatic.com; \
connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com https://djcvqnswbkipjwpmlisj.supabase.co https://fastraone-admin.vercel.app; \
object-src 'none'; \
base-uri 'self'; \
form-action 'self'; \
frame-ancestors 'self'"

  # Verhindert dass der Browser alte unsichere Protokolle (wie HTTP) nutzt
  Header always set X-Permitted-Cross-Domain-Policies "none"

</IfModule>

# ─── Verzeichnis-Listing deaktivieren ─────────────────────────────────────────
Options -Indexes

# ─── Sensible Dateien sperren ─────────────────────────────────────────────────
<FilesMatch "\.(env|log|git|gitignore|json|lock|md|toml|yml|yaml|sh|bak|tmp|orig)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# Wichtige Dateien explizit wieder erlauben
<FilesMatch "^(manifest\.json|robots\.txt|sitemap\.xml|llms\.txt)$">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
</FilesMatch>

# ─── Caching für statische Assets ─────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
