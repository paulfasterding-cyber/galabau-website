---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="GaLaBau-Ergebnisse: Mehr Aufträge durch Webdesign & Google Ads | Fastra One"
  description="Echte Ergebnisse aus dem Garten- & Landschaftsbau: Wie Fastra One GaLaBau-Betrieben mit Website, Google Ads und lokalem SEO zu planbar mehr Aufträgen verholfen hat."
  canonical="https://fastraone.de/case-studies"
  navVariant="back"
  footerVariant="full"
>
  <Fragment slot="head">
    <meta property="og:title" content="GaLaBau-Ergebnisse: Mehr Aufträge durch Webdesign & Google Ads | Fastra One" />
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://fastraone.de/" },
        { "@type": "ListItem", "position": 2, "name": "Ergebnisse & Case Studies" }
      ]
    }
    </script>
    <meta property="og:description" content="Echte Projekte aus dem GaLaBau: Wie Fastra One Betrieben mit Website, Google Ads & KI-Lead-System zu planbar mehr Anfragen verholfen hat." />
    <!--
      TODO (Paul): Vor dem Live-Gang die Platzhalter-Cases durch ECHTE Kundenprojekte ersetzen.
      Erfundene Ergebnisse dürfen nicht als reale Erfolge veröffentlicht werden (UWG).
      Pro Case: echtes Bild, echter Betrieb/Branche, echte Ausgangslage, Maßnahmen & messbare Zahlen.
    -->
  </Fragment>

  <style is:global>
body{background:#0b0f1a}
.head h1{font-size:clamp(2.1rem,5.5vw,3.4rem);line-height:1.06;max-width:16ch}

/* KPI-STREIFEN */
.kpis{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;max-width:760px;margin:44px auto 0}
.kpi{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.09);border-radius:18px;padding:22px 20px;text-align:center}
.kpi strong{display:block;font-family:var(--f-head);font-size:clamp(1.7rem,4vw,2.3rem);font-weight:800;letter-spacing:-.02em;color:#6EEC9D}
.kpi span{font-size:.9rem;color:rgba(255,255,255,.38)}
@media(min-width:760px){.kpis{grid-template-columns:repeat(4,1fr)}}

/* CASE-GRID */
.cases{display:grid;grid-template-columns:1fr;gap:26px;margin-top:18px}
.case{position:relative;display:flex;flex-direction:column;background:#fff;border:1px solid rgba(0,0,0,.07);border-radius:24px;overflow:hidden;box-shadow:var(--shadow-card);transition:transform .25s ease,box-shadow .25s ease}
.case:hover{transform:translateY(-6px);box-shadow:0 20px 50px rgba(0,0,0,.11);border-color:rgba(110,236,157,.4)}
.case__media{position:relative;height:230px;overflow:hidden}
.case__media img{width:100%;height:100%;object-fit:cover}
.case__cat{position:absolute;top:16px;left:16px;display:inline-flex;align-items:center;gap:7px;background:rgba(0,0,0,.45);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);font-size:.78rem;font-weight:700;color:#fff;padding:7px 14px;border-radius:var(--pill);box-shadow:0 4px 12px rgba(0,0,0,.3)}
.case__cat .dotg{width:8px;height:8px;border-radius:50%;background:#6EEC9D}
.case__body{padding:26px 28px 30px;display:flex;flex-direction:column;flex:1}
.case__client{font-size:.85rem;font-weight:600;color:var(--blue-strong);letter-spacing:.01em}
.case__title{margin-top:6px;font-family:var(--f-head);font-size:1.35rem;font-weight:800;letter-spacing:-.02em;line-height:1.18;color:var(--ink)}
.case__text{margin-top:12px;color:var(--ink-soft);font-size:.97rem}
.case__stats{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px}
.case__stat{flex:1;min-width:120px;background:var(--bg);border:1px solid rgba(0,0,0,.06);border-radius:14px;padding:13px 14px}
.case__stat b{display:block;font-family:var(--f-head);font-size:1.4rem;font-weight:800;letter-spacing:-.02em;color:var(--blue-strong)}
.case__stat span{font-size:.8rem;color:var(--gray-2)}
.case__link{margin-top:22px;display:inline-flex;align-items:center;gap:8px;font-weight:600;color:var(--blue-strong);font-size:.95rem}
.case__link svg{width:16px;height:16px;transition:transform .2s ease}
.case:hover .case__link svg{transform:translateX(4px)}
@media(min-width:840px){
  .cases{grid-template-columns:1fr 1fr}
  .case--wide{grid-column:1/-1;flex-direction:column}
  .case--wide .case__media{width:100%;max-width:740px;margin-inline:auto;height:auto;min-height:0;aspect-ratio:3/2;padding:18px;overflow:visible}
  .case--wide .case__media img{border-radius:14px;border:1px solid rgba(255,255,255,.06);box-shadow:0 12px 30px rgba(0,0,0,.4)}
  .case--wide .case__cat{top:32px;left:32px}
  .case--wide .case__body{width:100%;padding:14px 40px 36px}
  .case--wide .case__title{font-size:1.7rem}
}

/* CTA */
.ccta{padding:80px 0}
.ccta__card{position:relative;overflow:hidden;background:#fff;border:1px solid rgba(0,0,0,.07);border-radius:28px;padding:56px 26px;text-align:center;box-shadow:0 8px 30px rgba(0,0,0,.06)}
.ccta h2{font-family:var(--f-head);font-size:clamp(1.8rem,4.6vw,2.6rem);font-weight:800;letter-spacing:-.03em;line-height:1.1;max-width:18ch;margin-inline:auto;color:#0c0d10}
.ccta p{margin:14px auto 0;max-width:46ch;color:#565a66;font-size:1.05rem}
.ccta .btn{margin-top:26px}

@media(prefers-reduced-motion:reduce){.case:hover{transform:none}}
  </style>

  <main>
    <section class="head head--dark">
      <div class="hd-bg" aria-hidden="true"></div>
      <div class="container">
        <div class="head__pill"><span class="dot" aria-hidden="true"></span>Ergebnisse aus dem Garten- &amp; Landschaftsbau</div>
        <h1>Ergebnisse, die für sich sprechen</h1>
        <p>Echte Projekte aus dem GaLaBau: Wie wir Betrieben mit Website, Google Ads und KI-Lead-System zu planbar mehr Anfragen verholfen haben.</p>

        <div class="kpis">
          <div class="kpi reveal"><strong>+340%</strong><span>mehr Anfragen ⌀</span></div>
          <div class="kpi reveal"><strong>4,2×</strong><span>ROAS auf Ads</span></div>
          <div class="kpi reveal"><strong>14 Tage</strong><span>bis zur ersten Anfrage</span></div>
          <div class="kpi reveal"><strong>#1</strong><span>bei Google lokal</span></div>
        </div>
      </div>
    </section>

    <div aria-hidden="true" style="line-height:0;background:#0b0f1a">
      <svg viewBox="0 0 1440 70" preserveAspectRatio="none" style="width:100%;height:70px;display:block">
        <path d="M0,35 C360,70 1080,0 1440,35 L1440,70 L0,70 Z" fill="#f5f5f5"/>
      </svg>
    </div>

    <div style="background:var(--bg)">
    <section class="section" style="padding:60px 0 0">
      <div class="container">
        <div class="cases">

          <article class="case case--wide reveal">
            <div class="case__media">
              <span class="case__cat"><span class="dotg"></span>Website-Launch</span>
              <img src="assets/case-entruempelung.png" alt="Neue Website für ein Entrümpelungs- &amp; Haushaltsauflösungs-Unternehmen, dargestellt auf einem Laptop" width="1536" height="1024" loading="lazy" decoding="async" />
            </div>
            <div class="case__body">
              <span class="case__client">Entrümpelung &amp; Haushaltsauflösung · Raum Hannover</span>
              <h2 class="case__title">7 Anrufe mit Auftrag, schon am ersten Tag nach dem Launch</h2>
              <p class="case__text">Vorher kamen Aufträge fast nur über Empfehlung. Wir haben eine neue, conversion-starke Website gebaut: glasklares Angebot, sofortige Erreichbarkeit per Klick-zum-Anrufen und lokale Sichtbarkeit für genau die Leute, die gerade entrümpeln müssen. Das Ergebnis ließ nicht auf sich warten. Bereits am Tag des Launches kamen <strong>7 Anrufe mit konkreten Aufträgen</strong> rein. Seitdem ist der Anfragestrom stetig weiter gewachsen.</p>
              <div class="case__stats">
                <div class="case__stat"><b>7</b><span>Anrufe mit Auftrag am Tag&nbsp;1</span></div>
                <div class="case__stat"><b>Tag&nbsp;1</b><span>erste Aufträge ab Launch</span></div>
                <div class="case__stat"><b>stetig&nbsp;↑</b><span>wachsende Anfragen seitdem</span></div>
              </div>
              <a href="/kontakt" class="case__link">Ähnliches Ergebnis besprechen
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
              </a>
            </div>
          </article>

          <article class="case reveal">
            <div class="case__media">
              <span class="case__cat"><span class="dotg"></span>Google Ads</span>
              <img src="assets/person-window.jpg" alt="Case Study Google Ads für einen Pflaster- & Wegebau-Betrieb" width="6720" height="4480" loading="lazy" decoding="async" />
            </div>
            <div class="case__body">
              <span class="case__client">Beispiel: Pflaster &amp; Wege GmbH</span>
              <h2 class="case__title">Werbebudget mit klarem ROI statt Verpuffen</h2>
              <p class="case__text">Bestehendes Ad-Konto neu strukturiert, Streuverluste eliminiert und auf kaufbereite Suchanfragen fokussiert.</p>
              <div class="case__stats">
                <div class="case__stat"><b>−58%</b><span>Kosten pro Anfrage</span></div>
                <div class="case__stat"><b>3,8×</b><span>ROAS</span></div>
              </div>
              <a href="/kontakt" class="case__link">Mehr erfahren
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
              </a>
            </div>
          </article>

          <article class="case reveal">
            <div class="case__media">
              <span class="case__cat"><span class="dotg"></span>Website &amp; SEO</span>
              <img src="assets/laptop-person.jpg" alt="Case Study Website & SEO für einen Baumpflege-Betrieb" width="5472" height="3648" loading="lazy" decoding="async" />
            </div>
            <div class="case__body">
              <span class="case__client">Beispiel: Baumpflege Nord</span>
              <h2 class="case__title">Lokal sichtbar &amp; rund um die Uhr anfragbar</h2>
              <p class="case__text">Schnelle, mobile Website mit lokalem SEO. Gefunden werden, wenn Kunden in der Region suchen.</p>
              <div class="case__stats">
                <div class="case__stat"><b>Top 3</b><span>für 12 Keywords</span></div>
                <div class="case__stat"><b>2,4×</b><span>mehr Website-Anfragen</span></div>
              </div>
              <a href="/kontakt" class="case__link">Mehr erfahren
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
              </a>
            </div>
          </article>

        </div>
      </div>
    </section>

    <section class="ccta">
      <div class="container">
        <div class="ccta__card reveal">
          <h2>Wird dein Betrieb der nächste Case?</h2>
          <p>Im kostenlosen Erstgespräch zeigen wir dir konkret, welches Ergebnis für deinen Betrieb realistisch ist, ganz unverbindlich.</p>
          <a href="/kontakt" class="btn btn--primary btn--lg">Gratis Erstgespräch sichern <span class="btn__arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg></span></a>
        </div>
      </div>
    </section>
    </div>
  </main>

  <Fragment slot="scripts">
    <script is:inline>
    (function(){
      "use strict";
      if(!("IntersectionObserver" in window)){document.querySelectorAll(".reveal").forEach(function(e){e.classList.add("is-visible")});return;}
      var o=new IntersectionObserver(function(en){en.forEach(function(x){if(x.isIntersecting){x.target.classList.add("is-visible");o.unobserve(x.target);}})},{threshold:.15});
      document.querySelectorAll(".reveal").forEach(function(e){o.observe(e)});
    })();
    </script>
  </Fragment>
</BaseLayout>
