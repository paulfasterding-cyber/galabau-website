<script is:inline>

var _gd = { vorname:'', nachname:'', phone:'', email:'' };
var _step = 0;

function scrollToFunnel() {
  document.getElementById('funnel').scrollIntoView({ behavior: 'smooth', block: 'start' });
  setTimeout(function() { document.getElementById('g-vorname').focus(); }, 600);
}

function updateProgress(step) {
  for (var i = 0; i < 4; i++) {
    var dot = document.getElementById('dot-' + i);
    dot.className = 'g-progress-dot';
    if (i < step)  dot.classList.add('done');
    if (i === step) dot.classList.add('active');
  }
}

function showStep(n) {
  for (var i = 0; i < 4; i++) {
    var s = document.getElementById('step-' + i);
    if (s) { s.className = 'g-step' + (i === n ? ' visible' : ''); }
  }
  updateProgress(n);
  _step = n;
  // Focus input
  var ids = ['g-vorname','g-nachname','g-phone','g-email'];
  var inp = document.getElementById(ids[n]);
  if (inp) setTimeout(function(){ inp.focus(); }, 100);
}

function nextStep(current) {
  var ids = ['g-vorname','g-nachname','g-phone','g-email'];
  var keys = ['vorname','nachname','phone','email'];
  var val = document.getElementById(ids[current]).value.trim();
  var errEl = document.getElementById('err-' + current);

  // Validate
  var ok = false;
  if (current === 0) ok = val.length >= 2;
  if (current === 1) ok = val.length >= 2;
  if (current === 2) ok = val.replace(/\s/g,'').length >= 6;
  if (current === 3) ok = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val);

  if (!ok) {
    errEl.className = 'g-err-msg show';
    document.getElementById(ids[current]).classList.add('error');
    return;
  }
  errEl.className = 'g-err-msg';
  document.getElementById(ids[current]).classList.remove('error');
  _gd[keys[current]] = val;
  showStep(current + 1);
}

function submitForm() {
  // Validate email first
  var email = document.getElementById('g-email').value.trim();
  var errEl = document.getElementById('err-3');
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
    errEl.className = 'g-err-msg show';
    document.getElementById('g-email').classList.add('error');
    return;
  }
  _gd.email = email;

  var btn = document.getElementById('submitBtn');
  btn.disabled = true;
  btn.textContent = 'Wird gesendet...';

  // UTM params
  var params = new URLSearchParams(window.location.search);
  var payload = {
    name:     _gd.vorname + ' ' + _gd.nachname,
    vorname:  _gd.vorname,
    nachname: _gd.nachname,
    phone:    _gd.phone,
    email:    _gd.email,
    seite:    'galabau-garantie',
    utm_source:   params.get('utm_source')   || '',
    utm_medium:   params.get('utm_medium')   || '',
    utm_campaign: params.get('utm_campaign') || '',
    utm_content:  params.get('utm_content')  || '',
    created_at: new Date().toISOString()
  };

  fetch('https://fastraone-admin.vercel.app/api/leads', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload)
  })
  .then(function(r) { return r.ok ? r : Promise.reject(r.status); })
  .then(function() {
    // DataLayer push (GTM)
    if (window.dataLayer) window.dataLayer.push({
      event: 'lead_submit',
      lead_seite: 'galabau-garantie'
    });
    showThankyou();
  })
  .catch(function() {
    // Show success anyway (don't block user on network error)
    showThankyou();
  });
}

function showThankyou() {
  for (var i = 0; i < 4; i++) {
    var s = document.getElementById('step-' + i);
    if (s) s.className = 'g-step';
  }
  var progress = document.getElementById('gProgress');
  if (progress) progress.style.display = 'none';
  var ty = document.getElementById('gThankyou');
  if (ty) ty.className = 'g-thankyou visible';
  // Mark all dots done
  for (var j = 0; j < 4; j++) {
    var d = document.getElementById('dot-' + j);
    if (d) d.className = 'g-progress-dot done';
  }
}

// Enter key support
document.addEventListener('keydown', function(e) {
  if (e.key !== 'Enter') return;
  var actions = [
    function(){ nextStep(0); },
    function(){ nextStep(1); },
    function(){ nextStep(2); },
    function(){ submitForm(); }
  ];
  if (actions[_step]) actions[_step]();
});

</script>

</BaseLayout>
