<script is:inline>

/* ─── Form State ─── */
var _fd = { vorname:'', nachname:'', phone:'', email:'', newsletter: false };
var _fstep = 0;

function scrollToForm() {
  document.getElementById('heroForm').scrollIntoView({ behavior:'smooth', block:'center' });
  setTimeout(function(){ document.getElementById('f-vorname').focus(); }, 500);
}

function fUpdateProgress(step) {
  for (var i = 0; i < 4; i++) {
    var d = document.getElementById('fdot-' + i);
    d.className = 'form-progress-dot';
    if (i < step)  d.classList.add('done');
    if (i === step) d.classList.add('active');
  }
}

function fShowStep(n) {
  for (var i = 0; i < 4; i++) {
    var s = document.getElementById('fstep-' + i);
    if (s) s.className = 'f-step' + (i === n ? ' visible' : '');
  }
  fUpdateProgress(n);
  _fstep = n;
  var ids = ['f-vorname','f-nachname','f-phone','f-email'];
  var inp = document.getElementById(ids[n]);
  if (inp) setTimeout(function(){ inp.focus(); }, 80);
}

function fNext(current) {
  var ids  = ['f-vorname','f-nachname','f-phone','f-email'];
  var keys = ['vorname','nachname','phone','email'];
  var val  = document.getElementById(ids[current]).value.trim();
  var errEl = document.getElementById('ferr-' + current);
  var ok = false;
  if (current === 0) ok = val.length >= 2;
  if (current === 1) ok = val.length >= 2;
  if (current === 2) ok = val.replace(/\s/g,'').length >= 6;
  if (current === 3) ok = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val);
  if (!ok) {
    errEl.className = 'f-err show';
    document.getElementById(ids[current]).classList.add('error');
    return;
  }
  errEl.className = 'f-err';
  document.getElementById(ids[current]).classList.remove('error');
  _fd[keys[current]] = val;
  fShowStep(current + 1);
}

function fSubmit() {
  var email = document.getElementById('f-email').value.trim();
  var errEl = document.getElementById('ferr-3');
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
    errEl.className = 'f-err show';
    document.getElementById('f-email').classList.add('error');
    return;
  }
  _fd.email = email;
  _fd.newsletter = document.getElementById('f-newsletter').checked;

  var btn = document.getElementById('fSubmitBtn');
  btn.disabled = true;
  btn.textContent = 'Wird gesendet…';

  var params = new URLSearchParams(window.location.search);
  var payload = {
    name: _fd.vorname + ' ' + _fd.nachname,
    vorname:   _fd.vorname,
    nachname:  _fd.nachname,
    phone:     _fd.phone,
    email:     _fd.email,
    newsletter: _fd.newsletter,
    seite:     'galabau-garantie',
    utm_source:    params.get('utm_source')   || '',
    utm_medium:    params.get('utm_medium')   || '',
    utm_campaign:  params.get('utm_campaign') || '',
    utm_content:   params.get('utm_content')  || '',
    created_at: new Date().toISOString()
  };

  fetch('https://fastraone-admin.vercel.app/api/leads', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload)
  })
  .then(function(r) { return r.ok ? r : Promise.reject(r.status); })
  .then(function() {
    if (window.dataLayer) window.dataLayer.push({ event:'lead_submit', lead_seite:'galabau-garantie' });
    fShowThankyou();
  })
  .catch(function() { fShowThankyou(); });
}

function fShowThankyou() {
  document.getElementById('fFormArea').style.display = 'none';
  document.getElementById('fThankyou').className = 'f-thankyou visible';
}

/* Enter-Taste */
document.addEventListener('keydown', function(e) {
  if (e.key !== 'Enter') return;
  var actions = [
    function(){ fNext(0); },
    function(){ fNext(1); },
    function(){ fNext(2); },
    function(){ fSubmit(); }
  ];
  if (actions[_fstep]) actions[_fstep]();
});

/* ─── Scroll Reveal ─── */
(function(){
  var els = document.querySelectorAll('.reveal');
  if (!('IntersectionObserver' in window)) {
    els.forEach(function(e){ e.classList.add('is-visible'); });
    return;
  }
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if (entry.isIntersecting){
        entry.target.classList.add('is-visible');
        io.unobserve(entry.target);
      }
    });
  }, { threshold: 0.12 });
  els.forEach(function(e){ io.observe(e); });
})();

</script>

</BaseLayout>
