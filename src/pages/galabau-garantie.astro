<script is:inline>

var _fd = { bt:'', vn:'', nn:'', ph:'', em:'', nl:false };
var _step = 0;

function scrollToForm() {
  document.getElementById('heroForm').scrollIntoView({ behavior:'smooth', block:'center' });
  setTimeout(function(){ var el = document.getElementById('f-bt'); if(el) el.focus(); }, 450);
}

function fUpdateProg(s) {
  for (var i=0; i<5; i++) {
    var d = document.getElementById('fdot-'+i);
    d.className = 'fp-dot' + (i < s ? ' done' : i === s ? ' active' : '');
  }
}

function fShowStep(n) {
  for (var i=0; i<5; i++) {
    var s = document.getElementById('fstep-'+i);
    if (s) s.className = 'f-step' + (i===n ? ' visible' : '');
  }
  fUpdateProg(n); _step = n;
  var ids = ['f-bt','f-vn','f-nn','f-ph','f-em'];
  var inp = document.getElementById(ids[n]);
  if (inp) setTimeout(function(){ inp.focus(); }, 60);
}

function fNext(cur) {
  var ids  = ['f-bt','f-vn','f-nn','f-ph','f-em'];
  var keys = ['bt','vn','nn','ph','em'];
  var val  = document.getElementById(ids[cur]).value.trim();
  var errEl = document.getElementById('ferr-'+cur);
  var ok = cur===0 ? val.length>=2
         : cur===1 ? val.length>=2
         : cur===2 ? val.length>=2
         : cur===3 ? val.replace(/\s/g,'').length>=6
         : /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val);
  if (!ok) {
    errEl.className = 'f-err show';
    document.getElementById(ids[cur]).classList.add('err');
    return;
  }
  errEl.className = 'f-err';
  document.getElementById(ids[cur]).classList.remove('err');
  _fd[keys[cur]] = val;
  fShowStep(cur + 1);
  if (typeof gtag === 'function') {
    gtag('event', 'form_step_complete', { step: cur + 1, form_id: 'galabau-garantie' });
  }
}

function fSubmit() {
  var em = document.getElementById('f-em').value.trim();
  var errEl = document.getElementById('ferr-4');
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(em)) {
    errEl.className = 'f-err show';
    document.getElementById('f-em').classList.add('err');
    return;
  }
  _fd.em = em;
  _fd.nl = document.getElementById('f-nl').checked;
  var btn = document.getElementById('fSubmitBtn');
  btn.disabled = true; btn.innerHTML = '<span class="f-spinner"></span>Wird gesendet…';
  var p = new URLSearchParams(window.location.search);
  var payload = {
    betrieb: _fd.bt,
    name: _fd.vn + ' ' + _fd.nn,
    telefon: _fd.ph, email: _fd.em,
    seite: 'galabau-garantie',
    utm_source:   p.get('utm_source')   || '',
    utm_medium:   p.get('utm_medium')   || '',
    utm_campaign: p.get('utm_campaign') || '',
    utm_content:  p.get('utm_content')  || '',
    created_at: new Date().toISOString()
  };
  fetch('https://fastraone-admin.vercel.app/api/leads', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify(payload)
  })
  .then(function(r){ return r.ok ? r : Promise.reject(r.status); })
  .then(function(){
    if (window.dataLayer) window.dataLayer.push({event:'lead_submit', lead_seite:'galabau-garantie'});
    if (typeof gtag === 'function') {
      // GA4 lead event (immer aktiv)
      gtag('event', 'generate_lead', {
        event_category: 'lead_form',
        event_label: 'galabau-garantie',
        currency: 'EUR',
        value: 600.0
      });

      // Google Ads Conversion — immer feuern
      gtag('event', 'conversion', {
        send_to: 'AW-18219193505/yOKvCMvs99ocEKGpy-9D',
        value: 600.0,
        currency: 'EUR'
      });

      // Enhanced Conversions: E-Mail SHA-256 (optional, verbessert Matching)
      if (window.crypto && window.crypto.subtle) {
        var emailNorm = _fd.em.trim().toLowerCase();
        var buf = new TextEncoder().encode(emailNorm);
        crypto.subtle.digest('SHA-256', buf).then(function(hash) {
          var hex = Array.from(new Uint8Array(hash)).map(function(b){ return b.toString(16).padStart(2,'0'); }).join('');
          gtag('set', 'user_data', { 'sha256_email_address': hex });
        });
      }
    }
    fShowTY();
  })
  .catch(function(){ fShowTY(); });
}

function fShowTY() {
  document.getElementById('fFormArea').style.display = 'none';
  document.getElementById('fThankyou').className = 'f-ty visible';
}

document.addEventListener('keydown', function(e){
  if (e.key !== 'Enter') return;
  var a = [function(){fNext(0);},function(){fNext(1);},function(){fNext(2);},function(){fNext(3);},function(){fSubmit();}];
  if (a[_step]) a[_step]();
});

/* Scroll Reveal */
(function(){
  var els = document.querySelectorAll('.reveal');
  if (!('IntersectionObserver' in window)) {
    els.forEach(function(e){ e.classList.add('is-visible'); }); return;
  }
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if (entry.isIntersecting){
        entry.target.classList.add('is-visible');
        io.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });
  els.forEach(function(e){ io.observe(e); });
})();

/* GA4 Event Tracking */
(function(){
  /* CTA-Button Klicks */
  document.querySelectorAll('.btn, .urg-btn, .f-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      if (typeof gtag !== 'function') return;
      gtag('event', 'cta_click', {
        event_category: 'engagement',
        event_label: (btn.textContent || '').trim().replace(/\s+/g,' ').substring(0,60),
        page_location: window.location.href
      });
    });
  });

  /* Scroll-Tiefe: 25 / 50 / 75 / 90% */
  var depths = [25, 50, 75, 90]; var fired = {};
  window.addEventListener('scroll', function(){
    var pct = Math.round((window.scrollY + window.innerHeight) / document.documentElement.scrollHeight * 100);
    depths.forEach(function(d){
      if (!fired[d] && pct >= d) {
        fired[d] = true;
        if (typeof gtag === 'function') gtag('event', 'scroll_depth', { percent: d });
      }
    });
  }, { passive: true });
})();

/* Countdown Timer für Urgency Bar */
(function(){
  var el = document.getElementById('urg-countdown');
  if (!el) return;
  var KEY = 'fa_urg_end';
  var stored = sessionStorage.getItem(KEY);
  var end;
  if (stored) {
    end = parseInt(stored, 10);
  } else {
    end = Date.now() + (9 * 60 + 58) * 1000;
    sessionStorage.setItem(KEY, end);
  }
  function tick() {
    var rem = Math.max(0, Math.round((end - Date.now()) / 1000));
    var m = Math.floor(rem / 60);
    var s = rem % 60;
    el.textContent = m + ':' + (s < 10 ? '0' : '') + s;
    if (rem > 0) setTimeout(tick, 1000);
    else el.closest('.urg') && (el.closest('.urg').style.display = 'none');
  }
  tick();
})();

</script>


