---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="3 GaLaBau-Aufträge in 30 Tagen — Garantiert | Fastra One"
  description="Wir garantieren dir 3 qualifizierte Auftragsanfragen in 30 Tagen — oder du zahlst nichts. Exklusiv für GaLaBau-Betriebe in deiner Region."
  canonical="https://fastraone.de/galabau-garantie"
  ogImage="https://fastraone.de/assets/hero-galabau.jpg"
  navVariant="none"
  footerVariant="none"
>

<Fragment slot="head">
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@1,9..144,500&display=swap" rel="stylesheet" />
  <style is:global>

/* ═══════════════════════════════════
   TOKENS
═══════════════════════════════════ */
:root {
  --accent:       #22c55e;
  --accent-deep:  #15803d;
  --accent-soft:  rgba(34,197,94,.09);
  --accent-line:  rgba(34,197,94,.22);
  --ink:          #0d1117;
  --ink-2:        #374151;
  --bg:           #ffffff;
  --bg-alt:       #f8fdf9;
  --line:         rgba(0,0,0,.06);
  --card-line:    #e5e7eb;
  --red:          #ef4444;
  --red-soft:     rgba(239,68,68,.07);
  --red-line:     rgba(239,68,68,.22);
  --f-serif:      'Fraunces', Georgia, serif;
  --f-sans:       'Inter', -apple-system, sans-serif;
  --r-pill:       100px;
  --r-card:       18px;
  --r-sm:         10px;
  --shadow-sm:    0 1px 2px rgba(0,0,0,.05), 0 4px 12px rgba(0,0,0,.06);
  --shadow-md:    0 2px 4px rgba(0,0,0,.04), 0 12px 32px rgba(0,0,0,.08);
  --shadow-lg:    0 4px 8px rgba(0,0,0,.04), 0 24px 64px rgba(0,0,0,.10);
  --shadow-xl:    0 8px 16px rgba(0,0,0,.04), 0 40px 80px -12px rgba(0,0,0,.16);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html  {
  scroll-behavior: smooth;
  scrollbar-width: none;
  -ms-overflow-style: none;
}
html::-webkit-scrollbar { display: none; }
body  {
  font-family: var(--f-sans); color: var(--ink);
  -webkit-font-smoothing: antialiased; overflow-x: hidden;
  font-feature-settings: 'rlig' 1, 'calt' 1;
  background: var(--bg-alt);
}
a     { color: inherit; text-decoration: none; }
img   { max-width: 100%; display: block; }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
.wrap { max-width: 1100px; margin: 0 auto; padding: 0 28px; }

/* ═══════════════════════════════════
   REVEAL ANIMATIONS
═══════════════════════════════════ */
.reveal { opacity: 0; transform: translateY(20px); transition: opacity .65s ease, transform .65s ease; }
.reveal.is-visible { opacity: 1; transform: none; }
.reveal.d1 { transition-delay: .1s; }
.reveal.d2 { transition-delay: .2s; }
.reveal.d3 { transition-delay: .3s; }
@media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; transition: none; } }

/* ═══════════════════════════════════
   ANNOUNCEMENT BAR
═══════════════════════════════════ */
.announce-bar {
  background: #0b1812;
  color: #fff;
  text-align: center;
  padding: 11px 20px;
  font-size: 0.95rem;
  font-weight: 500;
  letter-spacing: -0.01em;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  position: relative;
  z-index: 6;
  border-bottom: 1px solid rgba(43,207,120,.2);
}
.announce-bar strong {
  color: #2bcf78;
  font-weight: 700;
}
.announce-emoji { font-size: 1.1rem; }

/* ═══════════════════════════════════
   URGENCY BAR
═══════════════════════════════════ */
.urg {
  background: #dc2626;
  color: #fff;
  display: flex; align-items: center; justify-content: center;
  gap: 10px; padding: 9px 20px;
  font-size: .82rem; font-weight: 600;
  position: relative; z-index: 10;
  flex-wrap: wrap;
}
.urg-dot {
  width: 8px; height: 8px; border-radius: 50%;
  background: #fff; flex-shrink: 0;
  animation: pulseOrange 2s ease-out infinite;
}
@keyframes pulseOrange {
  0%   { box-shadow: 0 0 0 0 rgba(255,255,255,.7); }
  70%  { box-shadow: 0 0 0 7px rgba(255,255,255,0); }
  100% { box-shadow: 0 0 0 0 rgba(255,255,255,0); }
}
.urg strong { color: #fff; font-weight: 800; }
.urg-sep { color: rgba(255,255,255,.4); }
.urg-btn {
  background: rgba(255,255,255,.18); border: 1px solid rgba(255,255,255,.45);
  color: #fff; font-size: .77rem; font-weight: 700;
  padding: 4px 13px; border-radius: 999px; cursor: pointer;
  letter-spacing: .01em; transition: background .18s;
}
.urg-btn:hover { background: rgba(255,255,255,.28); }

/* ═══════════════════════════════════
   NAV — Pill (Faris-Schmidt-Referenz)
═══════════════════════════════════ */
.nav-outer {
  position: sticky; top: 0; z-index: 100;
  display: flex; justify-content: center;
  padding: 12px 16px;
}
nav.pill {
  width: 100%; max-width: 1060px;
  display: flex; align-items: center; justify-content: space-between;
  background: rgba(255,255,255,.9);
  border: 1px solid rgba(0,0,0,.06);
  border-radius: var(--r-pill);
  padding: 10px 10px 10px 22px;
  box-shadow: 0 1px 3px rgba(0,0,0,.04), 0 8px 24px rgba(0,0,0,.05);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}
.nav-brand {
  display: flex; align-items: center; gap: 8px;
  font-weight: 800; font-size: .98rem; letter-spacing: -.02em;
}
.nav-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--accent); }
nav.pill ul { display: flex; gap: 26px; list-style: none; }
nav.pill ul a { font-size: .86rem; font-weight: 500; color: var(--ink-2); transition: color .2s; }
nav.pill ul a:hover { color: var(--ink); }
@media (max-width: 700px) { nav.pill ul { display: none; } }

/* ═══════════════════════════════════
   BUTTONS
═══════════════════════════════════ */
.btn {
  display: inline-flex; align-items: center; gap: 8px;
  border-radius: var(--r-pill); border: none; cursor: pointer;
  font-family: var(--f-sans); font-weight: 400; font-size: .92rem;
  letter-spacing: -.02em; white-space: nowrap;
  padding: 11px 11px 11px 20px;
  box-shadow: rgba(255,255,255,.12) 0 0 0 3px inset;
  transition: transform .3s cubic-bezier(.34,1.56,.64,1), box-shadow .3s;
}
.btn:hover { transform: translateY(-2px); }
.btn-primary { background: var(--accent); color: #fff; }
.btn-primary:hover { box-shadow: rgba(255,255,255,.12) 0 0 0 3px inset, rgba(34,197,94,.30) 0 8px 28px; }
.btn-dark { background: var(--ink); color: #fff; }
.btn-dark:hover { box-shadow: rgba(255,255,255,.12) 0 0 0 3px inset, rgba(0,0,0,.22) 0 8px 28px; }
.btn-outline {
  background: var(--bg); color: var(--ink);
  border: 1px solid var(--card-line); box-shadow: none;
  padding: 11px 20px;
}
.btn-outline:hover { box-shadow: var(--shadow-sm); }
.btn-sm { font-size: .8rem; padding: 8px 8px 8px 14px; }
.btn-arrow {
  width: 26px; height: 26px; border-radius: 50%; background: #fff;
  display: inline-flex; align-items: center; justify-content: center; flex: none;
}
.btn-primary .btn-arrow { color: var(--accent); }
.btn-dark    .btn-arrow { color: var(--ink); }
.btn-sm .btn-arrow { width: 22px; height: 22px; }

/* ═══════════════════════════════════
   PULSE DOT
═══════════════════════════════════ */
.pulse-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); position: relative; flex: none; }
.pulse-dot::after {
  content: ''; position: absolute; inset: -5px;
  border-radius: 50%; border: 2px solid var(--accent);
  animation: pulse-ring 2s ease infinite;
}
@keyframes pulse-ring { 0%{transform:scale(.5);opacity:.8} 100%{transform:scale(1.9);opacity:0} }
@media (prefers-reduced-motion: reduce) { .pulse-dot::after { animation: none; display: none; } }

/* ═══════════════════════════════════
   HERO — Apple-Stil
═══════════════════════════════════ */
.hero {
  padding: 72px 0 64px;
  text-align: center;
  position: relative;
  overflow: hidden;
  background: transparent;
}
/* ─── Hero-Zone: Bild hinter Urg + Nav + Hero ─── */
.hero-zone {
  position: relative;
  padding-bottom: 0;
  min-height: 100svh;
  display: flex;
  flex-direction: column;
}
.hero-bg-photo {
  position: absolute; inset: 0; z-index: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: center 35%;
  opacity: .42;
  filter: saturate(1.2) brightness(1.05);
  pointer-events: none;
}
/* Gradient — Photo oben scharf, unten weich ausgeblendet */
.hero-zone::before {
  content: '';
  position: absolute; inset: 0; z-index: 1;
  background: linear-gradient(to bottom,
    rgba(248,253,249,0)    0%,
    rgba(248,253,249,.08) 40%,
    rgba(248,253,249,.55) 68%,
    rgba(248,253,249,.90) 82%,
    rgba(248,253,249,1)   92%,
    rgba(248,253,249,1)   100%
  );
  pointer-events: none;
}
/* Kein extra ::after mehr nötig — ::before deckt bereits vollständig ab */
.hero-zone::after { display: none; }
.hero::before { display: none; }
/* Dezentes Dot-Grid (wie Referenz-Template) */
.hero::after {
  content: '';
  position: absolute; inset: 0;
  background-image: radial-gradient(circle, rgba(34,197,94,.12) 1px, transparent 1.2px);
  background-size: 28px 28px;
  -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 30%, #000 0%, transparent 100%);
  mask-image: radial-gradient(ellipse 80% 60% at 50% 30%, #000 0%, transparent 100%);
  pointer-events: none;
  opacity: .45;
}
.hero .wrap { position: relative; z-index: 2; max-width: 780px; }

.hero-badge {
  display: inline-flex; align-items: center; gap: 8px;
  background: var(--accent-soft); border: 1px solid var(--accent-line);
  border-radius: var(--r-pill);
  padding: 7px 16px 7px 10px;
  font-size: .79rem; font-weight: 600; color: var(--accent-deep);
  margin-bottom: 28px;
}

/* Headline — Apple-Format: groß, eng, präzise */
.hero h1 {
  font-family: var(--f-sans); font-weight: 800;
  font-size: clamp(2.8rem, 7vw, 5rem);
  line-height: 1.04; letter-spacing: -.04em;
  margin: 0 auto 18px;
  max-width: 14ch;
}
.hero h1 em {
  font-family: var(--f-serif); font-style: italic;
  font-weight: 500; color: var(--accent);
  letter-spacing: -.02em;
}
.hero-sub {
  font-size: clamp(1rem, 2vw, 1.15rem);
  color: var(--ink-2); line-height: 1.65;
  max-width: 46ch; margin: 0 auto 22px;
}

/* Garantie-Pill */
.g-pill {
  display: inline-flex; align-items: center; gap: 8px;
  background: #dc2626; border: none;
  color: #fff; font-size: .88rem; font-weight: 800;
  padding: 9px 20px; border-radius: 8px; margin-bottom: 24px;
  letter-spacing: .01em; box-shadow: 0 2px 12px rgba(220,38,38,.35);
}

/* Google-Bewertungen */
.google-row {
  display: flex; align-items: center; justify-content: center; gap: 10px;
  margin-bottom: 32px;
}
.stars { color: #f59e0b; letter-spacing: 2px; font-size: .92rem; }
.google-text { font-size: .77rem; color: var(--ink-2); }
.google-text strong { color: var(--ink); }

/* ═══════════════════════════════════
   FORM CARD — Glassmorphism
═══════════════════════════════════ */
.form-card {
  background: rgba(255,255,255,.88);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border: 1px solid rgba(255,255,255,.75);
  border-radius: 22px;
  box-shadow:
    0 2px 4px rgba(0,0,0,.03),
    0 12px 36px rgba(0,0,0,.07),
    0 40px 80px rgba(0,0,0,.06),
    inset 0 1px 0 rgba(255,255,255,.9);
  padding: 36px 32px;
  max-width: 460px;
  margin: 0 auto;
  text-align: left;
}
.fp {
  display: flex; gap: 5px; margin-bottom: 28px;
}
.fp-dot {
  flex: 1; height: 3px; border-radius: 3px;
  background: var(--card-line); transition: background .35s;
}
.fp-dot.active { background: var(--accent); }
.fp-dot.done   { background: rgba(34,197,94,.4); }

.f-step { display: none; }
.f-step.visible { display: block; }
.f-q { font-size: 1.15rem; font-weight: 700; letter-spacing: -.02em; margin-bottom: 14px; line-height: 1.3; }
.f-input {
  width: 100%; background: rgba(248,250,252,.8);
  border: 1.5px solid var(--card-line);
  border-radius: 12px; color: var(--ink);
  font-family: var(--f-sans); font-size: 1.05rem;
  padding: 14px 16px; outline: none;
  transition: border-color .2s, box-shadow .2s, background .2s;
}
.f-input::placeholder { color: #c4cad3; }
.f-input:focus {
  border-color: var(--accent); background: var(--bg);
  box-shadow: 0 0 0 3px rgba(34,197,94,.12);
}
.f-input.err { border-color: var(--red); }
.f-hint { font-size: .73rem; color: #9ca3af; margin-top: 6px; }
.f-err { font-size: .74rem; color: var(--red); margin-top: 5px; display: none; }
.f-err.show { display: block; }
.f-btn {
  display: block; width: 100%; margin-top: 14px;
  background: var(--ink); color: #fff;
  font-family: var(--f-sans); font-weight: 600; font-size: 1rem;
  padding: 15px; border-radius: 12px; border: none; cursor: pointer;
  letter-spacing: -.01em;
  box-shadow: rgba(255,255,255,.10) 0 0 0 3px inset;
  transition: background .2s, transform .3s cubic-bezier(.34,1.56,.64,1), box-shadow .3s;
}
.f-btn:hover { background: #1a1a2e; transform: translateY(-2px); box-shadow: rgba(255,255,255,.10) 0 0 0 3px inset, rgba(0,0,0,.2) 0 8px 24px; }
.f-btn.green { background: var(--accent); }
.f-spinner {
  display: inline-block; width: 14px; height: 14px;
  border: 2px solid rgba(255,255,255,.3); border-top-color: #fff;
  border-radius: 50%; animation: spin .7s linear infinite;
  margin-right: 8px; vertical-align: middle;
}
@keyframes spin { to { transform: rotate(360deg); } }
.f-btn.green:hover { background: var(--accent-deep); box-shadow: rgba(255,255,255,.12) 0 0 0 3px inset, rgba(34,197,94,.28) 0 8px 24px; }
.f-btn:disabled { opacity: .5; cursor: not-allowed; transform: none; box-shadow: none; }

.f-news {
  display: flex; gap: 10px; align-items: flex-start; margin-top: 14px;
  background: rgba(34,197,94,.07); border: 1px solid var(--accent-line);
  border-radius: 10px; padding: 10px 12px;
}
.f-news input[type="checkbox"] { width: 16px; height: 16px; margin-top: 2px; flex-shrink: 0; accent-color: var(--accent); cursor: pointer; }
.f-news label { font-size: .74rem; color: var(--ink-2); line-height: 1.55; cursor: pointer; }
.f-news label strong { color: var(--ink); font-weight: 700; }
.f-news label a { color: var(--accent-deep); text-decoration: underline; }

/* Thank You */
.f-ty { display: none; text-align: center; padding: 8px 0; }
.f-ty.visible { display: block; }
.f-ty-icon { color: var(--accent); width: 48px; height: 48px; margin: 0 auto 14px; }
.f-ty-h { font-size: 1.25rem; font-weight: 800; letter-spacing: -.02em; margin-bottom: 8px; }
.f-ty-p { font-size: .9rem; color: var(--ink-2); line-height: 1.6; max-width: 300px; margin: 0 auto; }
.f-ty-p strong { color: var(--accent-deep); }
.f-ty-hr { border: none; border-top: 1px solid var(--card-line); margin: 22px 0; }
.f-ty-steps { display: flex; flex-direction: column; gap: 8px; margin: 16px 0; text-align: left; }
.f-ty-step {
  display: flex; align-items: flex-start; gap: 12px;
  font-size: .82rem; color: var(--ink-2); line-height: 1.5;
  background: var(--bg-alt); border: 1px solid var(--accent-line);
  border-radius: 10px; padding: 10px 14px;
}
.f-ty-step span {
  flex-shrink: 0; width: 22px; height: 22px; border-radius: 50%;
  background: var(--accent); color: #fff; font-size: .7rem; font-weight: 800;
  display: flex; align-items: center; justify-content: center;
  margin-top: 1px;
}
.f-ty-profile {
  display: flex; align-items: center; gap: 13px;
  background: var(--bg-alt); border: 1px solid var(--card-line);
  border-radius: 14px; padding: 14px 16px; text-align: left; margin-bottom: 20px;
}
.f-ty-ava {
  width: 50px; height: 50px; border-radius: 50%; flex-shrink: 0;
  background: var(--accent-soft);
  display: flex; align-items: center; justify-content: center; overflow: hidden;
}
.f-ty-ava svg { color: var(--accent-deep); }
.f-ty-ava img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
.f-ty-name { font-size: .86rem; font-weight: 700; }
.f-ty-role { font-size: .73rem; color: var(--ink-2); margin-bottom: 3px; }
.f-ty-q    { font-size: .78rem; color: var(--ink); line-height: 1.5; font-style: italic; }
.f-ty-cal-l { font-size: .78rem; color: var(--ink-2); text-align: center; margin-bottom: 10px; }
.f-ty-cal-l strong { display: block; font-size: .9rem; color: var(--ink); margin-top: 1px; }

/* ═══════════════════════════════════
   TRUST PILLS (below form)
═══════════════════════════════════ */
.trust-row {
  display: flex; justify-content: center; gap: 20px; flex-wrap: wrap;
  margin-top: 16px;
}
.trust-pill {
  display: inline-flex; align-items: center; gap: 5px;
  font-size: .74rem; color: var(--ink-2);
}
.trust-pill svg { color: var(--accent); }

/* ═══════════════════════════════════
   MOCKUP SECTION — Referenz exakt
═══════════════════════════════════ */
.mockup-section {
  padding: 16px 0 96px;
  position: relative;
  background-color: var(--bg-alt);
}
/* Grid auf Pseudo-Element → Kinder bleiben sichtbar, nur Grid blendet ein */
.mockup-section::before {
  content: '';
  position: absolute; inset: 0;
  background-image:
    linear-gradient(rgba(34,197,94,.07) 1px, transparent 1px),
    linear-gradient(90deg, rgba(34,197,94,.07) 1px, transparent 1px);
  background-size: 28px 28px;
  -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 160px);
  mask-image: linear-gradient(to bottom, transparent 0%, black 160px);
  pointer-events: none;
  z-index: 0;
}
.mockup-wrap {
  position: relative;
  z-index: 1;
  max-width: 900px; margin: 0 auto; padding: 0 28px;
}
.mockup-outer {
  background: linear-gradient(160deg, #eef4f1, #fafdf9);
  background-image: radial-gradient(circle, rgba(34,197,94,.13) 1px, transparent 1.4px);
  background-size: 22px 22px;
  border: 1px solid rgba(0,0,0,.06);
  border-radius: 26px;
  padding: 24px;
  box-shadow: var(--shadow-xl);
}
.mockup-inner {
  background: var(--bg);
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 24px 28px;
  text-align: left;
}
.m-dots { display: flex; gap: 6px; margin-bottom: 20px; }
.m-dots span { width: 10px; height: 10px; border-radius: 50%; background: var(--card-line); }

/* Kalender-Inhalt */
.m-header {
  display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;
}
.m-live {
  display: flex; align-items: center; gap: 7px;
  font-size: .72rem; font-weight: 700; text-transform: uppercase;
  letter-spacing: .05em; color: var(--accent-deep);
}
.m-service { font-size: .84rem; font-weight: 700; }
.m-service small { display: block; font-size: .7rem; font-weight: 400; color: var(--ink-2); }
.m-avtr {
  width: 32px; height: 32px; border-radius: 50%;
  background: linear-gradient(135deg, var(--accent), var(--accent-deep));
  color: #fff; font-size: .72rem; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.m-split { display: grid; grid-template-columns: 1fr 1px 180px; }
@media (max-width: 680px) { .m-split { grid-template-columns: 1fr; } }
.m-div { background: var(--line); margin: 0 22px; }
@media (max-width: 680px) { .m-div { display: none; } }
.m-cal { padding-right: 0; }
@media (max-width: 680px) { .m-cal { margin-bottom: 18px; } }
.m-month-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
.m-month { font-size: .85rem; font-weight: 700; }
.m-navs { display: flex; gap: 4px; }
.m-nav {
  width: 24px; height: 24px; border: 1px solid var(--card-line);
  border-radius: 6px; background: none; cursor: pointer;
  color: var(--ink-2); font-size: .78rem;
  display: flex; align-items: center; justify-content: center;
  transition: background .15s;
}
.m-nav:hover { background: var(--accent-soft); }
.m-wdays { display: grid; grid-template-columns: repeat(7,1fr); text-align: center; margin-bottom: 4px; }
.m-wdays span { font-size: .62rem; font-weight: 600; color: #9ca3af; }
.m-days { display: grid; grid-template-columns: repeat(7,1fr); gap: 1px; text-align: center; }
.m-days span { padding: 5px 0; font-size: .74rem; border-radius: 6px; }
.m-days .av { color: var(--accent-deep); font-weight: 600; cursor: pointer; }
.m-days .av:hover { background: var(--accent-soft); }
.m-days .sel { background: var(--accent); color: #fff; font-weight: 700; }
.m-days .td { font-weight: 700; box-shadow: inset 0 0 0 1.5px var(--accent); border-radius: 6px; }
.m-days .dim { color: #d1d5db; }
.m-times-col {
  padding-left: 22px; display: flex; flex-direction: column; justify-content: center;
}
@media (max-width: 680px) { .m-times-col { padding-left: 0; border-top: 1px solid var(--line); padding-top: 14px; } }
.m-tlabel { font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: #9ca3af; margin-bottom: 10px; }
.m-slots { display: flex; flex-direction: column; gap: 6px; }
.m-slot {
  padding: 8px 14px; border-radius: 9px; border: 1px solid var(--card-line);
  font-size: .79rem; background: none; cursor: pointer;
  text-align: center; transition: all .15s;
}
.m-slot:hover { border-color: var(--accent); color: var(--accent-deep); }
.m-slot.sel { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 600; }
.m-confirm {
  display: block; width: 100%; margin-top: 10px;
  background: var(--ink); color: #fff;
  font-family: var(--f-sans); font-size: .84rem; font-weight: 600;
  padding: 10px; border-radius: 9px; border: none; cursor: pointer;
  box-shadow: rgba(255,255,255,.08) 0 0 0 2px inset;
  transition: background .2s, transform .2s;
}
.m-confirm:hover { background: #1a1a2e; transform: translateY(-1px); }

/* Float-Cards — Referenz-exakt: Spring-Pop + tiefer Schatten */
.float-card {
  position: absolute;
  background: var(--bg);
  border: 1px solid var(--line);
  border-radius: 18px;
  box-shadow: 0 20px 48px rgba(13,15,26,.13), 0 4px 12px rgba(0,0,0,.06);
  padding: 16px 20px;
  opacity: 0; transform: translateY(16px) scale(.92);
  transition: opacity .5s cubic-bezier(.34,1.56,.64,1), transform .5s cubic-bezier(.34,1.56,.64,1);
  white-space: nowrap;
}
.mockup-wrap.is-visible .float-card { opacity: 1; transform: none; }
/* Stat card: Fraunces-Zahl */
.float-card.stat { top: 3%; left: -2.5%; transition-delay: .15s; }
.fc-num {
  font-family: var(--f-serif); font-size: 1.65rem; font-weight: 500;
  font-style: italic; color: var(--accent); line-height: 1.1; display: block;
}
.fc-lbl { font-size: .73rem; color: var(--ink-2); margin-top: 2px; display: block; line-height: 1.4; }
/* Notif card — jetzt tiefer: bottom: -6% statt 5% */
.float-card.notif { bottom: -6%; right: -2.5%; display: flex; align-items: flex-start; gap: 12px; max-width: 290px; transition-delay: .35s; }
.fc-ic {
  width: 36px; height: 36px; border-radius: 10px;
  background: var(--accent-soft);
  display: flex; align-items: center; justify-content: center; flex: none;
}
.fc-ic svg { color: var(--accent-deep); }
.fc-notif-title { font-size: .84rem; font-weight: 700; color: var(--ink); margin-bottom: 2px; }
.fc-notif-body  { font-size: .73rem; color: var(--ink-2); }
.fc-notif-time  { font-size: .68rem; color: var(--accent-deep); font-weight: 600; margin-top: 4px; }

/* Mobile: stat-card verstecken, notif-card als statische Pill unter dem Kalender */
@media (max-width: 700px) {
  .float-card.stat { display: none; }
  .float-card.notif {
    position: relative;
    bottom: auto; right: auto;
    opacity: 1; transform: none;
    margin-top: 16px;
    max-width: 100%;
    border-radius: 14px;
    padding: 12px 16px;
    background: var(--bg);
    box-shadow: 0 2px 12px rgba(0,0,0,.07);
  }
}
@media (prefers-reduced-motion: reduce) { .float-card { opacity: 1; transform: none; transition: none; } }

/* ═══════════════════════════════════
   SECTION LAYOUT
═══════════════════════════════════ */
.section { padding: 90px 0; }
.section.alt { background: transparent; }
.section-head { text-align: center; max-width: 600px; margin: 0 auto 56px; }
.section-head h2 {
  font-weight: 800; font-size: clamp(1.75rem, 3.5vw, 2.5rem);
  letter-spacing: -.03em; line-height: 1.12; margin-bottom: 12px;
}
.section-head h2 em {
  font-family: var(--f-serif); font-style: italic;
  font-weight: 500; color: var(--accent);
}
.section-head p { color: var(--ink-2); font-size: 1rem; line-height: 1.65; }

/* ═══════════════════════════════════
   PAIN CARDS — Keine Icons, nur SVG-Illustration
═══════════════════════════════════ */
.cards3 { display: grid; grid-template-columns: repeat(3,1fr); gap: 22px; }
@media (max-width: 820px) { .cards3 { grid-template-columns: 1fr; } }

.card-m {
  background: var(--bg);
  border: 1px solid var(--card-line);
  border-radius: var(--r-card);
  overflow: hidden;
  transition: transform .3s, box-shadow .3s;
}
.card-m:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
.card-m .illus-bg {
  height: 168px;
  background: linear-gradient(180deg, #f8f9fa 0%, #f3f4f6 50%, #ffffff 100%);
  display: flex; align-items: center; justify-content: center;
  padding: 16px 24px;
  overflow: visible;
}
.card-m .c-body { padding: 22px 24px 26px; }
.card-m h3 {
  font-family: var(--f-serif); font-weight: 500; font-style: italic;
  font-size: 1.2rem; letter-spacing: -.01em; color: var(--ink); margin-bottom: 8px;
}
.card-m p { font-size: .9rem; line-height: 1.65; color: var(--ink-2); }

/* SVG-Illustrationen: gestaffeltes Einblenden */
.ill-el { opacity: 0; transform: translateY(5px); transform-box: fill-box; transform-origin: center; }
.card-m.reveal.is-visible .ill-el { animation: ill-in .6s cubic-bezier(.16,1,.3,1) forwards; }
.card-m.reveal.is-visible .ill-el.d1 { animation-delay: .1s; }
.card-m.reveal.is-visible .ill-el.d2 { animation-delay: .22s; }
.card-m.reveal.is-visible .ill-el.d3 { animation-delay: .34s; }
.card-m.reveal.is-visible .ill-el.d4 { animation-delay: .46s; }
.card-m.reveal.is-visible .ill-el.d5 { animation-delay: .58s; }
@keyframes ill-in { to { opacity: 1; transform: none; } }
.ill-breathe { transform-box: fill-box; transform-origin: center; }
.card-m.reveal.is-visible .ill-breathe {
  animation: ill-in .6s cubic-bezier(.16,1,.3,1) .3s forwards, ill-breathe 3.5s ease-in-out 1.2s infinite;
}
@keyframes ill-breathe { 0%,100%{ transform: scale(1) } 50%{ transform: scale(1.05) } }
@media (prefers-reduced-motion: reduce) {
  .ill-el, .ill-breathe { opacity: 1; transform: none; animation: none !important; }
}

/* ═══════════════════════════════════
   SOLUTION GRID
═══════════════════════════════════ */
.sol-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 16px; }
@media (max-width: 640px) { .sol-grid { grid-template-columns: 1fr; } }
.sol-item {
  display: flex; gap: 14px; align-items: flex-start;
  background: var(--bg); border: 1px solid var(--card-line);
  border-radius: 14px; padding: 18px 20px;
  transition: box-shadow .25s;
}
.sol-item:hover { box-shadow: var(--shadow-sm); }
.sol-check {
  width: 28px; height: 28px; border-radius: 50%; flex-shrink: 0; margin-top: 1px;
  background: var(--accent-soft);
  display: flex; align-items: center; justify-content: center;
}
.sol-check svg { color: var(--accent-deep); }
.sol-item strong { font-size: .92rem; font-weight: 700; display: block; margin-bottom: 2px; }
.sol-item span   { font-size: .8rem; color: var(--ink-2); line-height: 1.45; }

/* ═══════════════════════════════════
   GUARANTEE
═══════════════════════════════════ */
.g-wrap { max-width: 640px; margin: 0 auto; }
.g-card {
  background: var(--bg);
  border: 1.5px solid var(--accent-line);
  border-radius: 22px;
  padding: 52px 44px;
  text-align: center;
  position: relative; overflow: hidden;
  box-shadow: 0 4px 12px rgba(34,197,94,.06), 0 20px 60px rgba(34,197,94,.04);
}

.g-icon { color: var(--accent); margin: 0 auto 18px; width: 52px; height: 52px; }
.g-card h2 {
  font-weight: 800; font-size: clamp(1.5rem, 3vw, 2.1rem);
  letter-spacing: -.03em; line-height: 1.12; margin-bottom: 14px;
}
.g-card h2 em { font-family: var(--f-serif); font-style: italic; font-weight: 500; color: var(--accent); }
.g-card p { color: var(--ink-2); font-size: .97rem; line-height: 1.65; max-width: 44ch; margin: 0 auto 30px; }
.g-convince {
  font-family: var(--f-serif); font-style: italic; font-size: 1.05rem;
  color: var(--accent-deep); margin-bottom: 24px; margin-top: -8px;
}
.g-btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
.g-trust {
  margin-top: 28px; font-size: .76rem; color: rgba(13,17,23,.38);
  letter-spacing: .01em; line-height: 2;
}
@media (max-width: 480px) { .g-card { padding: 36px 24px; } }

/* ═══════════════════════════════════
   FOOTER — Light / Hell
═══════════════════════════════════ */
footer {
  background: var(--bg-alt);
  position: relative; overflow: hidden;
  color: var(--ink-2);
  border-top: 1px solid var(--accent-line);
}
footer::before { display: none; }
/* Haupt-Grid */
.foot-accent { display: none; }
.foot-top {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  gap: 60px;
  padding: 64px 0 52px;
}
@media (max-width: 760px) { .foot-top { grid-template-columns: 1fr; gap: 32px; } }

/* Brand-Spalte */
.foot-logo { height: 42px; filter: brightness(0) saturate(100%) invert(42%) sepia(79%) saturate(550%) hue-rotate(100deg) brightness(92%) contrast(90%); display: block; margin-bottom: 16px; }
.foot-tagline { font-size: .92rem; color: rgba(13,17,23,.48); line-height: 1.6; max-width: 36ch; margin-bottom: 10px; }
.foot-addr { font-size: .82rem; color: rgba(13,17,23,.4); line-height: 1.6; font-style: normal; margin-top: 10px; }
.foot-addr a { color: rgba(13,17,23,.4); }

/* Link-Spalten */
.foot-col h4 {
  font-size: .74rem; font-weight: 700; text-transform: uppercase;
  letter-spacing: .09em; color: var(--ink);
  margin-bottom: 16px;
}
.foot-col a {
  display: block; font-size: .92rem;
  color: rgba(13,17,23,.5); margin-bottom: 10px;
  transition: color .18s;
}
.foot-col a:hover { color: var(--accent); }

/* Bottom-Bar */
.foot-bottom {
  display: flex; justify-content: space-between; align-items: center;
  flex-wrap: wrap; gap: 12px 0;
  padding: 22px 0;
  border-top: 1px solid rgba(0,0,0,.07);
  font-size: .82rem; color: rgba(13,17,23,.35);
}
.foot-bottom a { color: rgba(13,17,23,.35); transition: color .18s; }
.foot-bottom a:hover { color: var(--ink); }
.foot-bottom nav { display: flex; gap: 20px; }

/* Wordmark — hell */
.foot-wordmark {
  text-align: center; overflow: hidden;
  background: var(--bg-alt); max-height: 180px;
}
.foot-wordmark span {
  font-family: var(--f-sans); font-size: clamp(5rem, 16vw, 15rem);
  font-weight: 900; letter-spacing: -.03em; text-transform: uppercase;
  color: rgba(34,197,94,.13); display: block; user-select: none; white-space: nowrap;
  -webkit-mask-image: linear-gradient(#000 0%, rgba(0,0,0,.6) 55%, transparent 85%);
  mask-image: linear-gradient(#000 0%, rgba(0,0,0,.6) 55%, transparent 85%);
}

/* ═══════════════════════════════════
   SYSTEM DARK — fastraone.de Stil
═══════════════════════════════════ */
.system-dark { background: #0b0f1a; text-align: center; overflow: hidden; }
.system-dark .hero-badge { background: rgba(34,197,94,.12); border-color: rgba(34,197,94,.25); color: #4ade80; }
.system-dark .hero-badge .pulse-dot { background: #4ade80; }
.system-dark .hero-badge .pulse-dot::after { border-color: #4ade80; }
.sys-4label {
  position: absolute; top: 28px; right: 32px;
  font-size: 4.5rem; font-weight: 900; line-height: 1;
  color: rgba(255,255,255,.04); letter-spacing: -.04em;
  pointer-events: none; user-select: none;
}
.sys-headline { margin: 28px 0 32px; }
.sys-headline h2 {
  font-size: clamp(2.8rem, 6.5vw, 4.4rem);
  letter-spacing: -.04em; line-height: 1.04; color: #fff;
  margin: 0;
}
.sys-headline > em {
  display: block; font-family: var(--f-serif); font-style: italic;
  font-weight: 400; color: #4ade80;
  font-size: clamp(1.4rem, 3.2vw, 2.1rem);
  margin-top: 12px; letter-spacing: -.02em;
}
.sys-body { max-width: 52ch; margin: 0 auto 36px; }
.sys-body p { color: rgba(255,255,255,.5); font-size: 1.08rem; line-height: 1.7; margin-bottom: 10px; }
.sys-body p:last-child { margin-bottom: 0; }
.sys-body strong { color: #4ade80; font-weight: 700; }
/* CTA Buttons */
.sys-cta { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
.btn-outline-dark { background: transparent; color: rgba(255,255,255,.65); border: 1px solid rgba(255,255,255,.15); box-shadow: none; padding: 11px 20px; }
.btn-outline-dark:hover { background: rgba(255,255,255,.06); color: #fff; }

/* ── Anfragen-Visual (light) ── */
.sys-visual {
  position: relative; height: 240px; max-width: 560px;
  margin: 0 auto 28px; overflow: visible;
}
.sys-visual::before { display: none; }
.sys-hub-glow {
  position: absolute; top: 50%; left: 50%;
  width: 140px; height: 140px; border-radius: 50%;
  background: radial-gradient(circle, rgba(34,197,94,.12) 0%, transparent 70%);
  transform: translate(-50%,-50%);
  animation: sys-pulse 4s ease-in-out infinite;
  pointer-events: none;
}
@keyframes sys-pulse {
  0%,100% { opacity: .9; transform: translate(-50%,-50%) scale(1); }
  50% { opacity: .5; transform: translate(-50%,-50%) scale(1.1); }
}
.sys-rings-svg {
  position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none;
}
.sys-hub-circle {
  position: absolute; top: 50%; left: 50%;
  width: 76px; height: 76px;
  transform: translate(-50%,-50%);
  border-radius: 50%; border: 1.5px solid rgba(34,197,94,.40);
  background: var(--ink);
  box-shadow: 0 0 28px rgba(34,197,94,.14), 0 4px 14px rgba(0,0,0,.22);
  display: flex; align-items: center; justify-content: center;
  z-index: 2;
}
.sys-hub-circle img { width: 44px; filter: brightness(0) invert(1); }
.sys-ncard {
  position: absolute;
  background: #fff;
  border: 1px solid rgba(0,0,0,.07);
  border-radius: 10px; padding: 7px 22px 7px 8px;
  display: flex; align-items: center; gap: 7px;
  box-shadow: 0 2px 8px rgba(0,0,0,.06), 0 1px 3px rgba(0,0,0,.04);
  width: 148px;
}
.sys-ncard-dot {
  position: absolute; top: 8px; right: 9px;
  width: 5px; height: 5px; border-radius: 50%; background: var(--accent);
  box-shadow: 0 0 4px rgba(34,197,94,.6);
}
.sys-ncard-avatar {
  width: 26px; height: 26px; border-radius: 6px; flex-shrink: 0;
  background: var(--accent-soft);
  display: flex; align-items: center; justify-content: center;
  color: var(--accent-deep);
}
.sys-ncard strong { display: block; font-size: .73rem; color: var(--ink); font-weight: 700; line-height: 1.2; }
.sys-ncard span { font-size: .64rem; color: var(--ink-2); display: block; margin-top: 1px; opacity: .7; }
/* Float-Animationen */
@keyframes floatUp   { 0%,100%{transform:translateY(0)}    50%{transform:translateY(-9px)} }
@keyframes floatDown { 0%,100%{transform:translateY(0)}    50%{transform:translateY(9px)} }
@keyframes floatN3   { 0%,100%{transform:translateY(-50%)} 50%{transform:translateY(calc(-50% - 9px))} }
@keyframes floatN4   { 0%,100%{transform:translateY(-50%)} 50%{transform:translateY(calc(-50% + 9px))} }
@keyframes pulseDot  {
  0%   { box-shadow: 0 0 0 0 rgba(34,197,94,.6); }
  70%  { box-shadow: 0 0 0 7px rgba(34,197,94,0); }
  100% { box-shadow: 0 0 0 0 rgba(34,197,94,0); }
}
/* Positionen + Animationen */
.sys-ncard-dot { animation: pulseDot 2s ease-out infinite; }
.sys-ncard.n1 { top: 7%;  left: 14%;  animation: floatUp   6s   ease-in-out       infinite; }
.sys-ncard.n2 { top: 7%;  right: 8%;  animation: floatDown 5.5s ease-in-out  .8s  infinite; }
.sys-ncard.n3 { top: 50%; left: 3%;   animation: floatN3   7s   ease-in-out  1.2s infinite; }
.sys-ncard.n4 { top: 50%; right: 3%;  animation: floatN4   6.5s ease-in-out  .4s  infinite; }
.sys-ncard.n5 { bottom: 9%; left: 15%; animation: floatUp  5.8s ease-in-out  1.6s infinite; }
.sys-ncard.n6 { bottom: 9%; right: 8%; animation: floatDown 6.2s ease-in-out .2s  infinite; }

@media (prefers-reduced-motion: reduce) {
  .sys-ncard, .sys-ring, .sys-hub-glow { animation: none !important; }
}
@media (max-width: 640px) {
  .sys-visual { height: 220px; }
  .sys-ncard.n5 { display: none; }
  .sys-ncard { width: 128px; }
  .sys-ncard strong { font-size: .68rem; }
  .sys-ncard span { font-size: .6rem; }
}

/* ═══════════════════════════════════
   LÖSUNG — Split Live-Feed
═══════════════════════════════════ */
.loesung-section { background: transparent; }
.lf-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
  max-width: 1040px;
  margin: 0 auto;
}
.lf-badge {
  display: inline-flex; align-items: center; gap: 7px;
  background: rgba(34,197,94,.1); border: 1px solid rgba(34,197,94,.25);
  border-radius: 999px; padding: 5px 14px; margin-bottom: 24px;
  font-size: .71rem; font-weight: 700; color: #15803d; letter-spacing: .05em; text-transform: uppercase;
}
.lf-badge-dot {
  width: 6px; height: 6px; border-radius: 50%; background: #22c55e; flex-shrink: 0;
}
.lf-headline {
  font-size: clamp(1.9rem, 3.4vw, 2.5rem);
  letter-spacing: -.04em; line-height: 1.1; margin-bottom: 22px; font-weight: 800; color: var(--ink);
}
.lf-headline em {
  font-family: Fraunces, Georgia, serif; font-style: italic; font-weight: 400; color: var(--accent);
}
.lf-p {
  color: #374151; font-size: .97rem; line-height: 1.72; margin-bottom: 16px;
}
.lf-p:last-of-type { margin-bottom: 36px; }
.lf-p strong { color: var(--ink); font-weight: 700; }

/* Panel — macOS-Stil, premium */
.lf-panel {
  background: #fff;
  border-radius: 14px; overflow: hidden;
  border: 1px solid rgba(0,0,0,.09);
  box-shadow:
    0 1px 2px rgba(0,0,0,.06),
    0 4px 12px rgba(0,0,0,.06),
    0 16px 40px rgba(0,0,0,.08),
    0 40px 80px rgba(0,0,0,.07);
}
.lf-panel-bar {
  padding: 11px 16px; border-bottom: 1px solid rgba(0,0,0,.07);
  display: flex; align-items: center; gap: 12px;
  background: linear-gradient(180deg, #f7f7f7 0%, #f0f0f0 100%);
}
/* Traffic Lights */
.lf-traffic { display: flex; align-items: center; gap: 7px; flex-shrink: 0; }
.lf-tl {
  display: block; width: 12px; height: 12px; border-radius: 50%;
  box-shadow: inset 0 -1px 1px rgba(0,0,0,.15), inset 0 1px 1px rgba(255,255,255,.5);
}
.lf-tl-red    { background: linear-gradient(135deg, #ff6961, #ff3b30); }
.lf-tl-yellow { background: linear-gradient(135deg, #ffdb6d, #ffcc00); }
.lf-tl-green  { background: linear-gradient(135deg, #5dde5a, #28c840); }
/* URL bar */
.lf-panel-url {
  flex: 1; background: rgba(0,0,0,.06); border-radius: 6px;
  padding: 4px 10px; font-size: .68rem; color: #6b7280; text-align: center;
  border: 1px solid rgba(0,0,0,.07);
}
.lf-panel-status {
  display: flex; align-items: center; gap: 6px; flex-shrink: 0;
  font-size: .63rem; font-weight: 700; color: #16a34a; letter-spacing: .07em; text-transform: uppercase;
}
.lf-live-dot {
  width: 7px; height: 7px; border-radius: 50%; background: #22c55e;
  box-shadow: 0 0 0 0 rgba(34,197,94,.4);
  animation: lf-pulse 2.4s ease infinite;
}
@keyframes lf-pulse {
  0%   { box-shadow: 0 0 0 0 rgba(34,197,94,.5); }
  60%  { box-shadow: 0 0 0 5px rgba(34,197,94,.0); }
  100% { box-shadow: 0 0 0 0 rgba(34,197,94,.0); }
}
/* Chart */
.lf-chart { display: block; width: 100%; margin-top: 14px; }
/* Revenue hero stat */
.lf-revenue {
  padding: 22px 20px 18px;
  border-bottom: 1px solid rgba(0,0,0,.06);
  background: linear-gradient(135deg, rgba(34,197,94,.06) 0%, rgba(255,255,255,0) 55%);
}
.lf-revenue-label {
  font-size: .67rem; font-weight: 600; color: #6b7280; letter-spacing: .07em; text-transform: uppercase; margin-bottom: 8px;
}
.lf-revenue-number {
  font-size: 2.2rem; font-weight: 800; color: var(--accent-deep); letter-spacing: -.05em; line-height: 1;
}
.lf-revenue-sub {
