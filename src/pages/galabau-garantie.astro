---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="3 GaLaBau-Aufträge in 30 Tagen — Garantiert | Fastra One"
  description="Wir garantieren dir 3 qualifizierte Auftragsanfragen in 30 Tagen — oder du zahlst nichts. Exklusiv für GaLaBau-Betriebe."
  navVariant="none"
  footerVariant="none"
>

<Fragment slot="head">
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@1,9..144,500&display=swap" rel="stylesheet" />
  <style is:global>

/* ═══════════════════════════════════
   TOKENS
═══════════════════════════════════ */
:root {
  --accent:       #22c55e;
  --accent-deep:  #15803d;
  --accent-soft:  rgba(34,197,94,.09);
  --accent-line:  rgba(34,197,94,.22);
  --ink:          #0d1117;
  --ink-2:        #374151;
  --bg:           #ffffff;
  --bg-alt:       #f8fdf9;
  --line:         rgba(0,0,0,.06);
  --card-line:    #e5e7eb;
  --red:          #ef4444;
  --red-soft:     rgba(239,68,68,.07);
  --red-line:     rgba(239,68,68,.22);
  --f-serif:      'Fraunces', Georgia, serif;
  --f-sans:       'Inter', -apple-system, sans-serif;
  --r-pill:       100px;
  --r-card:       18px;
  --r-sm:         10px;
  --shadow-sm:    0 1px 2px rgba(0,0,0,.05), 0 4px 12px rgba(0,0,0,.06);
  --shadow-md:    0 2px 4px rgba(0,0,0,.04), 0 12px 32px rgba(0,0,0,.08);
  --shadow-lg:    0 4px 8px rgba(0,0,0,.04), 0 24px 64px rgba(0,0,0,.10);
  --shadow-xl:    0 8px 16px rgba(0,0,0,.04), 0 40px 80px -12px rgba(0,0,0,.16);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html  { scroll-behavior: smooth; }
body  {
  font-family: var(--f-sans); background: var(--bg); color: var(--ink);
  -webkit-font-smoothing: antialiased; overflow-x: hidden;
  font-feature-settings: 'rlig' 1, 'calt' 1;
}
a     { color: inherit; text-decoration: none; }
img   { max-width: 100%; display: block; }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
.wrap { max-width: 1100px; margin: 0 auto; padding: 0 28px; }

/* ═══════════════════════════════════
   REVEAL ANIMATIONS
═══════════════════════════════════ */
.reveal { opacity: 0; transform: translateY(20px); transition: opacity .65s ease, transform .65s ease; }
.reveal.is-visible { opacity: 1; transform: none; }
.reveal.d1 { transition-delay: .1s; }
.reveal.d2 { transition-delay: .2s; }
.reveal.d3 { transition-delay: .3s; }
@media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; transition: none; } }

/* ═══════════════════════════════════
   URGENCY BAR
═══════════════════════════════════ */
.urg {
  background: #dc2626;
  color: #fff;
  display: flex; align-items: center; justify-content: center;
  gap: 10px; padding: 9px 20px;
  font-size: .82rem; font-weight: 600;
  position: relative; z-index: 10;
  flex-wrap: wrap;
}
.urg-dot {
  width: 8px; height: 8px; border-radius: 50%;
  background: #fff; flex-shrink: 0;
  animation: pulseOrange 2s ease-out infinite;
}
@keyframes pulseOrange {
  0%   { box-shadow: 0 0 0 0 rgba(255,255,255,.7); }
  70%  { box-shadow: 0 0 0 7px rgba(255,255,255,0); }
  100% { box-shadow: 0 0 0 0 rgba(255,255,255,0); }
}
.urg strong { color: #fff; font-weight: 800; }
.urg-sep { color: rgba(255,255,255,.4); }
.urg-btn {
  background: rgba(255,255,255,.18); border: 1px solid rgba(255,255,255,.45);
  color: #fff; font-size: .77rem; font-weight: 700;
  padding: 4px 13px; border-radius: 999px; cursor: pointer;
  letter-spacing: .01em; transition: background .18s;
}
.urg-btn:hover { background: rgba(255,255,255,.28); }

/* ═══════════════════════════════════
   NAV — Pill (Faris-Schmidt-Referenz)
═══════════════════════════════════ */
.nav-outer {
  position: sticky; top: 0; z-index: 100;
  display: flex; justify-content: center;
  padding: 12px 16px;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}
nav.pill {
  width: 100%; max-width: 1060px;
  display: flex; align-items: center; justify-content: space-between;
  background: rgba(255,255,255,.9);
  border: 1px solid rgba(0,0,0,.06);
  border-radius: var(--r-pill);
  padding: 10px 10px 10px 22px;
  box-shadow: 0 1px 3px rgba(0,0,0,.04), 0 8px 24px rgba(0,0,0,.05);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}
.nav-brand {
  display: flex; align-items: center; gap: 8px;
  font-weight: 800; font-size: .98rem; letter-spacing: -.02em;
}
.nav-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--accent); }
nav.pill ul { display: flex; gap: 26px; list-style: none; }
nav.pill ul a { font-size: .86rem; font-weight: 500; color: var(--ink-2); transition: color .2s; }
nav.pill ul a:hover { color: var(--ink); }
@media (max-width: 700px) { nav.pill ul { display: none; } }

/* ═══════════════════════════════════
   BUTTONS
═══════════════════════════════════ */
.btn {
  display: inline-flex; align-items: center; gap: 8px;
  border-radius: var(--r-pill); border: none; cursor: pointer;
  font-family: var(--f-sans); font-weight: 400; font-size: .92rem;
  letter-spacing: -.02em; white-space: nowrap;
  padding: 11px 11px 11px 20px;
  box-shadow: rgba(255,255,255,.12) 0 0 0 3px inset;
  transition: transform .3s cubic-bezier(.34,1.56,.64,1), box-shadow .3s;
}
.btn:hover { transform: translateY(-2px); }
.btn-primary { background: var(--accent); color: #fff; }
.btn-primary:hover { box-shadow: rgba(255,255,255,.12) 0 0 0 3px inset, rgba(34,197,94,.30) 0 8px 28px; }
.btn-dark { background: var(--ink); color: #fff; }
.btn-dark:hover { box-shadow: rgba(255,255,255,.12) 0 0 0 3px inset, rgba(0,0,0,.22) 0 8px 28px; }
.btn-outline {
  background: var(--bg); color: var(--ink);
  border: 1px solid var(--card-line); box-shadow: none;
  padding: 11px 20px;
}
.btn-outline:hover { box-shadow: var(--shadow-sm); }
.btn-sm { font-size: .8rem; padding: 8px 8px 8px 14px; }
.btn-arrow {
  width: 26px; height: 26px; border-radius: 50%; background: #fff;
  display: inline-flex; align-items: center; justify-content: center; flex: none;
}
.btn-primary .btn-arrow { color: var(--accent); }
.btn-dark    .btn-arrow { color: var(--ink); }
.btn-sm .btn-arrow { width: 22px; height: 22px; }

/* ═══════════════════════════════════
   PULSE DOT
═══════════════════════════════════ */
.pulse-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); position: relative; flex: none; }
.pulse-dot::after {
  content: ''; position: absolute; inset: -5px;
  border-radius: 50%; border: 2px solid var(--accent);
  animation: pulse-ring 2s ease infinite;
}
@keyframes pulse-ring { 0%{transform:scale(.5);opacity:.8} 100%{transform:scale(1.9);opacity:0} }
@media (prefers-reduced-motion: reduce) { .pulse-dot::after { animation: none; display: none; } }

/* ═══════════════════════════════════
   HERO — Apple-Stil
═══════════════════════════════════ */
.hero {
  padding: 72px 0 64px;
  text-align: center;
  position: relative;
  overflow: hidden;
  background: transparent;
}
/* ─── Hero-Zone: Bild hinter Urg + Nav + Hero ─── */
.hero-zone {
  position: relative;
}
.hero-bg-photo {
  position: absolute; inset: 0; z-index: 0;
  width: 100%; height: 100%; object-fit: cover;
  object-position: center 40%;
  opacity: .42;
  filter: saturate(1.15);
  pointer-events: none;
}
/* Gradient: oben transparent, unten weiß → Übergang zum Kalender */
.hero::before {
  display: block;
  content: '';
  position: absolute; inset: 0; z-index: 1;
  background: linear-gradient(to bottom,
    rgba(255,255,255,.18) 0%,
    rgba(255,255,255,.52) 50%,
    rgba(255,255,255,1)   85%
  );
  pointer-events: none;
}
/* Dezentes Dot-Grid (wie Referenz-Template) */
.hero::after {
  content: '';
  position: absolute; inset: 0;
  background-image: radial-gradient(circle, rgba(34,197,94,.12) 1px, transparent 1.2px);
  background-size: 28px 28px;
  -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 30%, #000 0%, transparent 100%);
  mask-image: radial-gradient(ellipse 80% 60% at 50% 30%, #000 0%, transparent 100%);
  pointer-events: none;
  opacity: .45;
}
.hero .wrap { position: relative; z-index: 2; max-width: 780px; }

.hero-badge {
  display: inline-flex; align-items: center; gap: 8px;
  background: var(--accent-soft); border: 1px solid var(--accent-line);
  border-radius: var(--r-pill);
  padding: 7px 16px 7px 10px;
  font-size: .79rem; font-weight: 600; color: var(--accent-deep);
  margin-bottom: 28px;
}

/* Headline — Apple-Format: groß, eng, präzise */
.hero h1 {
  font-family: var(--f-sans); font-weight: 800;
  font-size: clamp(2.8rem, 7vw, 5rem);
  line-height: 1.04; letter-spacing: -.04em;
  margin: 0 auto 18px;
  max-width: 14ch;
}
.hero h1 em {
  font-family: var(--f-serif); font-style: italic;
  font-weight: 500; color: var(--accent);
  letter-spacing: -.02em;
}
.hero-sub {
  font-size: clamp(1rem, 2vw, 1.15rem);
  color: var(--ink-2); line-height: 1.65;
  max-width: 46ch; margin: 0 auto 22px;
}

/* Garantie-Pill */
.g-pill {
  display: inline-flex; align-items: center; gap: 8px;
  background: #dc2626; border: none;
  color: #fff; font-size: .88rem; font-weight: 800;
  padding: 9px 20px; border-radius: 8px; margin-bottom: 24px;
  letter-spacing: .01em; box-shadow: 0 2px 12px rgba(220,38,38,.35);
}

/* Google-Bewertungen */
.google-row {
  display: flex; align-items: center; justify-content: center; gap: 10px;
  margin-bottom: 32px;
}
.stars { color: #f59e0b; letter-spacing: 2px; font-size: .92rem; }
.google-text { font-size: .77rem; color: var(--ink-2); }
.google-text strong { color: var(--ink); }

/* ═══════════════════════════════════
   FORM CARD — Glassmorphism
═══════════════════════════════════ */
.form-card {
  background: rgba(255,255,255,.88);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border: 1px solid rgba(255,255,255,.75);
  border-radius: 22px;
  box-shadow:
    0 2px 4px rgba(0,0,0,.03),
    0 12px 36px rgba(0,0,0,.07),
    0 40px 80px rgba(0,0,0,.06),
    inset 0 1px 0 rgba(255,255,255,.9);
  padding: 36px 32px;
  max-width: 460px;
  margin: 0 auto;
  text-align: left;
}
.fp {
  display: flex; gap: 5px; margin-bottom: 28px;
}
.fp-dot {
  flex: 1; height: 3px; border-radius: 3px;
  background: var(--card-line); transition: background .35s;
}
.fp-dot.active { background: var(--accent); }
.fp-dot.done   { background: rgba(34,197,94,.4); }

.f-step { display: none; }
.f-step.visible { display: block; }
.f-q { font-size: 1.15rem; font-weight: 700; letter-spacing: -.02em; margin-bottom: 14px; line-height: 1.3; }
.f-input {
  width: 100%; background: rgba(248,250,252,.8);
  border: 1.5px solid var(--card-line);
  border-radius: 12px; color: var(--ink);
  font-family: var(--f-sans); font-size: 1.05rem;
  padding: 14px 16px; outline: none;
  transition: border-color .2s, box-shadow .2s, background .2s;
}
.f-input::placeholder { color: #c4cad3; }
.f-input:focus {
  border-color: var(--accent); background: var(--bg);
  box-shadow: 0 0 0 3px rgba(34,197,94,.12);
}
.f-input.err { border-color: var(--red); }
.f-hint { font-size: .73rem; color: #9ca3af; margin-top: 6px; }
.f-err { font-size: .74rem; color: var(--red); margin-top: 5px; display: none; }
.f-err.show { display: block; }
.f-btn {
  display: block; width: 100%; margin-top: 14px;
  background: var(--ink); color: #fff;
  font-family: var(--f-sans); font-weight: 600; font-size: 1rem;
  padding: 15px; border-radius: 12px; border: none; cursor: pointer;
  letter-spacing: -.01em;
  box-shadow: rgba(255,255,255,.10) 0 0 0 3px inset;
  transition: background .2s, transform .3s cubic-bezier(.34,1.56,.64,1), box-shadow .3s;
}
.f-btn:hover { background: #1a1a2e; transform: translateY(-2px); box-shadow: rgba(255,255,255,.10) 0 0 0 3px inset, rgba(0,0,0,.2) 0 8px 24px; }
.f-btn.green { background: var(--accent); }
.f-btn.green:hover { background: var(--accent-deep); box-shadow: rgba(255,255,255,.12) 0 0 0 3px inset, rgba(34,197,94,.28) 0 8px 24px; }
.f-btn:disabled { opacity: .5; cursor: not-allowed; transform: none; box-shadow: none; }

.f-news { display: flex; gap: 10px; align-items: flex-start; margin-top: 14px; }
.f-news input[type="checkbox"] { width: 15px; height: 15px; margin-top: 2px; flex-shrink: 0; accent-color: var(--accent); cursor: pointer; }
.f-news label { font-size: .72rem; color: var(--ink-2); line-height: 1.5; cursor: pointer; }
.f-news label a { color: var(--accent-deep); text-decoration: underline; }

/* Thank You */
.f-ty { display: none; text-align: center; padding: 8px 0; }
.f-ty.visible { display: block; }
.f-ty-icon { color: var(--accent); width: 48px; height: 48px; margin: 0 auto 14px; }
.f-ty-h { font-size: 1.25rem; font-weight: 800; letter-spacing: -.02em; margin-bottom: 8px; }
.f-ty-p { font-size: .9rem; color: var(--ink-2); line-height: 1.6; max-width: 300px; margin: 0 auto; }
.f-ty-p strong { color: var(--accent-deep); }
.f-ty-hr { border: none; border-top: 1px solid var(--card-line); margin: 22px 0; }
.f-ty-profile {
  display: flex; align-items: center; gap: 13px;
  background: var(--bg-alt); border: 1px solid var(--card-line);
  border-radius: 14px; padding: 14px 16px; text-align: left; margin-bottom: 20px;
}
.f-ty-ava {
  width: 50px; height: 50px; border-radius: 50%; flex-shrink: 0;
  background: var(--accent-soft);
  display: flex; align-items: center; justify-content: center; overflow: hidden;
}
.f-ty-ava svg { color: var(--accent-deep); }
.f-ty-ava img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
.f-ty-name { font-size: .86rem; font-weight: 700; }
.f-ty-role { font-size: .73rem; color: var(--ink-2); margin-bottom: 3px; }
.f-ty-q    { font-size: .78rem; color: var(--ink); line-height: 1.5; font-style: italic; }
.f-ty-cal-l { font-size: .78rem; color: var(--ink-2); text-align: center; margin-bottom: 10px; }
.f-ty-cal-l strong { display: block; font-size: .9rem; color: var(--ink); margin-top: 1px; }

/* ═══════════════════════════════════
   TRUST PILLS (below form)
═══════════════════════════════════ */
.trust-row {
  display: flex; justify-content: center; gap: 20px; flex-wrap: wrap;
  margin-top: 16px;
}
.trust-pill {
  display: inline-flex; align-items: center; gap: 5px;
  font-size: .74rem; color: var(--ink-2);
}
.trust-pill svg { color: var(--accent); }

/* ═══════════════════════════════════
   MOCKUP SECTION — Referenz exakt
═══════════════════════════════════ */
.mockup-section { padding: 40px 0 96px; }
.mockup-wrap {
  position: relative;
  max-width: 900px; margin: 0 auto; padding: 0 28px;
}
.mockup-outer {
  background: linear-gradient(160deg, #eef4f1, #fafdf9);
  background-image: radial-gradient(circle, rgba(34,197,94,.13) 1px, transparent 1.4px);
  background-size: 22px 22px;
  border: 1px solid rgba(0,0,0,.06);
  border-radius: 26px;
  padding: 24px;
  box-shadow: var(--shadow-xl);
}
.mockup-inner {
  background: var(--bg);
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 24px 28px;
  text-align: left;
}
.m-dots { display: flex; gap: 6px; margin-bottom: 20px; }
.m-dots span { width: 10px; height: 10px; border-radius: 50%; background: var(--card-line); }

/* Kalender-Inhalt */
.m-header {
  display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;
}
.m-live {
  display: flex; align-items: center; gap: 7px;
  font-size: .72rem; font-weight: 700; text-transform: uppercase;
  letter-spacing: .05em; color: var(--accent-deep);
}
.m-service { font-size: .84rem; font-weight: 700; }
.m-service small { display: block; font-size: .7rem; font-weight: 400; color: var(--ink-2); }
.m-avtr {
  width: 32px; height: 32px; border-radius: 50%;
  background: linear-gradient(135deg, var(--accent), var(--accent-deep));
  color: #fff; font-size: .72rem; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.m-split { display: grid; grid-template-columns: 1fr 1px 180px; }
@media (max-width: 680px) { .m-split { grid-template-columns: 1fr; } }
.m-div { background: var(--line); margin: 0 22px; }
@media (max-width: 680px) { .m-div { display: none; } }
.m-cal { padding-right: 0; }
@media (max-width: 680px) { .m-cal { margin-bottom: 18px; } }
.m-month-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
.m-month { font-size: .85rem; font-weight: 700; }
.m-navs { display: flex; gap: 4px; }
.m-nav {
  width: 24px; height: 24px; border: 1px solid var(--card-line);
  border-radius: 6px; background: none; cursor: pointer;
  color: var(--ink-2); font-size: .78rem;
  display: flex; align-items: center; justify-content: center;
  transition: background .15s;
}
.m-nav:hover { background: var(--accent-soft); }
.m-wdays { display: grid; grid-template-columns: repeat(7,1fr); text-align: center; margin-bottom: 4px; }
.m-wdays span { font-size: .62rem; font-weight: 600; color: #9ca3af; }
.m-days { display: grid; grid-template-columns: repeat(7,1fr); gap: 1px; text-align: center; }
.m-days span { padding: 5px 0; font-size: .74rem; border-radius: 6px; }
.m-days .av { color: var(--accent-deep); font-weight: 600; cursor: pointer; }
.m-days .av:hover { background: var(--accent-soft); }
.m-days .sel { background: var(--accent); color: #fff; font-weight: 700; }
.m-days .td { font-weight: 700; box-shadow: inset 0 0 0 1.5px var(--accent); border-radius: 6px; }
.m-days .dim { color: #d1d5db; }
.m-times-col {
  padding-left: 22px; display: flex; flex-direction: column; justify-content: center;
}
@media (max-width: 680px) { .m-times-col { padding-left: 0; border-top: 1px solid var(--line); padding-top: 14px; } }
.m-tlabel { font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: #9ca3af; margin-bottom: 10px; }
.m-slots { display: flex; flex-direction: column; gap: 6px; }
.m-slot {
  padding: 8px 14px; border-radius: 9px; border: 1px solid var(--card-line);
  font-size: .79rem; background: none; cursor: pointer;
  text-align: center; transition: all .15s;
}
.m-slot:hover { border-color: var(--accent); color: var(--accent-deep); }
.m-slot.sel { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 600; }
.m-confirm {
  display: block; width: 100%; margin-top: 10px;
  background: var(--ink); color: #fff;
  font-family: var(--f-sans); font-size: .84rem; font-weight: 600;
  padding: 10px; border-radius: 9px; border: none; cursor: pointer;
  box-shadow: rgba(255,255,255,.08) 0 0 0 2px inset;
  transition: background .2s, transform .2s;
}
.m-confirm:hover { background: #1a1a2e; transform: translateY(-1px); }

/* Float-Cards — Referenz-exakt: Spring-Pop + tiefer Schatten */
.float-card {
  position: absolute;
  background: var(--bg);
  border: 1px solid var(--line);
  border-radius: 18px;
  box-shadow: 0 20px 48px rgba(13,15,26,.13), 0 4px 12px rgba(0,0,0,.06);
  padding: 16px 20px;
  opacity: 0; transform: translateY(16px) scale(.92);
  transition: opacity .5s cubic-bezier(.34,1.56,.64,1), transform .5s cubic-bezier(.34,1.56,.64,1);
  white-space: nowrap;
}
.mockup-wrap.is-visible .float-card { opacity: 1; transform: none; }
/* Stat card: Fraunces-Zahl */
.float-card.stat { top: 3%; left: -2.5%; transition-delay: .15s; }
.fc-num {
  font-family: var(--f-serif); font-size: 1.65rem; font-weight: 500;
  font-style: italic; color: var(--accent); line-height: 1.1; display: block;
}
.fc-lbl { font-size: .73rem; color: var(--ink-2); margin-top: 2px; display: block; line-height: 1.4; }
/* Notif card */
.float-card.notif { bottom: 5%; right: -2.5%; display: flex; align-items: flex-start; gap: 12px; max-width: 290px; transition-delay: .35s; }
.fc-ic {
  width: 36px; height: 36px; border-radius: 10px;
  background: var(--accent-soft);
