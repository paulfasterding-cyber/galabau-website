---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="3 GaLaBau-Aufträge in 30 Tagen — Garantiert | Fastra One"
  description="Wir garantieren dir 3 neue Aufträge in den nächsten 30 Tagen — oder du zahlst nichts. Exklusiv für GaLaBau-Betriebe."
  navVariant="none"
  footerVariant="none"
>

<Fragment slot="head">
  <meta name="robots" content="noindex, nofollow" />
  <style is:global>

/* ═══════════════════════════════════════════════════════════
   RESET & BASE
═══════════════════════════════════════════════════════════ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg:        #050e07;
  --bg2:       #091409;
  --mint:      #6EEC9D;
  --mint-dim:  rgba(110,236,157,.12);
  --red:       #ff4444;
  --red-dim:   rgba(255,68,68,.12);
  --white:     #ffffff;
  --grey:      rgba(255,255,255,.55);
  --grey-light:rgba(255,255,255,.08);
  --border:    rgba(255,255,255,.08);
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
}

body { background: var(--bg); color: var(--white); line-height: 1.6; }

.g-container { max-width: 680px; margin: 0 auto; padding: 0 20px; }
.g-wide      { max-width: 900px; margin: 0 auto; padding: 0 20px; }

/* ═══════════════════════════════════════════════════════════
   URGENCY BAR
═══════════════════════════════════════════════════════════ */
.g-topbar {
  background: var(--red);
  color: #fff;
  text-align: center;
  padding: 10px 20px;
  font-size: .82rem;
  font-weight: 700;
  letter-spacing: .02em;
  position: sticky;
  top: 0;
  z-index: 100;
}
.g-topbar span { font-weight: 400; }

/* ═══════════════════════════════════════════════════════════
   HERO
═══════════════════════════════════════════════════════════ */
.g-hero {
  padding: 72px 0 60px;
  text-align: center;
  position: relative;
  overflow: hidden;
}
.g-hero::before {
  content: '';
  position: absolute;
  top: -80px; left: 50%;
  transform: translateX(-50%);
  width: 600px; height: 600px;
  background: radial-gradient(ellipse, rgba(110,236,157,.10) 0%, transparent 70%);
  pointer-events: none;
}

.g-pill {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  background: var(--mint-dim);
  border: 1px solid rgba(110,236,157,.25);
  color: var(--mint);
  font-size: .75rem;
  font-weight: 700;
  letter-spacing: .06em;
  text-transform: uppercase;
  padding: 6px 14px;
  border-radius: 99px;
  margin-bottom: 28px;
}
.g-pill-dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--mint);
  animation: pulse 2s infinite;
}
@keyframes pulse {
  0%,100% { opacity:1; transform:scale(1); }
  50%      { opacity:.4; transform:scale(.8); }
}

.g-h1 {
  font-size: clamp(2rem, 5.5vw, 3.4rem);
  font-weight: 900;
  line-height: 1.1;
  letter-spacing: -.02em;
  margin-bottom: 20px;
}
.g-h1 .accent {
  background: linear-gradient(135deg, #6EEC9D, #3cd870);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.g-guarantee-badge {
  display: inline-block;
  margin-bottom: 24px;
  background: var(--red-dim);
  border: 1px solid rgba(255,68,68,.3);
  color: #ff6666;
  font-size: .85rem;
  font-weight: 700;
  padding: 8px 18px;
  border-radius: 6px;
  letter-spacing: .01em;
}

.g-sub {
  font-size: clamp(1rem, 2vw, 1.15rem);
  color: var(--grey);
  max-width: 560px;
  margin: 0 auto 36px;
  line-height: 1.7;
}
.g-sub strong { color: var(--white); }

.g-hero-cta {
  display: inline-block;
  background: var(--mint);
  color: #030a04;
  font-weight: 800;
  font-size: 1.05rem;
  padding: 18px 36px;
  border-radius: 8px;
  border: none;
  cursor: pointer;
  transition: transform .15s, box-shadow .15s;
  text-decoration: none;
  letter-spacing: .01em;
}
.g-hero-cta:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 40px rgba(110,236,157,.35);
}

.g-trust-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20px;
  margin-top: 20px;
  font-size: .78rem;
  color: var(--grey);
  flex-wrap: wrap;
}
.g-trust-row span { display: flex; align-items: center; gap: 5px; }
.g-trust-row .tick { color: var(--mint); font-size: 1rem; }

/* ═══════════════════════════════════════════════════════════
   PROBLEM / PAIN
═══════════════════════════════════════════════════════════ */
.g-pain {
  padding: 60px 0;
  border-top: 1px solid var(--border);
}
.g-section-label {
  font-size: .72rem;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--grey);
  margin-bottom: 12px;
}
.g-h2 {
  font-size: clamp(1.5rem, 3.5vw, 2.1rem);
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: -.02em;
  margin-bottom: 24px;
}
.g-pain-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.g-pain-list li {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  font-size: 1rem;
  color: rgba(255,255,255,.8);
  line-height: 1.5;
}
.g-pain-list .icon {
  font-size: 1.1rem;
  flex-shrink: 0;
  margin-top: 2px;
}

/* ═══════════════════════════════════════════════════════════
   AGITATE
═══════════════════════════════════════════════════════════ */
.g-agitate {
  padding: 0 0 60px;
}
.g-agitate-box {
  background: rgba(255,68,68,.06);
  border: 1px solid rgba(255,68,68,.2);
  border-radius: 12px;
  padding: 32px;
}
.g-agitate-box p {
  font-size: 1.05rem;
  line-height: 1.7;
  color: rgba(255,255,255,.85);
}
.g-agitate-box p + p { margin-top: 14px; }
.g-agitate-box strong { color: #fff; }

/* ═══════════════════════════════════════════════════════════
   SOLUTION / VALUE STACK
═══════════════════════════════════════════════════════════ */
.g-solution {
  padding: 60px 0;
  border-top: 1px solid var(--border);
}
.g-stack {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 28px;
}
.g-stack-item {
  display: flex;
  gap: 14px;
  align-items: flex-start;
  background: var(--grey-light);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 16px 18px;
}
.g-stack-item .si-icon {
  font-size: 1.3rem;
  flex-shrink: 0;
  margin-top: 1px;
}
.g-stack-item .si-text strong {
  display: block;
  font-size: .95rem;
  font-weight: 700;
  margin-bottom: 2px;
}
.g-stack-item .si-text span {
  font-size: .83rem;
  color: var(--grey);
  line-height: 1.4;
}

/* ═══════════════════════════════════════════════════════════
   GUARANTEE BOX
═══════════════════════════════════════════════════════════ */
.g-guarantee {
  padding: 60px 0;
}
.g-guarantee-box {
  background: linear-gradient(135deg, rgba(110,236,157,.08), rgba(110,236,157,.03));
  border: 1.5px solid rgba(110,236,157,.3);
  border-radius: 16px;
  padding: 40px 32px;
  text-align: center;
}
.g-guarantee-icon { font-size: 3rem; margin-bottom: 16px; }
.g-guarantee-title {
  font-size: clamp(1.4rem, 3vw, 2rem);
  font-weight: 900;
  letter-spacing: -.02em;
  margin-bottom: 16px;
  line-height: 1.2;
}
.g-guarantee-title .accent-g {
  background: linear-gradient(135deg, #6EEC9D, #3cd870);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.g-guarantee-body {
  font-size: .98rem;
  color: var(--grey);
  max-width: 480px;
  margin: 0 auto;
  line-height: 1.6;
}

/* ═══════════════════════════════════════════════════════════
   MULTI-STEP FORM
═══════════════════════════════════════════════════════════ */
.g-funnel {
  padding: 60px 0 80px;
  border-top: 1px solid var(--border);
  background: var(--bg2);
}
.g-funnel-wrap {
  max-width: 520px;
  margin: 0 auto;
  padding: 0 20px;
}
.g-funnel-head {
  text-align: center;
  margin-bottom: 40px;
}
.g-funnel-head .step-label {
  font-size: .72rem;
  color: var(--mint);
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  margin-bottom: 8px;
}
.g-funnel-head .step-title {
  font-size: clamp(1.2rem, 3vw, 1.6rem);
  font-weight: 800;
  letter-spacing: -.02em;
}
.g-funnel-head .step-sub {
  font-size: .88rem;
  color: var(--grey);
  margin-top: 6px;
}

/* Progress bar */
.g-progress {
  display: flex;
  gap: 6px;
  margin-bottom: 36px;
}
.g-progress-dot {
  flex: 1;
  height: 3px;
  border-radius: 3px;
  background: var(--grey-light);
  transition: background .3s;
}
.g-progress-dot.active { background: var(--mint); }
.g-progress-dot.done   { background: rgba(110,236,157,.5); }

/* Step content */
.g-step { display: none; }
.g-step.visible { display: block; }

.g-field-label {
  display: block;
  font-size: .78rem;
  font-weight: 700;
  letter-spacing: .06em;
  text-transform: uppercase;
  color: var(--grey);
  margin-bottom: 10px;
}
.g-input {
  width: 100%;
  background: rgba(255,255,255,.05);
  border: 1.5px solid var(--border);
  border-radius: 8px;
  color: var(--white);
  font-size: 1.1rem;
  padding: 16px 18px;
  outline: none;
  transition: border-color .2s;
  font-family: inherit;
  appearance: none;
}
.g-input::placeholder { color: rgba(255,255,255,.25); }
.g-input:focus { border-color: var(--mint); }
.g-input.error { border-color: var(--red); }

.g-next-btn {
  display: block;
  width: 100%;
  margin-top: 16px;
  background: var(--mint);
  color: #030a04;
  font-weight: 800;
  font-size: 1.05rem;
  padding: 17px;
  border-radius: 8px;
  border: none;
  cursor: pointer;
  transition: transform .15s, box-shadow .15s, opacity .2s;
  font-family: inherit;
  letter-spacing: .01em;
}
.g-next-btn:hover { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(110,236,157,.3); }
.g-next-btn:disabled { opacity: .5; cursor: not-allowed; transform: none; box-shadow: none; }

.g-err-msg {
  color: var(--red);
  font-size: .78rem;
  margin-top: 6px;
  display: none;
}
.g-err-msg.show { display: block; }

/* Thank you */
.g-thankyou {
  display: none;
  text-align: center;
  padding: 20px 0;
}
.g-thankyou.visible { display: block; }
.g-thankyou-icon { font-size: 3.5rem; margin-bottom: 20px; }
.g-thankyou-title {
  font-size: clamp(1.4rem, 3vw, 2rem);
  font-weight: 900;
  letter-spacing: -.02em;
  margin-bottom: 12px;
}
.g-thankyou-sub {
  font-size: .98rem;
  color: var(--grey);
  line-height: 1.6;
  max-width: 400px;
  margin: 0 auto;
}

/* ═══════════════════════════════════════════════════════════
   RESPONSIVE
═══════════════════════════════════════════════════════════ */
@media (max-width: 600px) {
  .g-guarantee-box { padding: 28px 20px; }
  .g-agitate-box   { padding: 24px 18px; }
}

  </style>
</Fragment>

<!-- URGENCY BAR -->
<div class="g-topbar">
  Nur noch <span>&nbsp;1 freier Platz&nbsp;</span> in deiner Region — danach ist es zu spät
</div>

<!-- ═══════════════════════════════════════════════════════════
     HERO
═══════════════════════════════════════════════════════════ -->
<section class="g-hero">
  <div class="g-container">

    <div class="g-pill">
      <span class="g-pill-dot"></span>
      Exklusiv für GaLaBau-Betriebe
    </div>

    <h1 class="g-h1">
      Wir garantieren dir<br>
      <span class="accent">3 neue Aufträge</span><br>
      in 30 Tagen.
    </h1>

    <div class="g-guarantee-badge">Oder du zahlst uns keinen Cent.</div>

    <p class="g-sub">
      Kein Risiko. Kein Eigenaufwand. Kein Technik-Stress.<br>
      <strong>Du baust — wir bringen die Aufträge.</strong>
    </p>

    <button class="g-hero-cta" onclick="scrollToFunnel()">
      Jetzt kostenlos anfragen →
    </button>

    <div class="g-trust-row">
      <span><span class="tick">✓</span> Kostenlos &amp; unverbindlich</span>
      <span><span class="tick">✓</span> Antwort in 24 Stunden</span>
      <span><span class="tick">✓</span> 1× pro Region</span>
    </div>

  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     PROBLEM — SCHMERZ
═══════════════════════════════════════════════════════════ -->
<section class="g-pain">
  <div class="g-container">

    <p class="g-section-label">Das Problem</p>
    <h2 class="g-h2">Sei mal ehrlich zu dir selbst.</h2>

    <ul class="g-pain-list">
      <li>
        <span class="icon">😤</span>
        <span>Du weißt heute nicht, was du <strong>nächsten Monat</strong> bauen wirst. Keine Planbarkeit. Nur Hoffnung.</span>
      </li>
      <li>
        <span class="icon">📞</span>
        <span>Du hast dein Auftragsbuch mit <strong>Empfehlungen und Mundpropaganda</strong> gefüllt. Das ist kein System. Das ist Glück.</span>
      </li>
      <li>
        <span class="icon">😰</span>
        <span>Die ruhigen Wochen im Winter oder zwischen den Projekten? <strong>Stress pur.</strong> Wo kommt der nächste Auftrag her?</span>
      </li>
      <li>
        <span class="icon">🏃</span>
        <span>Du hast keine Zeit für Marketing. Du bist auf der Baustelle — und abends bist du zu erschöpft um dich darum zu kümmern.</span>
      </li>
    </ul>

  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     AGITATE
═══════════════════════════════════════════════════════════ -->
<section class="g-agitate">
  <div class="g-container">
    <div class="g-agitate-box">
      <p>
        Während du das liest, hat dein Wettbewerber gerade ein System aufgesetzt.
        Er weiß heute schon, was er in 6 Wochen baut. Sein Auftragsbuch ist voll.
        Er muss keine Aufträge mehr jagen — <strong>die kommen automatisch.</strong>
      </p>
      <p>
        Solange du nichts änderst, bleibt das so. Die Lücke zwischen dir und ihm
        wird jeden Monat größer. Nicht weil er besser ist als du.
        Sondern weil er ein System hat — und du noch nicht.
      </p>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     SOLUTION — VALUE STACK
═══════════════════════════════════════════════════════════ -->
<section class="g-solution">
  <div class="g-container">

    <p class="g-section-label">Die Lösung</p>
    <h2 class="g-h2">Wir übernehmen das komplett für dich.</h2>
    <p style="color:var(--grey);font-size:.98rem;margin-bottom:4px;">
      Du bekommst ein fertiges System das Anfragen bringt — in 30 Tagen.
    </p>

    <div class="g-stack">
      <div class="g-stack-item">
        <span class="si-icon">🌐</span>
        <div class="si-text">
          <strong>Hochkonvertierende Webseite</strong>
          <span>Speziell für GaLaBau-Betriebe gebaut — nicht irgendein Template.</span>
        </div>
      </div>
      <div class="g-stack-item">
        <span class="si-icon">📢</span>
        <div class="si-text">
          <strong>Google Ads — komplett aufgesetzt</strong>
          <span>Wir schalten Ads in deiner Region. Du bekommst die Anfragen. Fertig.</span>
        </div>
      </div>
      <div class="g-stack-item">
        <span class="si-icon">🔄</span>
        <div class="si-text">
          <strong>Lead-Funnel + automatische Vorqualifizierung</strong>
          <span>Nur ernsthafte Anfragen kommen durch — kein Zeitverschwendung.</span>
        </div>
      </div>
      <div class="g-stack-item">
        <span class="si-icon">📊</span>
        <div class="si-text">
          <strong>Live-Dashboard mit deinen Anfragen</strong>
          <span>Du siehst in Echtzeit wer sich angefragt hat — Name, Nummer, sofort.</span>
        </div>
      </div>
      <div class="g-stack-item">
        <span class="si-icon">🔒</span>
        <div class="si-text">
          <strong>Exklusivität in deiner Region</strong>
          <span>Wir arbeiten nur mit einem GaLaBauer pro Region. Dein Wettbewerber bleibt draußen.</span>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     GUARANTEE
═══════════════════════════════════════════════════════════ -->
<section class="g-guarantee">
  <div class="g-container">
    <div class="g-guarantee-box">
      <div class="g-guarantee-icon">🛡️</div>
      <h2 class="g-guarantee-title">
        <span class="accent-g">3 Aufträge in 30 Tagen</span><br>
        — oder kein Cent.
      </h2>
      <p class="g-guarantee-body">
        Wenn du nach 30 Tagen nicht mindestens 3 qualifizierte Auftragsanfragen
        erhalten hast, zahlst du uns nichts. Das Risiko liegt bei uns — nicht bei dir.
        Das ist unser Versprechen.
      </p>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     MULTI-STEP FUNNEL
═══════════════════════════════════════════════════════════ -->
<section class="g-funnel" id="funnel">
  <div class="g-funnel-wrap">

    <div class="g-funnel-head">
      <p class="step-label">Kostenlos &amp; unverbindlich anfragen</p>
      <h2 class="step-title">Sichere dir deinen Platz</h2>
      <p class="step-sub">Nur noch 1 Platz in deiner Region — dauert 30 Sekunden</p>
    </div>

    <!-- Progress -->
    <div class="g-progress" id="gProgress">
      <div class="g-progress-dot active" id="dot-0"></div>
      <div class="g-progress-dot" id="dot-1"></div>
      <div class="g-progress-dot" id="dot-2"></div>
      <div class="g-progress-dot" id="dot-3"></div>
    </div>

    <!-- STEP 0 — Vorname -->
    <div class="g-step visible" id="step-0">
      <label class="g-field-label" for="g-vorname">Wie ist dein Vorname?</label>
      <input class="g-input" id="g-vorname" type="text" placeholder="z.B. Thomas" autocomplete="given-name" />
      <p class="g-err-msg" id="err-0">Bitte gib deinen Vornamen ein.</p>
      <button class="g-next-btn" onclick="nextStep(0)">Weiter →</button>
    </div>

    <!-- STEP 1 — Nachname -->
    <div class="g-step" id="step-1">
      <label class="g-field-label" for="g-nachname">Und dein Nachname?</label>
      <input class="g-input" id="g-nachname" type="text" placeholder="z.B. Müller" autocomplete="family-name" />
      <p class="g-err-msg" id="err-1">Bitte gib deinen Nachnamen ein.</p>
      <button class="g-next-btn" onclick="nextStep(1)">Weiter →</button>
    </div>

    <!-- STEP 2 — Handynummer -->
    <div class="g-step" id="step-2">
      <label class="g-field-label" for="g-phone">Deine Handynummer?</label>
      <input class="g-input" id="g-phone" type="tel" placeholder="z.B. 0162 1234567" autocomplete="tel" />
      <p class="g-err-msg" id="err-2">Bitte gib eine gültige Nummer ein.</p>
      <p style="font-size:.74rem;color:var(--grey);margin-top:8px;">
        Wir rufen dich an — kein Spam, versprochen.
      </p>
      <button class="g-next-btn" onclick="nextStep(2)">Weiter →</button>
    </div>

    <!-- STEP 3 — E-Mail -->
    <div class="g-step" id="step-3">
      <label class="g-field-label" for="g-email">Deine E-Mail-Adresse?</label>
      <input class="g-input" id="g-email" type="email" placeholder="z.B. thomas@musterbau.de" autocomplete="email" />
      <p class="g-err-msg" id="err-3">Bitte gib eine gültige E-Mail-Adresse ein.</p>
      <button class="g-next-btn" id="submitBtn" onclick="submitForm()">
        Jetzt kostenlos Platz sichern →
      </button>
    </div>

    <!-- THANK YOU -->
    <div class="g-thankyou" id="gThankyou">
      <div class="g-thankyou-icon">🎉</div>
      <h2 class="g-thankyou-title">Perfekt — wir melden uns!</h2>
      <p class="g-thankyou-sub">
        Wir haben deine Anfrage erhalten und melden uns innerhalb von
        <strong>24 Stunden</strong> bei dir. Bereite dich auf 3 neue Aufträge vor.
      </p>
    </div>

  </div>
</section>

<!-- ═══════════════════════════════════════════════════════════
     FOOTER
═══════════════════════════════════════════════════════════ -->
<footer style="text-align:center;padding:28px 20px;font-size:.75rem;color:rgba(255,255,255,.3);border-top:1px solid rgba(255,255,255,.06);">
