---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="3 GaLaBau-Aufträge in 30 Tagen — Garantiert | Fastra One"
  description="Wir garantieren dir 3 qualifizierte Auftragsanfragen in 30 Tagen — oder du zahlst nichts. Exklusiv für GaLaBau-Betriebe."
  navVariant="none"
  footerVariant="none"
>

<Fragment slot="head">
  <meta name="robots" content="noindex, nofollow" />
  <!-- Fraunces: Signatur-Serifen-Schrift für Akzent-Wörter in Headlines -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@1,9..144,500&display=swap" rel="stylesheet" />
  <style is:global>

/* ═══════════════════════════════════════════════
   TOKENS
═══════════════════════════════════════════════ */
:root {
  --accent:      #22c55e;
  --accent-deep: #15803d;
  --accent-soft: rgba(34,197,94,.10);
  --accent-line: rgba(34,197,94,.25);
  --ink:         #111111;
  --bg:          #ffffff;
  --white:       #ffffff;
  --gray:        #6b7280;
  --gray-light:  #9ca3af;
  --line:        rgba(0,0,0,.07);
  --card-line:   #e5e7eb;
  --red:         #ef4444;
  --red-soft:    rgba(239,68,68,.08);
  --red-line:    rgba(239,68,68,.25);
  --f-serif:     'Fraunces', Georgia, serif;
  --f-sans:      'Inter', -apple-system, sans-serif;
  --radius-pill: 100px;
  --radius-card: 16px;
  --radius-sm:   10px;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html  { scroll-behavior: smooth; }
body  { font-family: var(--f-sans); background: var(--bg); color: var(--ink);
        -webkit-font-smoothing: antialiased; overflow-x: hidden; }
a     { color: inherit; text-decoration: none; }
img   { max-width: 100%; display: block; }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
.wrap { max-width: 1100px; margin: 0 auto; padding: 0 24px; }

/* ═══════════════════════════════════════════════
   REVEAL ANIMATIONS
═══════════════════════════════════════════════ */
.reveal { opacity: 0; transform: translateY(24px);
          transition: opacity .6s ease, transform .6s ease; }
.reveal.is-visible { opacity: 1; transform: none; }
.reveal.delay-1 { transition-delay: .12s; }
.reveal.delay-2 { transition-delay: .24s; }
.reveal.delay-3 { transition-delay: .36s; }
@media (prefers-reduced-motion: reduce) {
  .reveal { opacity: 1; transform: none; transition: none; }
}

/* ═══════════════════════════════════════════════
   URGENCY BAR
═══════════════════════════════════════════════ */
.urg-bar {
  background: var(--red);
  color: #fff;
  text-align: center;
  padding: 10px 20px;
  font-size: .81rem;
  font-weight: 700;
  letter-spacing: .02em;
}

/* ═══════════════════════════════════════════════
   NAV — Pill-Stil (nachgebaut nach Faris-Schmidt)
═══════════════════════════════════════════════ */
.nav-outer {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  justify-content: center;
  padding: 12px 16px;
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
}
nav.pill {
  width: 100%; max-width: 1060px;
  display: flex; align-items: center; justify-content: space-between;
  background: var(--white);
  border-radius: var(--radius-pill);
  padding: 12px 12px 12px 24px;
  box-shadow: 0 1px 3px rgba(0,0,0,.06), 0 4px 16px rgba(0,0,0,.04);
}
.nav-brand {
  display: flex; align-items: center; gap: 9px;
  font-weight: 800; font-size: 1rem; letter-spacing: -.02em;
}
.nav-dot {
  width: 11px; height: 11px; border-radius: 50%;
  background: var(--accent);
}
nav.pill ul {
  display: flex; gap: 28px; list-style: none;
}
nav.pill ul a {
  font-size: .88rem; font-weight: 500; color: var(--gray);
  transition: color .2s;
}
nav.pill ul a:hover { color: var(--ink); }
@media (max-width: 720px) { nav.pill ul { display: none; } }

/* Buttons — exakt nach Referenz: asymm. Padding, Inset-Lichtring, Hover-Glow */
.btn {
  display: inline-flex; align-items: center; gap: 8px;
  border-radius: var(--radius-pill);
  font-family: var(--f-sans); font-weight: 400;
  font-size: .92rem; letter-spacing: -.02em;
  padding: 11px 11px 11px 20px;
  white-space: nowrap; border: none; cursor: pointer;
  box-shadow: rgba(255,255,255,.12) 0 0 0 3px inset;
  transition: transform .3s, box-shadow .3s;
}
.btn:hover { transform: translateY(-2px); }
.btn-primary { background: var(--accent); color: #fff; }
.btn-primary:hover {
  box-shadow: rgba(255,255,255,.12) 0 0 0 3px inset,
              rgba(34,197,94,.35) 0 8px 24px;
}
.btn-dark { background: var(--ink); color: #fff; }
.btn-dark:hover {
  box-shadow: rgba(255,255,255,.12) 0 0 0 3px inset,
              rgba(0,0,0,.25) 0 8px 24px;
}
.btn-outline {
  background: var(--white); color: var(--ink);
  border: 1px solid var(--card-line); box-shadow: none;
  padding: 11px 20px;
}
.btn-outline:hover { box-shadow: 0 8px 20px rgba(0,0,0,.08); }
.btn-arrow {
  width: 28px; height: 28px; border-radius: 50%;
  background: var(--white); padding: 6px;
  display: inline-flex; align-items: center; justify-content: center;
  flex: none;
}
.btn-primary .btn-arrow { color: var(--accent); }
.btn-dark .btn-arrow { color: var(--ink); }
.btn-sm {
  font-size: .82rem; padding: 9px 9px 9px 16px;
}
.btn-sm .btn-arrow { width: 24px; height: 24px; padding: 5px; }

/* ═══════════════════════════════════════════════
   PULSE DOT (Signatur-Detail "live")
═══════════════════════════════════════════════ */
.pulse-dot {
  width: 8px; height: 8px; border-radius: 50%;
  background: var(--accent); position: relative; flex: none;
}
.pulse-dot::after {
  content: ''; position: absolute; inset: -5px;
  border-radius: 50%; border: 2px solid var(--accent);
  animation: pulse-ring 2s ease infinite;
}
@keyframes pulse-ring {
  0%   { transform: scale(.55); opacity: .8; }
  100% { transform: scale(1.8);  opacity: 0; }
}
@media (prefers-reduced-motion: reduce) {
  .pulse-dot::after { animation: none; display: none; }
}

/* ═══════════════════════════════════════════════
   HERO
═══════════════════════════════════════════════ */
.hero {
  padding: 72px 0 60px;
  text-align: center;
}
.hero .wrap {
  max-width: 760px;
}
.hero-badge {
  display: inline-flex; align-items: center; gap: 8px;
  background: var(--accent-soft); border: 1px solid var(--accent-line);
  border-radius: var(--radius-pill);
  padding: 8px 18px 8px 12px;
  font-size: .8rem; font-weight: 600; color: var(--accent-deep);
  margin-bottom: 26px;
}
.hero h1 {
  font-family: var(--f-sans); font-weight: 800;
  font-size: clamp(2.4rem, 6vw, 4.2rem);
  line-height: 1.06; letter-spacing: -.03em;
  max-width: 18ch; margin: 0 auto 10px;
}
.hero h1 em {
  font-family: var(--f-serif); font-style: italic;
  font-weight: 500; color: var(--accent);
}
.hero h1 .serif-hook {
  font-family: var(--f-serif); font-style: italic;
  font-weight: 500; color: var(--gray); font-size: .7em;
  display: block; margin-bottom: 4px; letter-spacing: -.01em;
}
.hero-sub {
  color: var(--gray); font-size: 1.05rem;
  max-width: 46ch; margin: 0 auto 10px; line-height: 1.65;
}
.hero-sub strong { color: var(--ink); font-weight: 600; }

/* Guarantee pill (rote Variante) */
.guarantee-pill {
  display: inline-flex; align-items: center; gap: 6px;
  background: var(--red-soft); border: 1px solid var(--red-line);
  color: #b91c1c; font-size: .77rem; font-weight: 700;
  padding: 5px 14px; border-radius: 6px; margin: 12px 0 22px;
  letter-spacing: .01em;
}

/* Google Bewertungen */
.google-row {
  display: flex; align-items: center; justify-content: center; gap: 10px;
  margin-bottom: 36px;
}
.google-stars { color: #f59e0b; letter-spacing: 2px; font-size: .95rem; }
.google-text { font-size: .78rem; color: var(--gray); }
.google-text strong { color: var(--ink); }

/* ═══════════════════════════════════════════════
   FORM CARD
═══════════════════════════════════════════════ */
.form-card {
  background: var(--white);
  border: 1px solid var(--card-line);
  border-radius: 20px;
  box-shadow: 0 4px 12px rgba(0,0,0,.05), 0 24px 64px rgba(0,0,0,.09);
  padding: 36px 32px;
  max-width: 480px;
  margin: 0 auto;
  text-align: left;
}
.form-progress {
  display: flex; gap: 6px; margin-bottom: 28px;
}
.form-progress-dot {
  flex: 1; height: 3px; border-radius: 3px;
  background: var(--card-line); transition: background .3s;
}
.form-progress-dot.active { background: var(--accent); }
.form-progress-dot.done   { background: rgba(34,197,94,.45); }

.f-step { display: none; }
.f-step.visible { display: block; }

.f-question {
  font-size: 1.2rem; font-weight: 700; letter-spacing: -.02em;
  color: var(--ink); margin-bottom: 16px; line-height: 1.3;
}
.f-input {
  width: 100%;
  background: var(--bg);
  border: 1.5px solid var(--card-line);
  border-radius: 10px;
  color: var(--ink);
  font-family: var(--f-sans);
  font-size: 1.05rem;
  padding: 14px 16px;
  outline: none;
  transition: border-color .2s, box-shadow .2s;
  appearance: none;
}
.f-input::placeholder { color: #c4cad3; }
.f-input:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(34,197,94,.15);
}
.f-input.error { border-color: var(--red); }
.f-hint {
  font-size: .74rem; color: var(--gray-light); margin-top: 7px;
}
.f-err {
  font-size: .75rem; color: var(--red);
  margin-top: 6px; display: none;
}
.f-err.show { display: block; }

.f-next-btn {
  display: block; width: 100%; margin-top: 14px;
  background: var(--accent); color: #fff;
  font-family: var(--f-sans); font-weight: 600; font-size: 1rem;
  padding: 15px; border-radius: 10px; border: none; cursor: pointer;
  letter-spacing: -.01em;
  box-shadow: rgba(255,255,255,.12) 0 0 0 3px inset;
  transition: background .2s, transform .25s, box-shadow .25s;
}
.f-next-btn:hover {
  background: var(--accent-deep);
  transform: translateY(-2px);
  box-shadow: rgba(255,255,255,.12) 0 0 0 3px inset,
              rgba(34,197,94,.3) 0 8px 24px;
}
.f-next-btn:disabled { opacity: .5; cursor: not-allowed; transform: none; box-shadow: none; }

.f-newsletter-row {
  display: flex; gap: 10px; align-items: flex-start; margin-top: 14px;
}
.f-newsletter-row input[type="checkbox"] {
  width: 16px; height: 16px; margin-top: 2px; flex-shrink: 0;
  cursor: pointer; accent-color: var(--accent);
}
.f-newsletter-row label {
  font-size: .73rem; color: var(--gray); line-height: 1.5; cursor: pointer;
}
.f-newsletter-row label a { color: var(--accent-deep); text-decoration: underline; }

/* Thank You state */
.f-thankyou { display: none; text-align: center; padding: 12px 0; }
.f-thankyou.visible { display: block; }
.f-ty-icon { font-size: 2.8rem; margin-bottom: 12px; }
.f-ty-h { font-size: 1.25rem; font-weight: 800; letter-spacing: -.02em; margin-bottom: 8px; }
.f-ty-p { font-size: .93rem; color: var(--gray); line-height: 1.6; max-width: 320px; margin: 0 auto; }
.f-ty-p .hl { color: var(--accent-deep); font-weight: 600; }
.f-ty-divider { border: none; border-top: 1px solid var(--card-line); margin: 22px 0; }
.f-ty-profile {
  display: flex; align-items: center; gap: 14px;
  background: #f9fafb; border: 1px solid var(--card-line);
  border-radius: 12px; padding: 14px 16px; text-align: left; margin-bottom: 20px;
}
.f-ty-avatar {
  width: 52px; height: 52px; border-radius: 50%; flex-shrink: 0;
  background: var(--accent-soft); display: flex; align-items: center; justify-content: center;
  font-size: 1.4rem; overflow: hidden;
}
.f-ty-avatar img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
.f-ty-name { font-size: .88rem; font-weight: 700; color: var(--ink); }
.f-ty-role { font-size: .75rem; color: var(--gray); margin-bottom: 4px; }
.f-ty-quote { font-size: .8rem; color: var(--ink); line-height: 1.5; font-style: italic; }
.f-ty-cal-label { font-size: .8rem; color: var(--gray); text-align: center; margin-bottom: 12px; }
.f-ty-cal-label strong { display: block; font-size: .93rem; color: var(--ink); margin-top: 2px; }

/* ═══════════════════════════════════════════════
   CALENDAR SECTION — 3D Mockup
═══════════════════════════════════════════════ */
.cal-section {
  padding: 40px 0 90px;
  position: relative; overflow: hidden;
}
/* dezenter grüner Glow hinter dem Kalender */
.cal-section::before {
  content: ''; position: absolute;
  top: 50%; left: 50%; transform: translate(-50%, -50%);
  width: 700px; height: 340px;
  background: radial-gradient(ellipse, rgba(34,197,94,.07) 0%, transparent 70%);
  pointer-events: none;
}
.cal-scene {
  perspective: 1100px;
  position: relative;
  max-width: 560px; margin: 0 auto;
  padding: 0 24px 60px;
}
/* Glow-Shadow unter der Karte */
.cal-scene::after {
  content: ''; position: absolute;
  bottom: 10px; left: 50%; transform: translateX(-50%);
  width: 60%; height: 50px;
  background: rgba(34,197,94,.18);
  filter: blur(28px);
  border-radius: 50%;
  pointer-events: none;
}
.cal-card {
  background: var(--white);
  border: 1px solid rgba(0,0,0,.07);
  border-radius: 20px;
  box-shadow:
    0 2px 4px rgba(0,0,0,.04),
    0 8px 24px rgba(0,0,0,.07),
    0 32px 80px rgba(0,0,0,.11);
  overflow: hidden;
  transform: perspective(1100px) rotateX(9deg) rotateY(-4deg) scale(.97);
  transition: transform .5s cubic-bezier(.16,1,.3,1);
}
.cal-card:hover {
  transform: perspective(1100px) rotateX(4deg) rotateY(-1deg) scale(.99);
}
.cal-top {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18px 20px 14px;
  border-bottom: 1px solid var(--card-line);
}
.cal-live-badge {
  display: flex; align-items: center; gap: 7px;
  font-size: .72rem; font-weight: 700; letter-spacing: .04em;
  text-transform: uppercase; color: var(--accent-deep);
}
.cal-title-block h3 {
  font-size: .93rem; font-weight: 700; color: var(--ink); line-height: 1.2;
}
.cal-title-block p { font-size: .72rem; color: var(--gray); }
.cal-avatar {
  width: 32px; height: 32px; border-radius: 50%;
  background: linear-gradient(135deg, var(--accent), var(--accent-deep));
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: .75rem; font-weight: 700;
}
.cal-body { padding: 16px 20px; }
.cal-month-row {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 12px;
}
.cal-month-label { font-size: .88rem; font-weight: 700; color: var(--ink); }
.cal-nav-btns { display: flex; gap: 6px; }
.cal-nav-btn {
  width: 26px; height: 26px; border: 1px solid var(--card-line);
  border-radius: 6px; background: none; cursor: pointer; font-size: .85rem;
  display: flex; align-items: center; justify-content: center; color: var(--gray);
  transition: background .15s;
}
.cal-nav-btn:hover { background: var(--accent-soft); color: var(--accent-deep); }
.cal-weekdays {
  display: grid; grid-template-columns: repeat(7, 1fr);
  text-align: center; margin-bottom: 8px;
}
.cal-weekdays span { font-size: .66rem; font-weight: 600; color: var(--gray-light); padding: 2px 0; }
.cal-days {
  display: grid; grid-template-columns: repeat(7, 1fr);
  gap: 2px; text-align: center;
}
.cal-days span {
  width: 100%; padding: 6px 0;
  font-size: .78rem; border-radius: 7px; color: var(--ink);
  cursor: default;
}
.cal-days .avail { color: var(--accent-deep); font-weight: 600; cursor: pointer; }
.cal-days .avail:hover { background: var(--accent-soft); }
.cal-days .selected { background: var(--accent); color: #fff; font-weight: 700; }
.cal-days .today { font-weight: 700; color: var(--ink); border: 1.5px solid var(--accent); }
.cal-days .dimmed { color: var(--card-line); }
.cal-times {
  margin-top: 14px; border-top: 1px solid var(--card-line); padding-top: 12px;
}
.cal-times-label { font-size: .72rem; font-weight: 600; color: var(--gray); margin-bottom: 8px; }
.cal-slots { display: flex; gap: 7px; flex-wrap: wrap; }
.cal-slot {
  padding: 5px 12px; border-radius: 7px;
  border: 1px solid var(--card-line); font-size: .77rem;
  background: none; cursor: pointer; color: var(--ink);
  transition: all .15s;
}
.cal-slot:hover { border-color: var(--accent); color: var(--accent-deep); }
.cal-slot.sel { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 600; }
.cal-footer {
  padding: 14px 20px 18px;
  border-top: 1px solid var(--card-line);
}
.cal-book-btn {
  display: block; width: 100%;
  background: var(--ink); color: #fff;
  font-family: var(--f-sans); font-size: .9rem; font-weight: 600;
  padding: 12px; border-radius: 10px; border: none; cursor: pointer;
  box-shadow: rgba(255,255,255,.10) 0 0 0 3px inset;
  transition: background .2s, transform .2s;
}
.cal-book-btn:hover { background: #222; transform: translateY(-1px); }

/* Floating badges auf dem Kalender */
.cal-float {
  position: absolute;
  background: rgba(255,255,255,.94);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(0,0,0,.06);
  border-radius: 14px;
  box-shadow: 0 4px 20px rgba(0,0,0,.10);
  padding: 10px 14px;
  display: flex; align-items: center; gap: 10px;
  font-size: .76rem;
  white-space: nowrap;
}
.cal-float strong { display: block; font-size: .78rem; font-weight: 700; color: var(--ink); }
.cal-float span   { color: var(--gray); font-size: .71rem; }
.cal-float-icon {
  width: 32px; height: 32px; border-radius: 8px;
  background: var(--accent-soft);
  display: flex; align-items: center; justify-content: center;
  font-size: .95rem; flex-shrink: 0;
}
.cf-confirmed { top: -10px; right: -28px; animation: floatA 3.2s ease-in-out infinite; }
.cf-revenue   { bottom: 60px; left: -32px; animation: floatB 4s ease-in-out infinite; }
.cf-lead      { bottom: -8px; right: 24px; animation: floatA 3.8s ease-in-out 1s infinite; }
@keyframes floatA { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-7px)} }
@keyframes floatB { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-5px)} }
@media (max-width: 600px) { .cal-float { display: none; } }
@media (prefers-reduced-motion: reduce) {
  .cal-float { animation: none; }
}

/* ═══════════════════════════════════════════════
   PAIN SECTION
═══════════════════════════════════════════════ */
.section { padding: 80px 0; }
.section-head { text-align: center; max-width: 600px; margin: 0 auto 52px; }
.section-head h2 {
  font-family: var(--f-sans); font-weight: 800;
  font-size: clamp(1.7rem, 3.5vw, 2.4rem);
  letter-spacing: -.025em; line-height: 1.15; margin-bottom: 12px;
}
.section-head h2 em {
  font-family: var(--f-serif); font-style: italic;
  font-weight: 500; color: var(--accent);
}
.section-head p { color: var(--gray); font-size: 1rem; line-height: 1.65; }

.cards3 { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; }
@media (max-width: 800px) { .cards3 { grid-template-columns: 1fr; } }

/* Mockup-Karten — kein Schatten, nur Border wie Referenz */
.card-m {
  background: var(--white);
  border: 1px solid var(--card-line);
  border-radius: var(--radius-card);
  overflow: hidden;
}
.card-m .c-icon-bg {
  height: 160px; padding: 24px;
  background: linear-gradient(180deg, #f4f8f5 0%, #e8f2ea 45%, #ffffff 100%);
  display: flex; align-items: center; justify-content: center;
}
.card-m .c-body { padding: 22px 24px 26px; }
.card-m h3 {
  font-family: var(--f-serif); font-weight: 400; font-size: 1.2rem;
  letter-spacing: -.01em; color: var(--ink); margin-bottom: 8px;
}
.card-m p { font-size: .92rem; line-height: 1.6; color: var(--gray); }

/* SVG animation — same as reference */
.mi { opacity: 0; transform: translateY(6px); transform-box: fill-box; transform-origin: center; }
.card-m.reveal.is-visible .mi { animation: mi-in .6s cubic-bezier(.16,1,.3,1) forwards; }
.card-m.reveal.is-visible .mi.d1 { animation-delay: .1s; }
.card-m.reveal.is-visible .mi.d2 { animation-delay: .25s; }
.card-m.reveal.is-visible .mi.d3 { animation-delay: .4s; }
.card-m.reveal.is-visible .mi.d4 { animation-delay: .55s; }
@keyframes mi-in { to { opacity: 1; transform: none; } }
.mi-breathe { transform-box: fill-box; transform-origin: center; }
.card-m.reveal.is-visible .mi-breathe {
