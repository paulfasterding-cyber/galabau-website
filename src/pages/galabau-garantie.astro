---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="3 GaLaBau-Aufträge in 30 Tagen — Garantiert | Fastra One"
  description="Wir garantieren dir 3 qualifizierte Auftragsanfragen in 30 Tagen — oder du zahlst nichts. Exklusiv für GaLaBau-Betriebe."
  navVariant="none"
  footerVariant="none"
>

<Fragment slot="head">
  <meta name="robots" content="noindex, nofollow" />
  <style is:global>

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg:          #ffffff;
  --bg-alt:      #f4faf6;
  --bg-card:     #f8fbf9;
  --ink:         #0c1a10;
  --ink-2:       #4d6655;
  --green:       #2bcf78;
  --green-hover: #1fa85f;
  --green-deep:  #0b2b15;
  --red:         #dc2626;
  --border:      #dceee3;
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
}

body { background: var(--bg); color: var(--ink); line-height: 1.6; }

.g-container { max-width: 680px; margin: 0 auto; padding: 0 20px; }

/* ── URGENCY BAR ─────────────────────────────────────────── */
.g-topbar {
  background: var(--red);
  color: #fff;
  text-align: center;
  padding: 10px 20px;
  font-size: .82rem;
  font-weight: 700;
  letter-spacing: .02em;
  position: sticky;
  top: 0;
  z-index: 100;
}

/* ── HERO ────────────────────────────────────────────────── */
.g-hero {
  padding: 68px 0 56px;
  text-align: center;
}

.g-quote-hook {
  font-size: clamp(1.1rem, 2.5vw, 1.35rem);
  font-weight: 400;
  color: var(--ink-2);
  font-style: italic;
  margin-bottom: 20px;
  line-height: 1.5;
}
.g-quote-hook strong { color: var(--ink); font-style: normal; font-weight: 700; }

.g-pill {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  background: rgba(43,207,120,.1);
  border: 1px solid rgba(43,207,120,.3);
  color: var(--green-hover);
  font-size: .73rem;
  font-weight: 700;
  letter-spacing: .07em;
  text-transform: uppercase;
  padding: 6px 14px;
  border-radius: 99px;
  margin-bottom: 22px;
}
.g-pill-dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--green);
  animation: pulse 2s infinite;
}
@keyframes pulse {
  0%,100% { opacity:1; transform:scale(1); }
  50%      { opacity:.5; transform:scale(.75); }
}

.g-h1 {
  font-size: clamp(2.4rem, 6.5vw, 4rem);
  font-weight: 900;
  line-height: 1.04;
  letter-spacing: -.035em;
  color: var(--ink);
  margin-bottom: 6px;
}
.g-h1 .accent { color: var(--green-hover); }

.g-h1-sub {
  font-size: clamp(1.1rem, 2.5vw, 1.4rem);
  font-weight: 300;
  color: var(--ink-2);
  letter-spacing: -.01em;
  margin-bottom: 20px;
}

.g-guarantee-pill {
  display: inline-block;
  background: #fff4f4;
  border: 1.5px solid #fca5a5;
  color: #b91c1c;
  font-size: .8rem;
  font-weight: 700;
  padding: 7px 16px;
  border-radius: 6px;
  margin-bottom: 32px;
  letter-spacing: .01em;
}

.g-hero-cta {
  display: inline-block;
  background: var(--green);
  color: #fff;
  font-weight: 800;
  font-size: 1.05rem;
  padding: 18px 38px;
  border-radius: 8px;
  border: none;
  cursor: pointer;
  transition: background .15s, transform .15s, box-shadow .15s;
  text-decoration: none;
  letter-spacing: .01em;
}
.g-hero-cta:hover {
  background: var(--green-hover);
  transform: translateY(-2px);
  box-shadow: 0 12px 36px rgba(43,207,120,.28);
}

.g-trust-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20px;
  margin-top: 18px;
  font-size: .77rem;
  color: var(--ink-2);
  flex-wrap: wrap;
}
.g-trust-row span { display: flex; align-items: center; gap: 5px; }
.tick { color: var(--green-hover); font-weight: 800; }

/* Social proof bubbles */
.g-notif-row {
  display: flex;
  justify-content: center;
  gap: 10px;
  margin-top: 40px;
  flex-wrap: wrap;
}
.g-notif {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 10px 14px;
  display: flex;
  align-items: center;
  gap: 10px;
  box-shadow: 0 2px 14px rgba(0,0,0,.07);
  text-align: left;
}
.g-notif-icon {
  width: 34px; height: 34px;
  border-radius: 8px;
  background: rgba(43,207,120,.12);
  display: flex; align-items: center; justify-content: center;
  font-size: 1rem;
  flex-shrink: 0;
}
.g-notif-text strong { display: block; font-size: .77rem; font-weight: 700; color: var(--ink); }
.g-notif-text span   { font-size: .71rem; color: var(--ink-2); }

/* ── PAIN ────────────────────────────────────────────────── */
.g-pain {
  padding: 68px 0 0;
  border-top: 1px solid var(--border);
}
.g-eyebrow {
  font-size: .71rem;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--ink-2);
  margin-bottom: 10px;
}
.g-h2 {
  font-size: clamp(1.5rem, 3.5vw, 2.1rem);
  font-weight: 800;
  letter-spacing: -.025em;
  line-height: 1.2;
  margin-bottom: 28px;
  color: var(--ink);
}
.g-pain-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding-bottom: 68px;
}
.g-pain-list li {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 16px 18px;
  display: flex;
  gap: 12px;
  align-items: flex-start;
  font-size: .97rem;
  color: var(--ink);
  line-height: 1.55;
}
.g-pain-list .icon { font-size: 1.1rem; flex-shrink: 0; margin-top: 1px; }

/* ── AGITATE ─────────────────────────────────────────────── */
.g-agitate {
  padding: 0 0 68px;
}
.g-agitate-box {
  background: #fff5f5;
  border: 1.5px solid #fca5a5;
  border-radius: 12px;
  padding: 26px 24px;
}
.g-agitate-box p {
  font-size: 1rem;
  line-height: 1.7;
  color: var(--ink);
}

/* ── SOLUTION ────────────────────────────────────────────── */
.g-solution {
  padding: 68px 0;
  border-top: 1px solid var(--border);
}
.g-stack {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 24px;
}
.g-stack-item {
  display: flex;
  gap: 14px;
  align-items: center;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 14px 18px;
}
.g-stack-item .si-icon { font-size: 1.2rem; flex-shrink: 0; }
.g-stack-item strong { display: block; font-size: .93rem; font-weight: 700; color: var(--ink); }
.g-stack-item span { font-size: .82rem; color: var(--ink-2); line-height: 1.4; }

/* ── GUARANTEE ───────────────────────────────────────────── */
.g-guarantee-section {
  background: var(--green-deep);
  padding: 68px 0;
}
.g-guarantee-box { text-align: center; color: #fff; }
.g-guarantee-icon { font-size: 2.8rem; margin-bottom: 14px; }
.g-guarantee-title {
  font-size: clamp(1.5rem, 3.5vw, 2.2rem);
  font-weight: 900;
  letter-spacing: -.025em;
  line-height: 1.15;
  margin-bottom: 14px;
}
.g-guarantee-title .accent-g { color: var(--green); }
.g-guarantee-body {
  font-size: .97rem;
  color: rgba(255,255,255,.65);
  max-width: 460px;
  margin: 0 auto;
  line-height: 1.65;
}
.g-guarantee-cta {
  display: inline-block;
  margin-top: 28px;
  background: var(--green);
  color: #fff;
  font-weight: 800;
  font-size: .98rem;
  padding: 15px 32px;
  border-radius: 8px;
  border: none;
  cursor: pointer;
  text-decoration: none;
  transition: background .15s;
}
.g-guarantee-cta:hover { background: var(--green-hover); }

/* ── FUNNEL ──────────────────────────────────────────────── */
.g-funnel {
  padding: 72px 0 80px;
  border-top: 1px solid var(--border);
}
.g-funnel-wrap {
  max-width: 520px;
  margin: 0 auto;
  padding: 0 20px;
}
.g-funnel-head {
  text-align: center;
  margin-bottom: 36px;
}
.g-funnel-head .f-eyebrow {
  font-size: .71rem;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--green-hover);
  margin-bottom: 8px;
}
.g-funnel-head .f-title {
  font-size: clamp(1.3rem, 3vw, 1.75rem);
  font-weight: 800;
  letter-spacing: -.025em;
  color: var(--ink);
}
.g-funnel-head .f-sub {
  font-size: .86rem;
  color: var(--ink-2);
  margin-top: 6px;
}

/* Progress */
.g-progress {
  display: flex;
  gap: 6px;
  margin-bottom: 32px;
}
.g-progress-dot {
  flex: 1; height: 4px;
  border-radius: 4px;
  background: var(--border);
  transition: background .3s;
}
.g-progress-dot.active { background: var(--green); }
.g-progress-dot.done   { background: rgba(43,207,120,.45); }

/* Steps */
.g-step { display: none; }
.g-step.visible { display: block; }

.g-field-label {
  display: block;
  font-size: .77rem;
  font-weight: 700;
  letter-spacing: .07em;
  text-transform: uppercase;
  color: var(--ink-2);
  margin-bottom: 10px;
}
.g-input {
  width: 100%;
  background: #fff;
  border: 1.5px solid var(--border);
  border-radius: 8px;
  color: var(--ink);
  font-size: 1.1rem;
  padding: 15px 16px;
  outline: none;
  transition: border-color .2s;
  font-family: inherit;
  appearance: none;
}
.g-input::placeholder { color: #b0bdb6; }
.g-input:focus { border-color: var(--green); }
.g-input.error { border-color: var(--red); }

.g-hint {
  font-size: .74rem;
  color: var(--ink-2);
  margin-top: 7px;
}

.g-checkbox-row {
  display: flex;
  gap: 10px;
  align-items: flex-start;
  margin-top: 14px;
}
.g-checkbox-row input[type="checkbox"] {
  width: 17px; height: 17px;
  margin-top: 2px; flex-shrink: 0;
  cursor: pointer;
  accent-color: var(--green);
}
.g-checkbox-row label {
  font-size: .75rem;
  color: var(--ink-2);
  line-height: 1.5;
  cursor: pointer;
}
.g-checkbox-row label a { color: var(--green-hover); text-decoration: underline; }

.g-next-btn {
  display: block;
  width: 100%;
  margin-top: 16px;
  background: var(--green);
  color: #fff;
  font-weight: 800;
  font-size: 1.05rem;
  padding: 17px;
  border-radius: 8px;
  border: none;
  cursor: pointer;
  transition: background .15s, transform .15s, box-shadow .15s;
  font-family: inherit;
  letter-spacing: .01em;
}
.g-next-btn:hover { background: var(--green-hover); transform: translateY(-2px); box-shadow: 0 10px 28px rgba(43,207,120,.25); }
.g-next-btn:disabled { opacity:.5; cursor:not-allowed; transform:none; box-shadow:none; }

.g-err-msg { color: var(--red); font-size: .76rem; margin-top: 6px; display: none; }
.g-err-msg.show { display: block; }

/* ── THANK YOU ───────────────────────────────────────────── */
.g-thankyou { display: none; }
.g-thankyou.visible { display: block; }

.g-ty-head { text-align: center; padding: 10px 0 32px; }
.ty-icon { font-size: 3rem; margin-bottom: 14px; }
.g-ty-head h2 {
  font-size: clamp(1.4rem, 3vw, 1.9rem);
  font-weight: 900;
  letter-spacing: -.025em;
  color: var(--ink);
  margin-bottom: 12px;
}
.g-ty-head p { font-size: .97rem; color: var(--ink-2); max-width: 400px; margin: 0 auto; line-height: 1.65; }
.g-ty-head .g-highlight { color: var(--green-hover); font-weight: 700; }

.g-ty-divider { border: none; border-top: 1px solid var(--border); margin: 28px 0; }

.g-ty-cal-head { text-align: center; margin-bottom: 16px; }
.g-ty-cal-head p { font-size: .84rem; color: var(--ink-2); }
.g-ty-cal-head strong { display: block; font-size: 1rem; font-weight: 700; color: var(--ink); margin-top: 4px; }

/* ── FOOTER TRANSITION + FOOTER ──────────────────────────── */
.g-footer-transition {
  height: 80px;
  background: linear-gradient(to bottom, #ffffff 0%, var(--green-deep) 100%);
}
.g-footer {
  background: var(--green-deep);
  padding: 32px 20px;
  text-align: center;
  font-size: .75rem;
  color: rgba(255,255,255,.4);
}
.g-footer a { color: rgba(255,255,255,.55); text-decoration: underline; }

@media (max-width: 600px) {
  .g-notif-row { flex-direction: column; align-items: center; }
}

  </style>
</Fragment>


<!-- ─── URGENCY BAR ─────────────────────────────────────────── -->
<div class="g-topbar">
  Nur noch <strong>1 freier Platz</strong> in deiner Region — danach ist es zu spät
</div>


<!-- ─── HERO ───────────────────────────────────────────────── -->
<section class="g-hero">
  <div class="g-container">

    <div class="g-pill">
      <span class="g-pill-dot"></span>
      Exklusiv für GaLaBau-Betriebe
    </div>

    <p class="g-quote-hook">
      "Ich bin der Beste in meiner Stadt —<br>
      <strong>aber kein Mensch weiß das."</strong>
    </p>

    <h1 class="g-h1">
      Wir ändern das.<br>
      <span class="accent">In 30 Tagen.</span>
    </h1>

    <div class="g-guarantee-pill">3 garantierte Auftragsanfragen — oder kein Cent.</div>

    <p style="font-size:1.02rem;color:var(--ink-2);max-width:480px;margin:0 auto 32px;line-height:1.65;">
      Kein Marketing-Aufwand. Kein Technik-Stress.<br>
      <strong style="color:var(--ink);">Du baust — wir füllen deinen Kalender.</strong>
    </p>

    <button class="g-hero-cta" onclick="scrollToFunnel()">
      Jetzt kostenlos anfragen →
    </button>

    <div class="g-trust-row">
      <span><span class="tick">✓</span> Kostenlos & unverbindlich</span>
      <span><span class="tick">✓</span> Antwort in 24h</span>
      <span><span class="tick">✓</span> 1 Betrieb pro Region</span>
    </div>

    <!-- Social proof bubbles -->
    <div class="g-notif-row">
      <div class="g-notif">
        <div class="g-notif-icon">📩</div>
        <div class="g-notif-text">
          <strong>Neue Anfrage eingegangen</strong>
          <span>Gerade eben · Hannover</span>
        </div>
      </div>
      <div class="g-notif">
        <div class="g-notif-icon">✅</div>
        <div class="g-notif-text">
          <strong>3 Aufträge in 27 Tagen</strong>
          <span>GaLaBau-Betrieb · Hamburg</span>
        </div>
      </div>
    </div>

  </div>
</section>


<!-- ─── PAIN ────────────────────────────────────────────────── -->
<section class="g-pain">
  <div class="g-container">

    <p class="g-eyebrow">Das Problem</p>
    <h2 class="g-h2">Kommt dir das bekannt vor?</h2>

    <ul class="g-pain-list">
      <li>
        <span class="icon">📞</span>
        <span><strong>"Wir leben von Mundpropaganda."</strong> Klappt jahrelang. Bis es plötzlich nicht mehr klappt. Und du nicht weißt, wann das nächste Telefon klingelt.</span>
      </li>
      <li>
        <span class="icon">❄️</span>
        <span>Oktober, November, Dezember: Stille. Mitarbeiter wollen beschäftigt werden, Fixkosten laufen weiter. Du zahlst aus der Substanz — und kämpfst um jeden Auftrag.</span>
      </li>
      <li>
        <span class="icon">🌐</span>
        <span>Dein Konkurrent findet sich online — du nicht. Er kassiert die Anfragen. Nicht weil er besser ist. Sondern weil er sichtbar ist und du noch nicht.</span>
      </li>
    </ul>

  </div>
</section>


<!-- ─── AGITATE ─────────────────────────────────────────────── -->
<section class="g-agitate">
  <div class="g-container">
    <div class="g-agitate-box">
      <p>
        Während du das liest, weiß dein Konkurrent schon, was er in 6 Wochen baut.
        Sein Kalender ist voll — auch im Winter. Er muss keine Aufträge mehr jagen.
        <strong>Der Unterschied zu dir? Er hat ein System. Du noch nicht.</strong>
      </p>
    </div>
  </div>
</section>


<!-- ─── SOLUTION ────────────────────────────────────────────── -->
<section class="g-solution">
  <div class="g-container">

    <p class="g-eyebrow">Die Lösung</p>
    <h2 class="g-h2">Wir bauen dein Auftragssystem — komplett.</h2>

    <div class="g-stack">
      <div class="g-stack-item">
        <span class="si-icon">🌐</span>
        <div>
          <strong>Webseite die Anfragen bringt</strong>
          <span>Speziell für GaLaBau-Betriebe gebaut — kein Standard-Template.</span>
        </div>
      </div>
      <div class="g-stack-item">
        <span class="si-icon">📢</span>
        <div>
          <strong>Google Ads in deiner Region</strong>
          <span>Wir schalten und optimieren. Du bekommst die Anfragen.</span>
        </div>
      </div>
      <div class="g-stack-item">
        <span class="si-icon">📊</span>
        <div>
          <strong>Live-Dashboard mit deinen Anfragen</strong>
          <span>Name, Nummer, Projekt — sofort auf dein Handy.</span>
        </div>
      </div>
      <div class="g-stack-item">
        <span class="si-icon">🔒</span>
        <div>
          <strong>Exklusivität in deiner Region</strong>
          <span>Nur 1 GaLaBauer pro Region. Dein Wettbewerber bleibt draußen.</span>
        </div>
      </div>
    </div>

  </div>
</section>


<!-- ─── GUARANTEE ───────────────────────────────────────────── -->
<section class="g-guarantee-section">
  <div class="g-container">
    <div class="g-guarantee-box">
      <div class="g-guarantee-icon">🛡️</div>
      <h2 class="g-guarantee-title">
        <span class="accent-g">3 Aufträge in 30 Tagen</span><br>
        — oder du zahlst nichts.
      </h2>
      <p class="g-guarantee-body">
        Wenn du nach 30 Tagen keine 3 qualifizierten Auftragsanfragen hast,
        zahlst du uns keinen Cent. Das Risiko liegt komplett bei uns — nicht bei dir.
      </p>
      <button class="g-guarantee-cta" onclick="scrollToFunnel()">
        Jetzt Platz sichern →
      </button>
    </div>
  </div>
</section>


<!-- ─── MULTI-STEP FUNNEL ───────────────────────────────────── -->
<section class="g-funnel" id="funnel">
  <div class="g-funnel-wrap">

    <div class="g-funnel-head">
      <p class="f-eyebrow">Kostenlos & unverbindlich anfragen</p>
      <h2 class="f-title">Sichere dir deinen Platz</h2>
      <p class="f-sub">Nur noch 1 Platz in deiner Region — dauert 30 Sekunden</p>
    </div>

    <!-- FORM AREA -->
    <div id="gFormArea">
      <div class="g-progress" id="gProgress">
        <div class="g-progress-dot active" id="dot-0"></div>
        <div class="g-progress-dot" id="dot-1"></div>
        <div class="g-progress-dot" id="dot-2"></div>
        <div class="g-progress-dot" id="dot-3"></div>
      </div>

      <!-- STEP 0 — Vorname -->
      <div class="g-step visible" id="step-0">
        <label class="g-field-label" for="g-vorname">Wie ist dein Vorname?</label>
        <input class="g-input" id="g-vorname" type="text" placeholder="z.B. Thomas" autocomplete="given-name" />
        <p class="g-err-msg" id="err-0">Bitte gib deinen Vornamen ein.</p>
        <button class="g-next-btn" onclick="nextStep(0)">Weiter →</button>
      </div>

      <!-- STEP 1 — Nachname -->
      <div class="g-step" id="step-1">
        <label class="g-field-label" for="g-nachname">Und dein Nachname?</label>
        <input class="g-input" id="g-nachname" type="text" placeholder="z.B. Müller" autocomplete="family-name" />
        <p class="g-err-msg" id="err-1">Bitte gib deinen Nachnamen ein.</p>
        <button class="g-next-btn" onclick="nextStep(1)">Weiter →</button>
      </div>

      <!-- STEP 2 — Handynummer -->
      <div class="g-step" id="step-2">
        <label class="g-field-label" for="g-phone">Deine Handynummer?</label>
        <input class="g-input" id="g-phone" type="tel" placeholder="z.B. 0162 1234567" autocomplete="tel" />
        <p class="g-err-msg" id="err-2">Bitte gib eine gültige Nummer ein.</p>
        <p class="g-hint">Wir rufen dich an — kein Spam, versprochen.</p>
        <button class="g-next-btn" onclick="nextStep(2)">Weiter →</button>
      </div>

      <!-- STEP 3 — E-Mail -->
      <div class="g-step" id="step-3">
        <label class="g-field-label" for="g-email">Deine E-Mail-Adresse?</label>
        <input class="g-input" id="g-email" type="email" placeholder="z.B. thomas@musterbau.de" autocomplete="email" />
        <p class="g-err-msg" id="err-3">Bitte gib eine gültige E-Mail-Adresse ein.</p>

        <!-- Newsletter-Checkbox — DSGVO-konformes Opt-in -->
        <div class="g-checkbox-row">
          <input type="checkbox" id="g-newsletter" />
          <label for="g-newsletter">
