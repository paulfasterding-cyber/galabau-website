<script>
  /* UTM */
  var _sp=new URLSearchParams(window.location.search);
  var _utm={
    utm_source:_sp.get('utm_source')||undefined,utm_medium:_sp.get('utm_medium')||undefined,
    utm_campaign:_sp.get('utm_campaign')||undefined,utm_term:_sp.get('utm_term')||undefined,
    utm_content:_sp.get('utm_content')||undefined,referrer:document.referrer||undefined,
    geraet:window.innerWidth<768?'mobil':'desktop',
  };

  /* State */
  var TOTAL=8, _cur=1;
  var _d={betrieb:'',region:'',anfragen:'',website_exists:'',ads_exp:'',zeitpunkt_wunsch:'',budget:''};

  function openQuiz(){document.getElementById('quizOverlay').classList.add('open');document.body.style.overflow='hidden';}
  function closeQuiz(){document.getElementById('quizOverlay').classList.remove('open');document.body.style.overflow='';}
  document.addEventListener('keydown',function(e){if(e.key==='Escape')closeQuiz();});

  function pick(btn,s){
    btn.closest('.qchoices').querySelectorAll('.qchoice').forEach(function(c){c.classList.remove('sel');});
    btn.classList.add('sel');
    var n=document.getElementById('qn'+s);
    if(n)n.classList.add('rdy');
  }
  function gv(s){var el=document.querySelector('#qc'+s+' .qchoice.sel');return el?el.dataset.val:'';}

  function sp(n){
    document.querySelectorAll('.qstep').forEach(function(s){s.classList.remove('act');});
    var el=document.getElementById('qs'+n);
    if(el){el.classList.remove('act');void el.offsetWidth;el.classList.add('act');}
    document.getElementById('qPF').style.width=Math.round((n/TOTAL)*100)+'%';
    document.getElementById('qPL').textContent='Schritt '+n+' von '+TOTAL;
    _cur=n;
    document.querySelector('.qcard').scrollTop=0;
  }

  function nx(s){
    var v=gv(s);
    if(s===1)_d.betrieb=v;
    if(s===2)_d.region=v;
    if(s===3)_d.anfragen=v;
    if(s===4)_d.website_exists=v;
    if(s===5)_d.ads_exp=v;
    if(s===6)_d.zeitpunkt_wunsch=v;
    if(s===7)_d.budget=v;
    sp(s+1);
  }
  function pv(s){if(s>1)sp(s-1);}

  function buildMsg(){
    return [
      'Betrieb: '+_d.betrieb,
      'Region: '+_d.region,
      'Anfragen/Monat: '+_d.anfragen,
      'Website: '+_d.website_exists,
      'Google Ads Erfahrung: '+_d.ads_exp,
      'Starttermin: '+_d.zeitpunkt_wunsch,
      _d.budget?'Budget: '+_d.budget:'',
    ].filter(Boolean).join(' | ');
  }

  function send(){
    var vn=document.getElementById('fvn').value.trim();
    var nn=document.getElementById('fnn').value.trim();
    var tel=document.getElementById('ftel').value.trim();
    var mail=document.getElementById('fmail').value.trim();
    var priv=document.getElementById('fpriv').checked;
    if(!vn){alert('Bitte Vorname angeben.');return;}
    if(!nn){alert('Bitte Nachname angeben.');return;}
    if(!tel){alert('Bitte Telefonnummer angeben.');return;}
    if(!mail){alert('Bitte E-Mail angeben.');return;}
    if(!priv){alert('Bitte Datenschutzerklärung akzeptieren.');return;}
    var btn=document.getElementById('qSub');
    btn.disabled=true;btn.textContent='Wird gesendet…';
    var p=Object.assign({
      name:vn+' '+nn,email:mail,telefon:tel,
      betrieb:_d.betrieb,
      ziel:'Komplettsystem (Website + Ads + KI)',
      anfragen:_d.anfragen,
      website_exists:_d.website_exists,
      zeitpunkt_wunsch:_d.zeitpunkt_wunsch,
      budget:_d.budget||undefined,
      nachricht:buildMsg(),
      seite:'galabau-mehr-kunden',
    },_utm);
    fetch('https://fastraone-admin.vercel.app/api/leads',{
      method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(p),
    }).then(function(r){if(!r.ok)throw new Error(r.status);})
    .then(function(){
      document.querySelectorAll('.qstep').forEach(function(s){s.style.display='none';});
      document.querySelector('.qprog-wrap').style.display='none';
      document.getElementById('qSucc').classList.add('show');
    }).catch(function(){
      btn.disabled=false;btn.textContent='Gespräch anfragen →';
      alert('Fehler. Bitte ruf uns an: +49 163 3781657');
    });
  }

  function toggleFaq(btn){
    var item=btn.closest('.lp-faq-item');
    var ans=item.querySelector('.lp-faq-a');
    var open=item.classList.contains('open');
    document.querySelectorAll('.lp-faq-item').forEach(function(i){i.classList.remove('open');i.querySelector('.lp-faq-a').style.maxHeight='0';});
    if(!open){item.classList.add('open');ans.style.maxHeight=ans.scrollHeight+'px';}
  }

  /* Scroll Reveal (nutzt globales .reveal/.is-visible) */
  if(typeof IntersectionObserver!=='undefined'){
    var ro=new IntersectionObserver(function(en){en.forEach(function(e){if(e.isIntersecting){e.target.classList.add('is-visible');ro.unobserve(e.target);}});},{threshold:.07});
    document.querySelectorAll('.reveal').forEach(function(el){ro.observe(el);});
  }else{document.querySelectorAll('.reveal').forEach(function(el){el.classList.add('is-visible');});}
</script>
</BaseLayout>
