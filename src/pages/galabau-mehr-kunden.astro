---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Mehr GaLaBau-Aufträge in 14 Tagen | Fastra One"
  description="Das vollständige Kundengewinnungssystem für Garten- und Landschaftsbauer. Website, Google Ads, Funnel — komplett eingerichtet in 14 Tagen."
  navVariant="none"
  footerVariant="none"
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

<style>
/* ── Tokens & Reset (nutzt global.css) ────────────────────── */
.lp-announce {
  background: var(--ink); color: rgba(255,255,255,.75);
  text-align: center; padding: 10px 20px;
  font-size: 13px; font-weight: 500; letter-spacing: .01em;
}
.lp-announce strong { color: var(--blue); }
.lp-announce .lp-ac { color: var(--blue); border-bottom: 1px solid rgba(110,236,157,.35); cursor: pointer; font-weight: 600; }

/* Minimal Nav */
.lp-nav {
  position: sticky; top: 0; z-index: 90;
  background: rgba(11,15,26,.92);
  backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(255,255,255,.07);
  padding: 0 22px; height: 60px;
  display: flex; align-items: center; justify-content: space-between;
}
.lp-nav img { height: 24px; filter: brightness(0) invert(1); display: block; }
.lp-nav__r { display: flex; align-items: center; gap: 14px; }
.lp-nav__tel { display: flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 600; color: rgba(255,255,255,.65); text-decoration: none; transition: color .15s; }
.lp-nav__tel:hover { color: var(--blue); }
.lp-nav__cta { padding: 9px 20px; background: var(--blue); color: #06351e; font-size: 13.5px; font-weight: 700; border-radius: 999px; border: none; cursor: pointer; font-family: inherit; transition: background .15s, transform .15s; }
.lp-nav__cta:hover { background: #8ff5b8; transform: translateY(-1px); }
@media(max-width:560px){.lp-nav__tel{display:none;}.lp-nav__cta{font-size:12.5px;padding:8px 14px;}}

/* Hero */
.lp-hero { background: #0b0f1a; position: relative; overflow: hidden; padding: 80px 0 88px; }
.lp-hero .hd-bg { opacity: .55; }
.lp-hero-glow {
  position: absolute; top: -80px; left: 50%; transform: translateX(-50%);
  width: 700px; height: 380px;
  background: radial-gradient(ellipse, rgba(110,236,157,.16) 0%, transparent 70%);
  pointer-events: none;
}
.lp-hero__in { position: relative; z-index: 1; text-align: center; }
.lp-pill {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 7px 16px; background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.1);
  border-radius: 999px; font-size: 13px; font-weight: 600; color: rgba(255,255,255,.8); margin-bottom: 28px;
}
.lp-pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--blue); animation: blink 2s ease-in-out infinite; }
@keyframes blink { 0%,100%{opacity:1}50%{opacity:.3} }
.lp-hero h1 {
  font-family: var(--f-head); font-size: clamp(36px,6.5vw,70px); font-weight: 800;
  line-height: 1.06; letter-spacing: -.033em; color: #fff;
  margin-bottom: 22px; max-width: 900px; margin-inline: auto;
}
.lp-hero h1 .acc { color: var(--blue); }
.lp-hero__sub { font-size: clamp(16px,2.2vw,19px); color: rgba(255,255,255,.52); line-height: 1.65; max-width: 550px; margin: 0 auto 36px; }
.lp-checks { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 24px; margin-bottom: 40px; }
.lp-check { display: flex; align-items: center; gap: 7px; font-size: 14px; font-weight: 500; color: rgba(255,255,255,.48); }
.lp-check svg { color: var(--blue); flex-shrink: 0; }
.lp-cta-wrap { display: flex; flex-direction: column; align-items: center; gap: 10px; }
.lp-scarcity { font-size: 12.5px; color: rgba(255,255,255,.3); }
.lp-scarcity strong { color: var(--blue); }
.lp-stats {
  display: grid; grid-template-columns: repeat(3,1fr); gap: 1px;
  background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.07);
  border-radius: 16px; overflow: hidden; margin-top: 64px;
  max-width: 540px; margin-left: auto; margin-right: auto;
}
.lp-stat { background: rgba(255,255,255,.04); padding: 22px 20px; text-align: center; }
.lp-stat-v { font-family: var(--f-head); font-size: 30px; font-weight: 800; color: #fff; letter-spacing: -.035em; }
.lp-stat-v .u { font-size: 17px; color: var(--blue); }
.lp-stat-l { font-size: 12px; color: rgba(255,255,255,.38); font-weight: 500; margin-top: 3px; }

/* Trust Bar */
.lp-trust { background: #fff; padding: 28px 0; border-bottom: 1px solid var(--line); }
.lp-trust-l { text-align: center; font-size: 11.5px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--gray); margin-bottom: 18px; }
.lp-trust-r { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 18px; }
.lp-badge {
  display: flex; align-items: center; gap: 7px; padding: 7px 15px;
  background: #f9fafb; border: 1px solid rgba(61,61,61,.1); border-radius: 999px;
  font-size: 13px; font-weight: 600; color: var(--ink-soft); white-space: nowrap;
  transition: border-color .2s, box-shadow .2s;
}
.lp-badge:hover { border-color: rgba(22,165,102,.3); box-shadow: 0 2px 8px rgba(22,165,102,.1); }
.lp-badge svg { color: var(--blue-strong); flex-shrink: 0; }

/* Sections */
.lp-s { padding: 84px 0; }
.lp-s--g { background: var(--bg); }
.lp-s--d { background: #0b0f1a; padding: 72px 0; }
.lp-lbl { font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--blue-strong); margin-bottom: 12px; }
.lp-h2 { font-family: var(--f-head); font-size: clamp(27px,4.5vw,46px); font-weight: 800; letter-spacing: -.03em; line-height: 1.1; color: var(--ink); margin-bottom: 16px; }
.lp-h2--w { color: #fff; }
.lp-sub { font-size: 17px; color: var(--gray); line-height: 1.65; max-width: 540px; margin-bottom: 52px; }
.lp-sub--w { color: rgba(255,255,255,.52); }
@media(max-width:768px){ .lp-s { padding: 60px 0; } .lp-s--d { padding: 56px 0; } }

/* Problem cards */
.lp-pg { display: grid; grid-template-columns: repeat(3,1fr); gap: 14px; }
@media(max-width:900px){.lp-pg{grid-template-columns:repeat(2,1fr)}} @media(max-width:580px){.lp-pg{grid-template-columns:1fr}}
.lp-pc {
  background: #fff; border: 1px solid rgba(61,61,61,.09); border-radius: 18px; padding: 26px 22px;
  transition: box-shadow .25s, border-color .25s, transform .25s;
}
.lp-pc:hover { box-shadow: 0 4px 20px rgba(0,0,0,.07); border-color: rgba(61,61,61,.16); transform: translateY(-3px); }
.lp-pc-ico { width: 36px; height: 36px; border-radius: 10px; background: #fff0f0; display: flex; align-items: center; justify-content: center; color: #dc2626; margin-bottom: 14px; }
.lp-pc h3 { font-family: var(--f-head); font-size: 15.5px; font-weight: 700; color: var(--ink); margin-bottom: 8px; line-height: 1.3; }
.lp-pc p { font-size: 14px; color: var(--gray); line-height: 1.65; }

/* Offer Stack */
.lp-sn {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
  color: var(--blue-strong); background: rgba(22,165,102,.1); padding: 6px 14px; border-radius: 999px; margin-bottom: 20px;
}
.lp-sg { display: grid; grid-template-columns: repeat(3,1fr); gap: 12px; margin-bottom: 36px; }
@media(max-width:900px){.lp-sg{grid-template-columns:repeat(2,1fr)}} @media(max-width:560px){.lp-sg{grid-template-columns:1fr}}
.lp-sc {
  background: var(--bg); border: 1px solid var(--line); border-radius: 16px; padding: 22px 20px;
  transition: box-shadow .25s, border-color .25s, transform .25s;
}
.lp-sc:hover { box-shadow: 0 4px 18px rgba(22,165,102,.12); border-color: rgba(22,165,102,.28); transform: translateY(-3px); }
.lp-sc-ico { width: 34px; height: 34px; border-radius: 10px; background: rgba(22,165,102,.1); display: flex; align-items: center; justify-content: center; color: var(--blue-strong); margin-bottom: 12px; }
.lp-sc h3 { font-family: var(--f-head); font-size: 14.5px; font-weight: 700; color: var(--ink); margin-bottom: 5px; }
.lp-sc p { font-size: 13px; color: var(--gray); line-height: 1.55; }
.lp-gbox {
  background: linear-gradient(135deg,#f0fdf4,#e8faf1); border: 1.5px solid rgba(22,165,102,.28);
  border-radius: 18px; padding: 28px 32px; display: flex; align-items: flex-start; gap: 20px;
}
@media(max-width:600px){.lp-gbox{flex-direction:column;padding:22px 18px;}}
.lp-gbox-ico { width: 48px; height: 48px; border-radius: 14px; background: var(--blue-strong); display: flex; align-items: center; justify-content: center; color: #fff; flex-shrink: 0; }
.lp-gbox h3 { font-family: var(--f-head); font-size: 17px; font-weight: 800; color: var(--ink); margin-bottom: 6px; }
.lp-gbox p { font-size: 14.5px; color: var(--ink-soft); line-height: 1.6; }

/* Offer CTA box (new: Angebot sichern) */
.lp-offer-box {
  background: #0b0f1a; border-radius: 24px; padding: 40px; text-align: center;
  margin-top: 40px; position: relative; overflow: hidden;
}
.lp-offer-box::before {
  content: ''; position: absolute; top: -60px; left: 50%; transform: translateX(-50%);
  width: 500px; height: 250px;
  background: radial-gradient(ellipse, rgba(110,236,157,.18) 0%, transparent 70%);
  pointer-events: none;
}
.lp-offer-box__in { position: relative; z-index: 1; }
.lp-offer-box h3 { font-family: var(--f-head); font-size: clamp(20px,3vw,28px); font-weight: 800; color: #fff; letter-spacing: -.025em; margin-bottom: 10px; }
.lp-offer-box h3 span { color: var(--blue); }
.lp-offer-box p { font-size: 15.5px; color: rgba(255,255,255,.52); line-height: 1.6; max-width: 480px; margin: 0 auto 28px; }
.lp-offer-spots { display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; background: rgba(110,236,157,.1); border: 1px solid rgba(110,236,157,.25); border-radius: 999px; font-size: 13px; font-weight: 700; color: var(--blue); margin-bottom: 24px; }
.lp-offer-spots-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--blue); animation: blink 1.5s ease-in-out infinite; }

/* Proof */
.lp-proof-g { display: grid; grid-template-columns: repeat(3,1fr); gap: 16px; }
@media(max-width:900px){.lp-proof-g{grid-template-columns:repeat(2,1fr)}} @media(max-width:580px){.lp-proof-g{grid-template-columns:1fr}}
.lp-proof-c { background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 24px 20px; position: relative; transition: box-shadow .25s, transform .25s; }
.lp-proof-c:hover { box-shadow: 0 4px 18px rgba(0,0,0,.06); transform: translateY(-2px); }
.lp-proof-tag { position: absolute; top: 14px; right: 14px; font-size: 11px; font-weight: 600; color: var(--gray-2); background: var(--bg); padding: 3px 8px; border-radius: 6px; border: 1px solid var(--line); }
.lp-proof-s { color: #f59e0b; font-size: 15px; letter-spacing: 2px; margin-bottom: 12px; }
.lp-proof-b { font-size: 14.5px; color: var(--gray); font-style: italic; line-height: 1.65; margin-bottom: 18px; min-height: 80px; background: repeating-linear-gradient(transparent,transparent 23px,rgba(61,61,61,.06) 23px,rgba(61,61,61,.06) 24px); border-radius: 4px; padding: 6px 0; }
.lp-proof-a { display: flex; align-items: center; gap: 12px; }
.lp-proof-av { width: 40px; height: 40px; border-radius: 50%; background: rgba(22,165,102,.12); display: flex; align-items: center; justify-content: center; font-family: var(--f-head); font-size: 15px; font-weight: 700; color: var(--blue-strong); flex-shrink: 0; }
.lp-proof-n { font-size: 13.5px; font-weight: 700; color: var(--ink); }
.lp-proof-l { font-size: 12.5px; color: var(--gray-2); }

/* Process */
.lp-proc { display: grid; grid-template-columns: repeat(3,1fr); gap: 0; margin-top: 52px; }
@media(max-width:768px){.lp-proc{grid-template-columns:1fr}}
.lp-ps { padding: 0 32px 40px; position: relative; }
.lp-ps+.lp-ps::before { content:''; position:absolute; left:0; top:36px; height:calc(100% - 36px); width:1px; background:var(--line); }
@media(max-width:768px){.lp-ps{padding:28px 0 0;border-bottom:1px solid var(--line);} .lp-ps:last-child{border-bottom:none;} .lp-ps+.lp-ps::before{display:none;}}
.lp-pnum { width:40px; height:40px; border-radius:12px; background:var(--ink); color:#fff; font-family:var(--f-head); font-size:15px; font-weight:800; display:flex; align-items:center; justify-content:center; margin-bottom:20px; }
.lp-pday { font-size:11.5px; font-weight:700; letter-spacing:.09em; text-transform:uppercase; color:var(--blue-strong); margin-bottom:8px; }
.lp-ps h3 { font-family:var(--f-head); font-size:18px; font-weight:700; color:var(--ink); margin-bottom:10px; }
.lp-ps p { font-size:14.5px; color:var(--gray); line-height:1.65; }

/* FAQ */
.lp-flist { margin-top:44px; max-width:720px; margin-left:auto; margin-right:auto; }
.lp-fi { background:var(--bg); border:1px solid var(--line); border-radius:14px; overflow:hidden; margin-bottom:8px; transition:box-shadow .2s; }
.lp-fi:hover { box-shadow: 0 2px 12px rgba(0,0,0,.05); }
.lp-fq { width:100%; display:flex; align-items:center; justify-content:space-between; gap:16px; padding:20px 22px; text-align:left; font-family:inherit; font-size:15.5px; font-weight:600; color:var(--ink); background:none; border:none; cursor:pointer; }
.lp-fq svg { flex-shrink:0; color:var(--gray); transition:transform .25s, color .25s; }
.lp-fi.open .lp-fq svg { transform:rotate(45deg); color:var(--blue-strong); }
.lp-fa { max-height:0; overflow:hidden; transition:max-height .32s ease; }
.lp-fai { padding:0 22px 20px; font-size:14.5px; color:var(--gray); line-height:1.7; }

/* Final CTA */
.lp-fcta { background: #0b0f1a; position: relative; overflow: hidden; padding: 96px 0; }
.lp-fcta-glow { position:absolute; top:-60px; left:50%; transform:translateX(-50%); width:600px; height:300px; background:radial-gradient(ellipse,rgba(110,236,157,.18) 0%,transparent 70%); pointer-events:none; }
.lp-fcta__in { position:relative; z-index:1; text-align:center; }
.lp-fcta h2 { font-family:var(--f-head); font-size:clamp(26px,4.5vw,50px); font-weight:800; color:#fff; letter-spacing:-.03em; line-height:1.09; margin-bottom:14px; }
.lp-fcta h2 span { color:var(--blue); }
.lp-fcta p { font-size:17px; color:rgba(255,255,255,.48); max-width:460px; margin:0 auto 36px; line-height:1.65; }
.lp-fcta-sc { margin-top:16px; font-size:12.5px; color:rgba(255,255,255,.3); }
.lp-fcta-sc strong { color:var(--blue); }
@media(max-width:768px){.lp-fcta{padding:68px 0;}}

/* Footer */
.lp-foot { padding:26px 22px; border-top:1px solid var(--line); background:#fff; }
.lp-foot__in { display:flex; flex-wrap:wrap; justify-content:center; align-items:center; gap:10px 28px; font-size:13px; color:var(--gray-2); }
.lp-foot a { color:var(--gray-2); border-bottom:1px solid var(--line); }
.lp-foot a:hover { color:var(--ink); }

/* ── QUIZ MODAL ───────────────────────────────────────── */
.qov { position:fixed; inset:0; z-index:9999; display:none; align-items:center; justify-content:center; padding:16px; }
.qov.open { display:flex; }
.qbd { position:absolute; inset:0; background:rgba(11,15,26,.82); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); }
.qcard {
  position:relative; background:#fff; border-radius:24px;
  width:100%; max-width:520px; max-height:92vh; overflow-y:auto;
  padding:36px 36px 40px; box-shadow:0 32px 80px rgba(0,0,0,.38);
}
@media(max-width:540px){.qcard{padding:28px 20px 32px; border-radius:18px;}}
.qclose { position:absolute; top:14px; right:14px; width:32px; height:32px; border-radius:8px; background:var(--bg); border:none; cursor:pointer; display:flex; align-items:center; justify-content:center; color:var(--gray); transition:background .15s,color .15s; }
.qclose:hover{background:var(--line);color:var(--ink);}
.qpw { margin-bottom:28px; }
.qpl { font-size:12px; font-weight:600; color:var(--gray-2); margin-bottom:8px; }
.qpb { height:4px; background:var(--line); border-radius:999px; overflow:hidden; }
.qpf { height:100%; background:linear-gradient(90deg,var(--blue-strong),var(--blue)); border-radius:999px; transition:width .3s ease; }
.qstep { display:none; }
.qstep.act { display:block; animation:qin .22s ease; }
@keyframes qin { from{opacity:0;transform:translateX(14px)} to{opacity:1;transform:none} }
.qq { font-family:var(--f-head); font-size:20px; font-weight:800; color:var(--ink); line-height:1.28; letter-spacing:-.02em; margin-bottom:6px; }
.qhint { font-size:13.5px; color:var(--gray-2); margin-bottom:22px; line-height:1.5; }
.qch { display:flex; flex-direction:column; gap:10px; }
.qc {
  display:flex; align-items:center; gap:13px; padding:15px 17px;
  border:2px solid var(--line); border-radius:12px;
  font-size:15px; font-weight:500; color:var(--ink-soft); text-align:left;
  background:none; cursor:pointer; font-family:inherit;
  transition:border-color .15s, background .15s, color .15s, transform .12s;
}
.qc:hover{border-color:rgba(22,165,102,.32);background:rgba(22,165,102,.04);transform:translateX(2px);}
.qc.sel{border-color:var(--blue-strong);background:rgba(22,165,102,.07);color:var(--ink);font-weight:600;}
.qd { width:20px; height:20px; border-radius:50%; border:2px solid var(--line); flex-shrink:0; display:flex; align-items:center; justify-content:center; transition:border-color .15s,background .15s; }
.qc.sel .qd{border-color:var(--blue-strong);background:var(--blue-strong);}
.qc.sel .qd::after{content:'';width:6px;height:6px;border-radius:50%;background:#fff;}
.qnav { display:flex; justify-content:space-between; align-items:center; margin-top:24px; }
.qback { display:flex; align-items:center; gap:5px; font-size:14px; font-weight:500; color:var(--gray-2); background:none; border:none; cursor:pointer; padding:8px 0; font-family:inherit; transition:color .15s; }
.qback:hover{color:var(--ink);}
.qnxt { display:inline-flex; align-items:center; gap:7px; padding:12px 24px; background:linear-gradient(180deg,#7ef0ab 0%,#54dd92 100%); color:#06351e; font-size:15px; font-weight:700; border-radius:999px; border:none; cursor:pointer; font-family:inherit; opacity:.4; pointer-events:none; transition:opacity .15s,transform .15s,box-shadow .15s; }
.qnxt.rdy{opacity:1;pointer-events:auto;}
.qnxt.rdy:hover{transform:translateY(-1px);box-shadow:0 8px 20px rgba(29,120,62,.28);}
/* Quiz Intro (step 0) */
.qintro { text-align:center; padding:8px 0 4px; }
.qintro-icon { width:64px; height:64px; border-radius:20px; background:rgba(22,165,102,.1); display:flex; align-items:center; justify-content:center; margin:0 auto 24px; color:var(--blue-strong); }
.qintro h3 { font-family:var(--f-head); font-size:22px; font-weight:800; color:var(--ink); letter-spacing:-.025em; margin-bottom:12px; }
.qintro-spots { display:inline-flex; align-items:center; gap:7px; padding:7px 14px; background:rgba(22,165,102,.08); border:1px solid rgba(22,165,102,.22); border-radius:999px; font-size:13px; font-weight:700; color:var(--blue-strong); margin-bottom:20px; }
.qintro-spots-dot { width:6px; height:6px; border-radius:50%; background:var(--blue-strong); animation:blink 1.5s infinite; }
.qintro p { font-size:15px; color:var(--gray); line-height:1.65; margin-bottom:28px; max-width:380px; margin-left:auto; margin-right:auto; }
/* Form */
.qfg { margin-bottom:14px; }
.qfg label{display:block;font-size:13px;font-weight:600;color:var(--ink-soft);margin-bottom:6px;}
.qfg input{width:100%;padding:13px 15px;border:1.5px solid var(--line);border-radius:10px;font-size:15px;color:var(--ink);background:#fff;font-family:inherit;outline:none;transition:border-color .15s;}
.qfg input:focus{border-color:var(--blue-strong);}
.qfg input::placeholder{color:var(--gray-2);}
.qpriv{display:flex;align-items:flex-start;gap:10px;margin:18px 0;}
.qpriv input[type=checkbox]{margin-top:2px;width:16px;height:16px;accent-color:var(--blue-strong);flex-shrink:0;}
.qpriv label{font-size:13px;color:var(--gray-2);line-height:1.5;}
.qpriv a{color:var(--blue-strong);border-bottom:1px solid rgba(22,165,102,.3);}
.qsub{width:100%;padding:16px;background:linear-gradient(180deg,#7ef0ab 0%,#54dd92 100%);color:#06351e;font-size:16px;font-weight:700;border-radius:14px;border:none;cursor:pointer;font-family:inherit;transition:transform .15s,box-shadow .15s;box-shadow:var(--shadow-blue);}
.qsub:hover{transform:translateY(-2px);box-shadow:0 12px 28px rgba(29,120,62,.38);}
.qsub:active{transform:none;}
.qsub:disabled{opacity:.6;cursor:not-allowed;transform:none;box-shadow:none;}
/* Success */
.qsucc{display:none;text-align:center;padding:16px 0;}
.qsucc.show{display:block;animation:qin .3s ease;}
.qsucc-icon{width:64px;height:64px;border-radius:20px;background:rgba(22,165,102,.1);display:flex;align-items:center;justify-content:center;margin:0 auto 24px;color:var(--blue-strong);}
.qsucc h3{font-family:var(--f-head);font-size:22px;font-weight:800;color:var(--ink);letter-spacing:-.02em;margin-bottom:10px;}
