        <h3>Prüfe ob du qualifiziert bist.</h3>
        <p>Wir nehmen nicht jeden an. Beantworte 8 ehrliche Fragen — wir sagen dir danach klar, ob und wie wir dir helfen können.</p>
        <button class="btn btn--primary" onclick="startQuiz()" style="width:100%;justify-content:center;">
          Jetzt starten &rarr;
        </button>
        <p style="font-size:12.5px;color:var(--gray-2);margin-top:12px;">Kostenlos &middot; Dauert 2 Minuten &middot; Kein Spam</p>
      </div>
    </div>

    <!-- Q1 Betriebsgröße -->
    <div class="qstep" id="qs1">
      <p class="qq">Wie groß ist dein Betrieb aktuell?</p>
      <p class="qhint">Damit wir das Gespräch optimal auf dich zuschneiden können.</p>
      <div class="qch" id="qc1">
        <button class="qc" data-val="Solo (nur ich)" onclick="pick(this,1)"><span class="qd"></span>Nur ich selbst (Solo)</button>
        <button class="qc" data-val="2–5 Mitarbeiter" onclick="pick(this,1)"><span class="qd"></span>2–5 Mitarbeiter</button>
        <button class="qc" data-val="6–15 Mitarbeiter" onclick="pick(this,1)"><span class="qd"></span>6–15 Mitarbeiter</button>
        <button class="qc" data-val="Mehr als 15 Mitarbeiter" onclick="pick(this,1)"><span class="qd"></span>Mehr als 15 Mitarbeiter</button>
      </div>
      <div class="qnav"><span></span><button class="qnxt" id="qn1" onclick="nx(1)">Weiter <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></button></div>
    </div>

    <!-- Q2 Region -->
    <div class="qstep" id="qs2">
      <p class="qq">Aus welcher Region kommst du?</p>
      <p class="qhint">Wir prüfen, ob deine Region noch verfügbar ist.</p>
      <div class="qch" id="qc2">
        <button class="qc" data-val="Norddeutschland" onclick="pick(this,2)"><span class="qd"></span>Norddeutschland (HH, HB, SH, MV, NI)</button>
        <button class="qc" data-val="Westdeutschland" onclick="pick(this,2)"><span class="qd"></span>Westdeutschland (NRW, RP, SL)</button>
        <button class="qc" data-val="Mitteldeutschland" onclick="pick(this,2)"><span class="qd"></span>Mitteldeutschland (HE, TH, ST, BB, BE)</button>
        <button class="qc" data-val="Süddeutschland" onclick="pick(this,2)"><span class="qd"></span>Süddeutschland (BY, BW, SN)</button>
      </div>
      <div class="qnav"><button class="qback" onclick="pv(2)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>Zurück</button><button class="qnxt" id="qn2" onclick="nx(2)">Weiter <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></button></div>
    </div>

    <!-- Q3 Anfragen -->
    <div class="qstep" id="qs3">
      <p class="qq">Wie viele Kundenanfragen bekommst du pro Monat?</p>
      <p class="qhint">Ungefähr — kein genaues Ergebnis nötig.</p>
      <div class="qch" id="qc3">
        <button class="qc" data-val="Kaum welche (0–3)" onclick="pick(this,3)"><span class="qd"></span>Kaum welche (0–3)</button>
        <button class="qc" data-val="Ein paar (4–10)" onclick="pick(this,3)"><span class="qd"></span>Ein paar (4–10)</button>
        <button class="qc" data-val="Genug, aber oft unqualifiziert" onclick="pick(this,3)"><span class="qd"></span>Genug, aber oft unqualifiziert</button>
      </div>
      <div class="qnav"><button class="qback" onclick="pv(3)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>Zurück</button><button class="qnxt" id="qn3" onclick="nx(3)">Weiter <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></button></div>
    </div>

    <!-- Q4 Website -->
    <div class="qstep" id="qs4">
      <p class="qq">Hast du bereits eine professionelle Website?</p>
      <p class="qhint">Wir analysieren, was sinnvoll ist — ehrlich, ohne Verpflichtung.</p>
      <div class="qch" id="qc4">
        <button class="qc" data-val="Noch keine Website" onclick="pick(this,4)"><span class="qd"></span>Noch keine</button>
        <button class="qc" data-val="Ja, veraltet oder ohne Ergebnis" onclick="pick(this,4)"><span class="qd"></span>Ja, aber veraltet oder ohne Ergebnis</button>
        <button class="qc" data-val="Ja, moderne Website" onclick="pick(this,4)"><span class="qd"></span>Ja, moderne Website</button>
      </div>
      <div class="qnav"><button class="qback" onclick="pv(4)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>Zurück</button><button class="qnxt" id="qn4" onclick="nx(4)">Weiter <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></button></div>
    </div>

    <!-- Q5 Google Ads -->
    <div class="qstep" id="qs5">
      <p class="qq">Hast du bereits Google Ads ausprobiert?</p>
      <p class="qhint">Hilft uns, die richtige Strategie für dich zu wählen.</p>
      <div class="qch" id="qc5">
        <button class="qc" data-val="Noch nie Google Ads genutzt" onclick="pick(this,5)"><span class="qd"></span>Noch nie ausprobiert</button>
        <button class="qc" data-val="Google Ads genutzt, ohne Erfolg" onclick="pick(this,5)"><span class="qd"></span>Ja, aber ohne richtiges Ergebnis</button>
        <button class="qc" data-val="Google Ads mit etwas Erfolg" onclick="pick(this,5)"><span class="qd"></span>Ja, mit etwas Erfolg</button>
      </div>
      <div class="qnav"><button class="qback" onclick="pv(5)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>Zurück</button><button class="qnxt" id="qn5" onclick="nx(5)">Weiter <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></button></div>
    </div>

    <!-- Q6 Starttermin -->
    <div class="qstep" id="qs6">
      <p class="qq">Wann möchtest du starten?</p>
      <p class="qhint">Kein Druck — wir richten uns nach dir.</p>
      <div class="qch" id="qc6">
        <button class="qc" data-val="Sofort / dringend" onclick="pick(this,6)"><span class="qd"></span>So schnell wie möglich</button>
        <button class="qc" data-val="In den nächsten 3 Monaten" onclick="pick(this,6)"><span class="qd"></span>In den nächsten 3 Monaten</button>
        <button class="qc" data-val="Erst mal informieren" onclick="pick(this,6)"><span class="qd"></span>Ich möchte mich erst informieren</button>
      </div>
      <div class="qnav"><button class="qback" onclick="pv(6)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>Zurück</button><button class="qnxt" id="qn6" onclick="nx(6)">Weiter <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></button></div>
    </div>

    <!-- Q7 Budget (optional) -->
    <div class="qstep" id="qs7">
      <p class="qq">Welches monatliche Budget planst du für Marketing?</p>
      <p class="qhint">Optional — hilft uns zur Vorbereitung.</p>
      <div class="qch" id="qc7">
        <button class="qc" data-val="" onclick="pick(this,7)"><span class="qd"></span>Das ist noch offen</button>
        <button class="qc" data-val="Bis 500 €/Monat" onclick="pick(this,7)"><span class="qd"></span>Bis 500 €/Monat</button>
        <button class="qc" data-val="500–1.500 €/Monat" onclick="pick(this,7)"><span class="qd"></span>500–1.500 €/Monat</button>
        <button class="qc" data-val="Über 1.500 €/Monat" onclick="pick(this,7)"><span class="qd"></span>Über 1.500 €/Monat</button>
      </div>
      <div class="qnav"><button class="qback" onclick="pv(7)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>Zurück</button><button class="qnxt rdy" id="qn7" onclick="nx(7)">Weiter <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></button></div>
    </div>

    <!-- Q8 Kontakt -->
    <div class="qstep" id="qs8">
      <p class="qq">Fast geschafft. Wohin sollen wir uns melden?</p>
      <p class="qhint">Wir melden uns persönlich innerhalb von 24 Stunden — nicht automatisch.</p>
      <div class="qfg"><label for="fvn">Vorname *</label><input id="fvn" type="text" placeholder="Max" autocomplete="given-name" /></div>
      <div class="qfg"><label for="fnn">Nachname *</label><input id="fnn" type="text" placeholder="Mustermann" autocomplete="family-name" /></div>
      <div class="qfg"><label for="ftel">Telefon *</label><input id="ftel" type="tel" placeholder="+49 163 000 0000" autocomplete="tel" /></div>
      <div class="qfg"><label for="fmail">E-Mail *</label><input id="fmail" type="email" placeholder="max@mustermann.de" autocomplete="email" /></div>
      <div class="qpriv"><input type="checkbox" id="fpriv" /><label for="fpriv">Ich stimme der Verarbeitung meiner Daten gemäß der <a href="/datenschutz" target="_blank">Datenschutzerklärung</a> zu.</label></div>
      <div class="qnav" style="margin-top:8px;">
        <button class="qback" onclick="pv(8)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>Zurück</button>
        <button class="qsub" id="qSub" onclick="send()">Platz jetzt sichern &rarr;</button>
      </div>
    </div>

    <!-- Erfolg -->
    <div class="qsucc" id="qSucc">
      <div class="qsucc-icon"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
      <h3>Platz gesichert!</h3>
      <p>Wir melden uns innerhalb von <strong>24 Stunden</strong> persönlich bei dir — nicht per Autoresponder. Schau in dein Postfach.</p>
    </div>
  </div>
</div>

<script>
  var _sp=new URLSearchParams(window.location.search);
  var _utm={utm_source:_sp.get('utm_source')||undefined,utm_medium:_sp.get('utm_medium')||undefined,utm_campaign:_sp.get('utm_campaign')||undefined,utm_term:_sp.get('utm_term')||undefined,utm_content:_sp.get('utm_content')||undefined,referrer:document.referrer||undefined,geraet:window.innerWidth<768?'mobil':'desktop'};
  var TOTAL=8,_cur=0;
  var _d={betrieb:'',region:'',anfragen:'',website_exists:'',ads_exp:'',zeitpunkt_wunsch:'',budget:''};

  function openQuiz(){document.getElementById('quizOverlay').classList.add('open');document.body.style.overflow='hidden';}
  function closeQuiz(){document.getElementById('quizOverlay').classList.remove('open');document.body.style.overflow='';}
  document.addEventListener('keydown',function(e){if(e.key==='Escape')closeQuiz();});

  function startQuiz(){
    sp(1);
    document.getElementById('qPW').style.display='';
  }

  function pick(btn,s){
    btn.closest('.qch').querySelectorAll('.qc').forEach(function(c){c.classList.remove('sel');});
    btn.classList.add('sel');
    var n=document.getElementById('qn'+s);if(n)n.classList.add('rdy');
  }
  function gv(s){var el=document.querySelector('#qc'+s+' .qc.sel');return el?el.dataset.val:'';}

  function sp(n){
    document.querySelectorAll('.qstep').forEach(function(s){s.classList.remove('act');});
    var el=document.getElementById('qs'+n);
    if(el){el.classList.remove('act');void el.offsetWidth;el.classList.add('act');}
    if(n>0){
      document.getElementById('qPF').style.width=Math.round((n/TOTAL)*100)+'%';
      document.getElementById('qPL').textContent='Schritt '+n+' von '+TOTAL;
    }
    _cur=n;
    document.querySelector('.qcard').scrollTop=0;
  }

  function nx(s){
    if(s===1)_d.betrieb=gv(s);
    if(s===2)_d.region=gv(s);
    if(s===3)_d.anfragen=gv(s);
    if(s===4)_d.website_exists=gv(s);
    if(s===5)_d.ads_exp=gv(s);
    if(s===6)_d.zeitpunkt_wunsch=gv(s);
    if(s===7)_d.budget=gv(s);
    sp(s+1);
  }
  function pv(s){sp(s>1?s-1:0);}

  function buildMsg(){
    return ['Betrieb: '+_d.betrieb,'Region: '+_d.region,'Anfragen/Monat: '+_d.anfragen,'Website: '+_d.website_exists,'Google Ads: '+_d.ads_exp,'Start: '+_d.zeitpunkt_wunsch,_d.budget?'Budget: '+_d.budget:''].filter(Boolean).join(' | ');
  }

  function send(){
    var vn=document.getElementById('fvn').value.trim(),nn=document.getElementById('fnn').value.trim(),tel=document.getElementById('ftel').value.trim(),mail=document.getElementById('fmail').value.trim(),priv=document.getElementById('fpriv').checked;
    if(!vn){alert('Bitte Vorname angeben.');return;}
    if(!nn){alert('Bitte Nachname angeben.');return;}
    if(!tel){alert('Bitte Telefonnummer angeben.');return;}
    if(!mail){alert('Bitte E-Mail angeben.');return;}
    if(!priv){alert('Bitte Datenschutzerklärung akzeptieren.');return;}
    var btn=document.getElementById('qSub');
    btn.disabled=true;btn.textContent='Wird gesendet…';
    var p=Object.assign({name:vn+' '+nn,email:mail,telefon:tel,betrieb:_d.betrieb,ziel:'Komplettsystem (Website + Ads + KI)',anfragen:_d.anfragen,website_exists:_d.website_exists,zeitpunkt_wunsch:_d.zeitpunkt_wunsch,budget:_d.budget||undefined,nachricht:buildMsg(),seite:'galabau-mehr-kunden'},_utm);
    fetch('https://fastraone-admin.vercel.app/api/leads',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(p)})
    .then(function(r){if(!r.ok)throw new Error(r.status);})
    .then(function(){
      document.querySelectorAll('.qstep').forEach(function(s){s.style.display='none';});
      document.getElementById('qPW').style.display='none';
      document.getElementById('qSucc').classList.add('show');
    }).catch(function(){
      btn.disabled=false;btn.textContent='Platz jetzt sichern →';
      alert('Fehler. Bitte ruf uns an: +49 163 3781657');
    });
  }

  function tgl(btn){
    var item=btn.closest('.lp-fi'),ans=item.querySelector('.lp-fa'),open=item.classList.contains('open');
    document.querySelectorAll('.lp-fi').forEach(function(i){i.classList.remove('open');i.querySelector('.lp-fa').style.maxHeight='0';});
    if(!open){item.classList.add('open');ans.style.maxHeight=ans.scrollHeight+'px';}
  }

  /* Hide progress bar on intro step initially */
  document.getElementById('qPW').style.display='none';

  if(typeof IntersectionObserver!=='undefined'){
    var ro=new IntersectionObserver(function(en){en.forEach(function(e){if(e.isIntersecting){e.target.classList.add('is-visible');ro.unobserve(e.target);}});},{threshold:.07});
    document.querySelectorAll('.reveal').forEach(function(el){ro.observe(el);});
  }else{document.querySelectorAll('.reveal').forEach(function(el){el.classList.add('is-visible');});}
</script>
</BaseLayout>
