---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Mehr GaLaBau-Aufträge in 14 Tagen | Fastra One"
  description="Das digitale Kundengewinnungssystem für Garten- und Landschaftsbauunternehmen. Qualifizierte Anfragen auf Knopfdruck — ohne Agentur-Risiko."
  navVariant="none"
  footerVariant="none"
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

<style>
  /* ─── TOKENS ─────────────────────────────────────────────── */
  :root {
    --ink: #0f172a;
    --ink-soft: #374151;
    --ink-muted: #6b7280;
    --bg: #ffffff;
    --bg-soft: #f8fafc;
    --bg-dark: #0a1f14;
    --green: #16a566;
    --green-dark: #0e8f57;
    --green-light: #e8faf1;
    --green-muted: #b3e8ce;
    --line: rgba(0,0,0,0.07);
    --line-dark: rgba(0,0,0,0.13);
    --shadow-sm: 0 1px 4px rgba(0,0,0,0.06);
    --shadow-md: 0 4px 20px rgba(0,0,0,0.08);
    --shadow-lg: 0 16px 48px rgba(0,0,0,0.12);
    --r: 16px;
    --r-sm: 10px;
  }

  /* ─── RESET ──────────────────────────────────────────────── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; }
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif; color: var(--ink); background: var(--bg); }
  img { max-width: 100%; display: block; }
  button { cursor: pointer; border: none; background: none; font-family: inherit; }
  a { text-decoration: none; }

  /* ─── LAYOUT ─────────────────────────────────────────────── */
  .container { max-width: 1080px; margin: 0 auto; padding: 0 24px; }
  .container--narrow { max-width: 720px; margin: 0 auto; padding: 0 24px; }
  section { padding: 96px 0; }
  @media(max-width:768px){ section { padding: 64px 0; } }

  /* ─── ANNOUNCE BAR ───────────────────────────────────────── */
  .announce { background: var(--ink); color: #fff; text-align: center; padding: 10px 24px; font-size: 13px; font-weight: 500; letter-spacing: .01em; }
  .announce strong { color: #4ade80; }
  .announce a { color: #fff; border-bottom: 1px solid rgba(255,255,255,.35); }

  /* ─── HERO ───────────────────────────────────────────────── */
  .hero { position: relative; padding: 100px 0 96px; overflow: hidden; }
  .hero__bg { position: absolute; inset: 0; background: radial-gradient(ellipse 80% 60% at 50% -10%, rgba(22,165,102,.12) 0%, transparent 70%); pointer-events: none; }
  .hero__grid { position: absolute; inset: 0; background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: 48px 48px; mask-image: radial-gradient(ellipse 80% 50% at 50% 0%, black 0%, transparent 80%); pointer-events: none; }
  .hero__inner { position: relative; text-align: center; }
  .hero__pill { display: inline-flex; align-items: center; gap: 7px; padding: 6px 14px; background: var(--green-light); border: 1px solid var(--green-muted); border-radius: 99px; font-size: 12.5px; font-weight: 600; color: var(--green-dark); margin-bottom: 32px; }
  .hero__pill-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--green); animation: pulse 2s infinite; }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.4} }
  .hero h1 { font-size: clamp(38px,6vw,68px); font-weight: 800; line-height: 1.06; letter-spacing: -.03em; color: var(--ink); margin-bottom: 24px; }
  .hero h1 .grad { background: linear-gradient(135deg, var(--green) 0%, #0fbf6f 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; display: block; }
  .hero__sub { font-size: 18px; color: var(--ink-soft); line-height: 1.65; max-width: 540px; margin: 0 auto 36px; }
  @media(max-width:768px){ .hero__sub { font-size: 16px; } }
  .hero__checks { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 22px; margin-bottom: 40px; }
  .hero__check { display: flex; align-items: center; gap: 7px; font-size: 14px; font-weight: 500; color: var(--ink-soft); }
  .hero__check svg { color: var(--green); flex-shrink: 0; }
  .hero__cta-wrap { display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .btn-primary { display: inline-flex; align-items: center; gap: 8px; padding: 16px 32px; background: var(--green); color: #fff; font-size: 16px; font-weight: 700; border-radius: 12px; transition: background .15s, transform .15s, box-shadow .15s; box-shadow: 0 4px 20px rgba(22,165,102,.35); }
  .btn-primary:hover { background: var(--green-dark); transform: translateY(-1px); box-shadow: 0 8px 28px rgba(22,165,102,.45); }
  .btn-primary:active { transform: translateY(0); }
  .btn-primary svg { transition: transform .15s; }
  .btn-primary:hover svg { transform: translateX(3px); }
  .hero__no-risk { font-size: 13px; color: var(--ink-muted); }
  .hero__stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line-dark); border: 1px solid var(--line-dark); border-radius: var(--r); overflow: hidden; margin-top: 64px; max-width: 580px; margin-left: auto; margin-right: auto; }
  .hero__stat { background: var(--bg); padding: 22px 20px; text-align: center; }
  .hero__stat-val { font-size: 28px; font-weight: 800; color: var(--ink); letter-spacing: -.03em; }
  .hero__stat-val .unit { font-size: 16px; font-weight: 700; color: var(--green); }
  .hero__stat-label { font-size: 12.5px; color: var(--ink-muted); font-weight: 500; margin-top: 3px; }

  /* ─── LOGOS / VERTRAUEN ──────────────────────────────────── */
  .trust { padding: 40px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .trust__label { text-align: center; font-size: 12px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-muted); margin-bottom: 24px; }
  .trust__row { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 16px 36px; }
  .trust__badge { display: flex; align-items: center; gap: 8px; padding: 9px 16px; background: var(--bg-soft); border: 1px solid var(--line); border-radius: var(--r-sm); font-size: 13px; font-weight: 600; color: var(--ink-soft); white-space: nowrap; }
  .trust__badge svg { color: var(--green); }

  /* ─── PROBLEM ────────────────────────────────────────────── */
  .problem { background: var(--bg-soft); }
  .section-label { font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--green); margin-bottom: 12px; }
  .section-h2 { font-size: clamp(28px,4vw,46px); font-weight: 800; line-height: 1.1; letter-spacing: -.025em; color: var(--ink); margin-bottom: 16px; }
  .section-sub { font-size: 17px; color: var(--ink-soft); line-height: 1.6; max-width: 540px; margin-bottom: 56px; }
  .problem-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  @media(max-width:900px){ .problem-grid { grid-template-columns: repeat(2,1fr); } }
  @media(max-width:560px){ .problem-grid { grid-template-columns: 1fr; } }
  .problem-card { background: var(--bg); border: 1px solid var(--line-dark); border-radius: var(--r); padding: 28px 24px; transition: box-shadow .2s, border-color .2s; }
  .problem-card:hover { box-shadow: var(--shadow-md); border-color: var(--green-muted); }
  .problem-card__icon { width: 36px; height: 36px; border-radius: var(--r-sm); background: #fef3f2; display: flex; align-items: center; justify-content: center; margin-bottom: 16px; color: #dc2626; }
  .problem-card h3 { font-size: 15px; font-weight: 700; color: var(--ink); margin-bottom: 8px; line-height: 1.3; }
  .problem-card p { font-size: 14px; color: var(--ink-muted); line-height: 1.6; }

  /* ─── BRIDGE ─────────────────────────────────────────────── */
  .bridge { background: var(--bg-dark); padding: 80px 0; }
  .bridge__inner { text-align: center; }
  .bridge__eyebrow { font-size: 13px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--green); margin-bottom: 20px; }
  .bridge__h2 { font-size: clamp(26px,4vw,42px); font-weight: 800; color: #fff; line-height: 1.2; letter-spacing: -.025em; margin-bottom: 20px; max-width: 640px; margin-left: auto; margin-right: auto; }
  .bridge__sub { font-size: 17px; color: rgba(255,255,255,.65); line-height: 1.65; max-width: 520px; margin: 0 auto 40px; }
  .bridge__btn { display: inline-flex; align-items: center; gap: 8px; padding: 14px 28px; background: rgba(22,165,102,.15); border: 1px solid rgba(22,165,102,.4); color: #4ade80; font-size: 15px; font-weight: 600; border-radius: 10px; transition: background .15s, border-color .15s; }
  .bridge__btn:hover { background: rgba(22,165,102,.25); border-color: rgba(22,165,102,.6); }

  /* ─── SYSTEM / OFFER ─────────────────────────────────────── */
  .system__header { text-align: center; margin-bottom: 56px; }
  .system__name { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--green); background: var(--green-light); padding: 6px 14px; border-radius: 99px; margin-bottom: 16px; }
  .system__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 48px; }
  @media(max-width:900px){ .system__grid { grid-template-columns: repeat(2,1fr); } }
  @media(max-width:560px){ .system__grid { grid-template-columns: 1fr; } }
  .system-card { border: 1px solid var(--line-dark); border-radius: var(--r); padding: 24px; transition: box-shadow .2s, border-color .2s, transform .2s; }
  .system-card:hover { box-shadow: var(--shadow-md); border-color: var(--green-muted); transform: translateY(-2px); }
  .system-card__icon { width: 36px; height: 36px; border-radius: var(--r-sm); background: var(--green-light); display: flex; align-items: center; justify-content: center; color: var(--green); margin-bottom: 14px; }
  .system-card h3 { font-size: 15px; font-weight: 700; color: var(--ink); margin-bottom: 6px; }
  .system-card p { font-size: 13.5px; color: var(--ink-muted); line-height: 1.6; }
  .system__guarantee { background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); border: 1px solid #86efac; border-radius: var(--r); padding: 28px 32px; display: flex; align-items: flex-start; gap: 20px; }
  @media(max-width:600px){ .system__guarantee { flex-direction: column; padding: 24px; } }
  .system__guarantee-icon { width: 48px; height: 48px; border-radius: 12px; background: var(--green); display: flex; align-items: center; justify-content: center; color: #fff; flex-shrink: 0; }
  .system__guarantee-text h3 { font-size: 17px; font-weight: 700; color: var(--ink); margin-bottom: 6px; }
  .system__guarantee-text p { font-size: 14.5px; color: var(--ink-soft); line-height: 1.6; }

  /* ─── PROCESS ────────────────────────────────────────────── */
  .process { background: var(--bg-soft); }
  .process__steps { display: grid; grid-template-columns: repeat(3,1fr); gap: 0; position: relative; }
  @media(max-width:768px){ .process__steps { grid-template-columns: 1fr; gap: 0; } }
  .process__step { padding: 40px 32px; position: relative; }
  @media(max-width:768px){ .process__step { padding: 32px 24px 0; } }
  .process__step + .process__step::before {
    content: '';
    position: absolute;
    top: 44px;
    left: 0;
    width: 1px;
    height: calc(100% - 44px);
    background: var(--line-dark);
  }
  @media(max-width:768px){
    .process__step + .process__step::before { display: none; }
    .process__step { padding-bottom: 32px; border-bottom: 1px solid var(--line-dark); }
    .process__step:last-child { border-bottom: none; }
  }
  .process__num { width: 40px; height: 40px; border-radius: 12px; background: var(--ink); color: #fff; font-size: 15px; font-weight: 800; display: flex; align-items: center; justify-content: center; margin-bottom: 20px; }
  .process__step h3 { font-size: 18px; font-weight: 700; color: var(--ink); margin-bottom: 8px; }
  .process__step .days { font-size: 12px; font-weight: 600; color: var(--green); text-transform: uppercase; letter-spacing: .08em; margin-bottom: 10px; }
  .process__step p { font-size: 14.5px; color: var(--ink-soft); line-height: 1.65; }

  /* ─── WHY US ─────────────────────────────────────────────── */
  .why__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px 64px; margin-top: 56px; }
  @media(max-width:768px){ .why__grid { grid-template-columns: 1fr; gap: 28px; } }
  .why__item { display: flex; gap: 16px; }
  .why__item-icon { width: 40px; height: 40px; border-radius: 12px; background: var(--green-light); display: flex; align-items: center; justify-content: center; color: var(--green); flex-shrink: 0; margin-top: 2px; }
  .why__item h3 { font-size: 16px; font-weight: 700; color: var(--ink); margin-bottom: 6px; }
  .why__item p { font-size: 14px; color: var(--ink-soft); line-height: 1.65; }

  /* ─── FAQ ────────────────────────────────────────────────── */
  .faq { background: var(--bg-soft); }
  .faq__list { margin-top: 48px; display: flex; flex-direction: column; gap: 8px; max-width: 720px; margin-left: auto; margin-right: auto; }
  .faq__item { background: var(--bg); border: 1px solid var(--line-dark); border-radius: var(--r); overflow: hidden; }
  .faq__q { width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 20px 24px; text-align: left; font-size: 15.5px; font-weight: 600; color: var(--ink); gap: 16px; }
  .faq__q svg { flex-shrink: 0; color: var(--ink-muted); transition: transform .25s; }
  .faq__item.open .faq__q svg { transform: rotate(45deg); color: var(--green); }
  .faq__a { max-height: 0; overflow: hidden; transition: max-height .3s ease; }
  .faq__a-inner { padding: 0 24px 20px; font-size: 14.5px; color: var(--ink-soft); line-height: 1.7; }

  /* ─── FINAL CTA ──────────────────────────────────────────── */
  .final-cta { background: var(--ink); position: relative; overflow: hidden; }
  .final-cta__glow { position: absolute; top: -60px; left: 50%; transform: translateX(-50%); width: 600px; height: 300px; background: radial-gradient(ellipse, rgba(22,165,102,.3) 0%, transparent 70%); pointer-events: none; }
  .final-cta__inner { position: relative; text-align: center; padding: 96px 24px; }
  .final-cta h2 { font-size: clamp(28px,4vw,48px); font-weight: 800; color: #fff; line-height: 1.1; letter-spacing: -.025em; margin-bottom: 16px; }
  .final-cta h2 span { color: var(--green); }
  .final-cta__sub { font-size: 17px; color: rgba(255,255,255,.6); max-width: 480px; margin: 0 auto 40px; line-height: 1.6; }
  .btn-primary-lg { display: inline-flex; align-items: center; gap: 10px; padding: 18px 40px; background: var(--green); color: #fff; font-size: 17px; font-weight: 700; border-radius: 14px; transition: background .15s, transform .15s, box-shadow .15s; box-shadow: 0 6px 24px rgba(22,165,102,.45); }
  .btn-primary-lg:hover { background: var(--green-dark); transform: translateY(-2px); box-shadow: 0 10px 32px rgba(22,165,102,.55); }
  .final-cta__meta { margin-top: 20px; font-size: 13px; color: rgba(255,255,255,.45); }

  /* ─── FOOTER ─────────────────────────────────────────────── */
  .lp-footer { padding: 32px 24px; border-top: 1px solid var(--line); text-align: center; }
  .lp-footer__inner { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 12px 32px; font-size: 13px; color: var(--ink-muted); }
  .lp-footer a { color: var(--ink-muted); border-bottom: 1px solid var(--line-dark); }
  .lp-footer a:hover { color: var(--ink); }

  /* ─── QUIZ OVERLAY ───────────────────────────────────────── */
  .quiz-overlay { position: fixed; inset: 0; z-index: 9999; display: none; align-items: center; justify-content: center; padding: 16px; }
  .quiz-overlay.open { display: flex; }
  .quiz-backdrop { position: absolute; inset: 0; background: rgba(15,23,42,.75); backdrop-filter: blur(6px); }
  .quiz-card { position: relative; background: var(--bg); border-radius: 24px; width: 100%; max-width: 520px; max-height: 90vh; overflow-y: auto; padding: 36px 36px 40px; box-shadow: var(--shadow-lg); }
  @media(max-width:540px){ .quiz-card { padding: 28px 20px 32px; border-radius: 18px; } }
  .quiz-close { position: absolute; top: 16px; right: 16px; width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: var(--ink-muted); background: var(--bg-soft); transition: background .15s; }
  .quiz-close:hover { background: var(--line-dark); color: var(--ink); }
  .quiz-progress-wrap { margin-bottom: 28px; }
  .quiz-progress-label { font-size: 12px; font-weight: 600; color: var(--ink-muted); margin-bottom: 8px; }
  .quiz-progress-bar { height: 4px; background: var(--line-dark); border-radius: 99px; overflow: hidden; }
  .quiz-progress-fill { height: 100%; background: var(--green); border-radius: 99px; transition: width .3s ease; }
  .quiz-step { display: none; }
  .quiz-step.active { display: block; animation: stepIn .25s ease; }
  @keyframes stepIn { from { opacity:0; transform:translateX(20px); } to { opacity:1; transform:translateX(0); } }
  .quiz-q { font-size: 20px; font-weight: 800; color: var(--ink); line-height: 1.3; margin-bottom: 6px; letter-spacing: -.02em; }
  .quiz-hint { font-size: 13.5px; color: var(--ink-muted); margin-bottom: 24px; }
  .quiz-choices { display: flex; flex-direction: column; gap: 10px; }
  .quiz-choice { display: flex; align-items: center; gap: 14px; padding: 16px 18px; border: 2px solid var(--line-dark); border-radius: 12px; font-size: 15px; font-weight: 500; color: var(--ink-soft); text-align: left; transition: border-color .15s, background .15s, color .15s; }
  .quiz-choice:hover { border-color: var(--green-muted); background: var(--green-light); color: var(--ink); }
  .quiz-choice.selected { border-color: var(--green); background: var(--green-light); color: var(--ink); font-weight: 600; }
  .quiz-choice-dot { width: 20px; height: 20px; border-radius: 50%; border: 2px solid var(--line-dark); flex-shrink: 0; transition: border-color .15s, background .15s; display: flex; align-items: center; justify-content: center; }
  .quiz-choice.selected .quiz-choice-dot { border-color: var(--green); background: var(--green); }
  .quiz-choice.selected .quiz-choice-dot::after { content: ''; width: 6px; height: 6px; border-radius: 50%; background: #fff; }
  .quiz-nav { display: flex; justify-content: space-between; align-items: center; margin-top: 24px; }
  .quiz-back { font-size: 14px; font-weight: 500; color: var(--ink-muted); display: flex; align-items: center; gap: 5px; padding: 8px 0; }
  .quiz-back:hover { color: var(--ink); }
  .quiz-next { display: inline-flex; align-items: center; gap: 7px; padding: 13px 24px; background: var(--green); color: #fff; font-size: 15px; font-weight: 700; border-radius: 10px; transition: background .15s; opacity: .5; pointer-events: none; }
  .quiz-next.ready { opacity: 1; pointer-events: auto; }
  .quiz-next.ready:hover { background: var(--green-dark); }

  /* ─── CONTACT FORM (last quiz step) ─────────────────────── */
  .quiz-form-group { margin-bottom: 16px; }
  .quiz-form-group label { display: block; font-size: 13px; font-weight: 600; color: var(--ink-soft); margin-bottom: 7px; }
  .quiz-form-group input { width: 100%; padding: 13px 15px; border: 2px solid var(--line-dark); border-radius: 10px; font-size: 15px; color: var(--ink); background: var(--bg); outline: none; transition: border-color .15s; font-family: inherit; }
  .quiz-form-group input:focus { border-color: var(--green); }
  .quiz-form-group input::placeholder { color: var(--ink-muted); }
  .quiz-privacy { display: flex; align-items: flex-start; gap: 10px; margin: 20px 0; }
  .quiz-privacy input[type="checkbox"] { margin-top: 2px; width: 16px; height: 16px; accent-color: var(--green); flex-shrink: 0; }
  .quiz-privacy label { font-size: 13px; color: var(--ink-muted); line-height: 1.5; }
  .quiz-privacy a { color: var(--green); border-bottom: 1px solid var(--green-muted); }
  .quiz-submit { width: 100%; padding: 16px; background: var(--green); color: #fff; font-size: 16px; font-weight: 700; border-radius: 12px; transition: background .15s, transform .15s; box-shadow: 0 4px 16px rgba(22,165,102,.3); }
  .quiz-submit:hover { background: var(--green-dark); }
  .quiz-submit:active { transform: scale(.99); }
  .quiz-submit:disabled { opacity: .6; cursor: not-allowed; transform: none; }

  /* ─── SUCCESS ─────────────────────────────────────────────── */
  .quiz-success { display: none; text-align: center; padding: 16px 0 8px; }
  .quiz-success.show { display: block; animation: stepIn .3s ease; }
  .quiz-success__icon { width: 64px; height: 64px; border-radius: 20px; background: var(--green-light); display: flex; align-items: center; justify-content: center; margin: 0 auto 24px; color: var(--green); }
  .quiz-success h3 { font-size: 22px; font-weight: 800; color: var(--ink); margin-bottom: 10px; letter-spacing: -.02em; }
  .quiz-success p { font-size: 15px; color: var(--ink-soft); line-height: 1.6; }

  /* ─── REVEAL ANIMATIONS ──────────────────────────────────── */
  .reveal { opacity: 0; transform: translateY(24px); transition: opacity .55s ease, transform .55s ease; }
  .reveal.visible { opacity: 1; transform: translateY(0); }
  @media(prefers-reduced-motion:reduce){ .reveal { opacity:1; transform:none; transition:none; } }
</style>

<!-- ════ ANNOUNCE BAR ════════════════════════════════════════════ -->
<div class="announce">
  <strong>Nur noch 3 Plätze</strong> im Juli verfügbar ·
  Kampagne startet innerhalb von <strong>14 Tagen</strong> ·
  <a href="#quiz-start" onclick="startQuiz(); return false;">Jetzt Platz sichern →</a>
</div>

<!-- ════ HERO ════════════════════════════════════════════════════ -->
<section class="hero">
  <div class="hero__bg"></div>
  <div class="hero__grid"></div>
  <div class="container">
    <div class="hero__inner">
      <div class="hero__pill">
        <span class="hero__pill-dot"></span>
        Google Ads Spezialist für GaLaBau-Betriebe
      </div>

      <h1>
        Dein Auftragsbuch.
        <span class="grad">Vollgebucht.</span>
        In 14 Tagen.
      </h1>

      <p class="hero__sub">
        Das erste digitale Kundengewinnungssystem ausschließlich für Garten- und Landschaftsbauunternehmen.
