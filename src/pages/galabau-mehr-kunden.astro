.lp-h1 { font-family:var(--f-head); font-weight:800; letter-spacing:-0.035em; font-size:clamp(2.2rem,5vw,3.6rem); line-height:1.06; color:#fff; margin-bottom:16px; }
.lp-accent-grad { background:linear-gradient(90deg,#5df09e 0%,#22c55e 100%); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
.lp-sub { color:rgba(255,255,255,.58); font-size:clamp(.95rem,1.6vw,1.05rem); line-height:1.7; max-width:50ch; margin-bottom:24px; }
.lp-sub strong { color:rgba(255,255,255,.88); }
.lp-offer-strip { display:flex; align-items:stretch; width:100%; max-width:560px; background:rgba(255,255,255,.055); border:1px solid rgba(110,236,157,.22); border-radius:18px; overflow:hidden; margin-bottom:28px; }
.lp-offer-item { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:3px; padding:14px 6px; }
.lp-offer-item__val { font-family:var(--f-head); font-size:clamp(1.1rem,2vw,1.4rem); font-weight:800; letter-spacing:-0.04em; color:#fff; line-height:1; }
.lp-offer-item__val--green { color:#4ade80; }
.lp-offer-item__label { font-size:.68rem; color:rgba(255,255,255,.44); font-weight:500; text-align:center; }
