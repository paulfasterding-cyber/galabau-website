<script>
  /* ─ UTM aus URL lesen ─ */
  var _up = new URLSearchParams(window.location.search);
  var _utm = {
    utm_source:   _up.get('utm_source')   || undefined,
    utm_medium:   _up.get('utm_medium')   || undefined,
    utm_campaign: _up.get('utm_campaign') || undefined,
    utm_term:     _up.get('utm_term')     || undefined,
    utm_content:  _up.get('utm_content')  || undefined,
    referrer:     document.referrer       || undefined,
    geraet:       window.innerWidth < 768 ? 'mobil' : 'desktop',
  };

  /* ─ Quiz State ─ */
  var _state = { betrieb: '', anfragen: '', website_exists: '', herausforderung: '', zeitpunkt_wunsch: '', budget: '' };
  var _current = 1;
  var TOTAL = 7;

  function startQuiz() {
    document.getElementById('quizOverlay').classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeQuiz() {
    document.getElementById('quizOverlay').classList.remove('open');
    document.body.style.overflow = '';
  }
  document.addEventListener('keydown', function(e){ if(e.key==='Escape') closeQuiz(); });

  function selectChoice(btn, step) {
    var choices = btn.closest('.quiz-choices').querySelectorAll('.quiz-choice');
    choices.forEach(function(c){ c.classList.remove('selected'); });
    btn.classList.add('selected');
    document.getElementById('next' + step).classList.add('ready');
  }

  function getSelectedVal(step) {
    var sel = document.querySelector('#choices' + step + ' .quiz-choice.selected');
    return sel ? sel.dataset.val : null;
  }

  function updateProgress(step) {
    var pct = Math.round((step / TOTAL) * 100);
    document.getElementById('quizProgressFill').style.width = pct + '%';
    document.getElementById('quizProgressLabel').textContent = 'Schritt ' + step + ' von ' + TOTAL;
  }

  function showStep(n) {
    document.querySelectorAll('.quiz-step').forEach(function(s){ s.classList.remove('active'); });
    var el = document.getElementById('step' + n);
    if(el) el.classList.add('active');
    updateProgress(n);
    _current = n;
  }

  function nextStep(current) {
    var val = getSelectedVal(current);
    if(val === null) return;
    /* Step 6 (Budget) = next btn always ready (optional field), even empty val allowed */
    if(current === 1) _state.betrieb          = val;
    if(current === 2) _state.anfragen         = val;
    if(current === 3) _state.website_exists   = val;
    if(current === 4) _state.herausforderung  = val;
    if(current === 5) _state.zeitpunkt_wunsch = val;
    if(current === 6) _state.budget           = val;
    showStep(current + 1);
    document.querySelector('.quiz-card').scrollTop = 0;
  }
  function prevStep(current) {
    if(current <= 1) return;
    showStep(current - 1);
    document.querySelector('.quiz-card').scrollTop = 0;
  }

  /* Step 6 is optional → always make next ready when shown */
  (function(){
    var step6 = document.getElementById('step6');
    if(!step6) return;
    var obs = new MutationObserver(function(){
      if(step6.classList.contains('active')){
        document.getElementById('next6').classList.add('ready');
      }
    });
    obs.observe(step6, { attributes: true, attributeFilter: ['class'] });
  })();

  function buildNachricht() {
    return [
      'Betrieb: ' + _state.betrieb,
      'Anfragen/Monat: ' + _state.anfragen,
      'Website: ' + _state.website_exists,
      'Herausforderung: ' + _state.herausforderung,
      'Starttermin: ' + _state.zeitpunkt_wunsch,
      _state.budget ? 'Budget: ' + _state.budget : '',
    ].filter(Boolean).join(' | ');
  }

  function submitQuiz() {
    var vorname  = document.getElementById('field-vorname').value.trim();
    var nachname = document.getElementById('field-nachname').value.trim();
    var telefon  = document.getElementById('field-telefon').value.trim();
    var email    = document.getElementById('field-email').value.trim();
    var privacy  = document.getElementById('privacy-check').checked;

    if(!vorname)  { alert('Bitte Vorname eingeben.'); return; }
    if(!nachname) { alert('Bitte Nachname eingeben.'); return; }
    if(!telefon)  { alert('Bitte Telefonnummer eingeben.'); return; }
    if(!email)    { alert('Bitte E-Mail eingeben.'); return; }
    if(!privacy)  { alert('Bitte Datenschutzerklärung akzeptieren.'); return; }

    var btn = document.getElementById('quiz-submit-btn');
    btn.disabled = true;
    btn.textContent = 'Wird gesendet…';

    var payload = Object.assign({
      name:             vorname + ' ' + nachname,
      email:            email,
      telefon:          telefon,
      betrieb:          _state.betrieb,
      ziel:             'Komplettsystem (Website + Ads + KI)',
      anfragen:         _state.anfragen,
      website_exists:   _state.website_exists,
      zeitpunkt_wunsch: _state.zeitpunkt_wunsch,
      budget:           _state.budget || undefined,
      nachricht:        buildNachricht(),
      seite:            'galabau-mehr-kunden',
    }, _utm);

    fetch('https://fastraone-admin.vercel.app/api/leads', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    })
    .then(function(res) {
      if(!res.ok) throw new Error('HTTP ' + res.status);
      document.querySelectorAll('.quiz-step').forEach(function(s){ s.style.display = 'none'; });
      document.getElementById('quizProgressLabel').style.display = 'none';
      document.querySelector('.quiz-progress-bar').style.display = 'none';
      document.getElementById('quizSuccess').classList.add('show');
    })
    .catch(function() {
      btn.disabled = false;
      btn.textContent = 'Gespräch anfragen';
      alert('Etwas ist schiefgelaufen. Bitte ruf uns kurz an: +49 163 3781657');
    });
  }

  /* ─ FAQ Accordion ─ */
  function toggleFaq(btn) {
    var item = btn.closest('.faq__item');
    var answer = item.querySelector('.faq__a');
    var isOpen = item.classList.contains('open');
    document.querySelectorAll('.faq__item').forEach(function(i){
      i.classList.remove('open');
      i.querySelector('.faq__a').style.maxHeight = '0';
    });
    if(!isOpen) {
      item.classList.add('open');
      answer.style.maxHeight = answer.scrollHeight + 'px';
    }
  }

  /* ─ Reveal Animations ─ */
  var ro = new IntersectionObserver(function(entries){
    entries.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('visible'); ro.unobserve(e.target); } });
  }, { threshold: 0.07 });
  document.querySelectorAll('.reveal').forEach(function(el){ ro.observe(el); });
</script>
</BaseLayout>
