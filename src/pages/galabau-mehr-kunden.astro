---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="GaLaBau Hannover: Mehr Aufträge in 14 Tagen | Fastra One"
  description="Das vollständige Kundengewinnungssystem für GaLaBau-Betriebe in Hannover und Umgebung. Website, Google Ads, Funnel — komplett in 14 Tagen."
  navVariant="none"
  footerVariant="none"
>

  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <!-- ════ URGENCY BAR ════════════════════════════════════════════════ -->
  <div class="lp-topbar">
    <span class="lp-topbar__dot" aria-hidden="true"></span>
    <strong>Hannover &amp; Region</strong>
    <span class="lp-topbar__sep">·</span>
    <span>Noch <strong>1 Platz</strong> frei in deiner Region</span>
    <button class="lp-topbar__cta" onclick="openModal()">Platz sichern →</button>
  </div>

  <!-- ════ HERO ═══════════════════════════════════════════════════════ -->
  <section class="lp-hero">
    <div class="lp-hero__grid-bg" aria-hidden="true"></div>
    <div class="lp-hero__glow" aria-hidden="true"></div>

    <div class="container">
      <div class="lp-hero__center">

        <div class="lp-pill">
          <span class="lp-pill-dot" aria-hidden="true"></span>
          Exklusiv für GaLaBau-Betriebe in Hannover &amp; Umgebung
        </div>

        <h1 class="lp-h1">
          Du baust Gärten in Hannover.<br>
          <span class="lp-accent-grad">Wir bringen die Kunden.</span>
        </h1>

        <p class="lp-sub">
          Während Hannoveraner Hausbesitzer online nach deiner Leistung suchen,
          findet sie dein Wettbewerber — nicht du.
          <strong>Das ändert sich in 14 Tagen.</strong>
        </p>

        <!-- Offer strip -->
        <div class="lp-offer-strip">
          <div class="lp-offer-item">
            <span class="lp-offer-item__val">14</span>
            <span class="lp-offer-item__label">Tage bis live</span>
          </div>
          <div class="lp-offer-divider" aria-hidden="true"></div>
          <div class="lp-offer-item">
            <span class="lp-offer-item__val lp-offer-item__val--green">6.300 €+</span>
            <span class="lp-offer-item__label">Gesamtwert</span>
          </div>
          <div class="lp-offer-divider" aria-hidden="true"></div>
          <div class="lp-offer-item">
            <span class="lp-offer-item__val">100%</span>
            <span class="lp-offer-item__label">GaLaBau-Fokus</span>
          </div>
          <div class="lp-offer-divider" aria-hidden="true"></div>
          <div class="lp-offer-item">
            <span class="lp-offer-item__val lp-offer-item__val--green">1×</span>
            <span class="lp-offer-item__label">pro Region</span>
          </div>
        </div>

        <!-- CTAs -->
        <div class="lp-cta-row">
          <button class="btn lp-btn-primary" onclick="openModal()">
            Platz in Hannover sichern
            <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
          <a href="tel:+491633781657" class="btn lp-btn-ghost">
            <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Direkt anrufen
          </a>
        </div>

        <div class="lp-guarantee-line">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/></svg>
          Kostenlos &amp; unverbindlich · Ergebnis-Garantie · DSGVO-konform
        </div>

      </div>
    </div>

    <div class="lp-wave" aria-hidden="true">
      <svg viewBox="0 0 1440 80" preserveAspectRatio="none"><path d="M0,0 C360,80 1080,80 1440,0 L1440,80 L0,80 Z" fill="#f5f5f5"/></svg>
    </div>
  </section>

  <!-- ════ MID: STEPS ═════════════════════════════════════════════════ -->
  <section class="lp-mid reveal">
    <div class="container">
      <div class="lp-steps-row">
        <div class="lp-step-sm">
          <span class="lp-step-sm__n">01</span>
          <strong>Eignung prüfen</strong>
          <span>2 Min · kostenlos · für Hannover</span>
        </div>
        <div class="lp-step-sm__conn" aria-hidden="true"></div>
        <div class="lp-step-sm">
          <span class="lp-step-sm__n">02</span>
          <strong>System aufbauen</strong>
          <span>Wir machen alles in 14 Tagen</span>
        </div>
        <div class="lp-step-sm__conn" aria-hidden="true"></div>
        <div class="lp-step-sm">
          <span class="lp-step-sm__n">03</span>
          <strong>Anfragen aus Hannover</strong>
          <span>Qualifiziert, direkt aufs Handy</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ════ PROBLEM ════════════════════════════════════════════════════ -->
  <section class="lp-prob">
    <div class="container">
      <p class="lp-eyebrow" style="text-align:center">Klingt das bekannt?</p>
      <h2 class="lp-offer-h2" style="text-align:center;margin-bottom:36px;">Warum dein Auftragsbuch<br>nicht voll wird.</h2>
      <div class="lp-prob-g">
        <div class="lp-prob-c reveal">
          <div class="lp-prob-ico">📅</div>
          <h3>Sonntagabend, Kalender halb leer</h3>
          <p>Du weißt nicht, was nächsten Monat kommt. Das Auftragsbuch hängt vom Zufall ab — das schläft sich schlecht.</p>
        </div>
        <div class="lp-prob-c reveal">
          <div class="lp-prob-ico">📢</div>
          <h3>Weiterempfehlung als einziger Vertrieb</h3>
          <p>Läuft gut, solange Stammkunden aktiv sind. Aber das ist kein Geschäftsmodell — das ist Glück. Und Glück skaliert nicht.</p>
        </div>
        <div class="lp-prob-c reveal">
          <div class="lp-prob-ico">💸</div>
          <h3>Geld für Werbung verbrannt</h3>
          <p>Du hast schon was versucht. Ergebnis: schmerzhaft wenig für das investierte Geld. Keine Strategie, keine Ergebnisse.</p>
        </div>
        <div class="lp-prob-c reveal">
          <div class="lp-prob-ico">🔍</div>
          <h3>Dein Wettbewerber steht oben</h3>
          <p>Er macht schlechtere Arbeit. Aber er wirkt online professioneller, steht bei Google oben — und bekommt die Aufträge die dir fehlen.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ════ GRAND SLAM OFFER ══════════════════════════════════════════ -->
  <section class="lp-offer-section">
    <div class="container">

      <div class="lp-offer-hd">
        <span class="lp-eyebrow">Das GaLaBau-Vertriebssystem</span>
        <h2 class="lp-offer-h2">Alles was du brauchst.<br>Einmal. Komplett. Sofort.</h2>
        <p class="lp-offer-p">Du kaufst keine Einzelleistungen. Du bekommst ein vollständiges System — das rund um die Uhr neue Aufträge aus Hannover generiert.</p>
      </div>

      <div class="lp-vstack">
        <div class="lp-vstack__item">
          <div class="lp-vstack__check" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div class="lp-vstack__text">
            <strong>Premium GaLaBau-Website</strong>
            <span>Schnell, mobil-optimiert, speziell für deine Branche gebaut — kein Baukasten</span>
          </div>
          <div class="lp-vstack__val">2.500 €</div>
        </div>
        <div class="lp-vstack__item">
          <div class="lp-vstack__check" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div class="lp-vstack__text">
            <strong>Google Ads Kampagne (Setup)</strong>
            <span>Keyword-Recherche, Anzeigen, Gebotsstrategie — für Hannover und Umgebung</span>
          </div>
          <div class="lp-vstack__val">1.200 €</div>
        </div>
        <div class="lp-vstack__item">
          <div class="lp-vstack__check" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div class="lp-vstack__text">
            <strong>Conversion-Landingpage</strong>
            <span>Eine Seite, die auf Anfragen optimiert ist — kein Branding, ein Werkzeug</span>
          </div>
          <div class="lp-vstack__val">800 €</div>
        </div>
        <div class="lp-vstack__item">
          <div class="lp-vstack__check" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div class="lp-vstack__text">
            <strong>Qualifizierungs-Funnel</strong>
            <span>Interessenten qualifizieren sich selbst — du sprichst nur mit echten Kaufinteressenten</span>
          </div>
          <div class="lp-vstack__val">600 €</div>
        </div>
        <div class="lp-vstack__item">
          <div class="lp-vstack__check" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div class="lp-vstack__text">
            <strong>Verkaufsstarke GaLaBau-Texte</strong>
            <span>Copywriting auf Conversion-Niveau — für deine Kunden formuliert, nicht für Marketingmanager</span>
          </div>
          <div class="lp-vstack__val">400 €</div>
        </div>
        <div class="lp-vstack__item">
          <div class="lp-vstack__check" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div class="lp-vstack__text">
            <strong>Ads-Betreuung (1. Monat)</strong>
            <span>Optimierung, Reporting, Anpassungen — wir steuern, du schaust die Ergebnisse an</span>
          </div>
          <div class="lp-vstack__val">500 €</div>
        </div>
        <div class="lp-vstack__item">
          <div class="lp-vstack__check" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div class="lp-vstack__text">
            <strong>DSGVO + Conversion Tracking</strong>
            <span>Rechtssicheres Setup, WhatsApp-Integration, vollständiges Tracking</span>
          </div>
          <div class="lp-vstack__val">300 €</div>
        </div>

        <!-- Total row -->
        <div class="lp-vstack__total">
          <div class="lp-vstack__total-l">
            <span class="lp-vstack__total-label">Gesamtwert</span>
            <span class="lp-vstack__total-hint">wenn du das einzeln beauftragen würdest</span>
          </div>
          <div class="lp-vstack__total-val">6.300 €+</div>
        </div>
      </div>

      <!-- Guarantee + Scarcity -->
      <div class="lp-guar-row">
        <div class="lp-guar-box">
          <div class="lp-guar-box__ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><polyline points="9 12 11 14 15 10"/></svg>
          </div>
          <div>
            <strong>Ergebnis-Garantie</strong>
            <span>Wenn das System läuft und keine qualifizierten Anfragen kommen: wir optimieren weiter — ohne Aufpreis. Solange, bis es funktioniert.</span>
          </div>
        </div>
        <div class="lp-guar-box lp-guar-box--accent">
          <div class="lp-guar-box__ico" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 0 1-2.827 0l-4.244-4.243a8 8 0 1 1 11.314 0z"/><circle cx="12" cy="11" r="3"/></svg>
          </div>
          <div>
            <strong>Exklusiv für Hannover</strong>
            <span>Wir arbeiten nur mit <em>einem</em> GaLaBau-Betrieb pro Region. In Hannover ist noch <strong>1 Platz frei</strong>.</span>
          </div>
        </div>
      </div>

      <div style="text-align:center;margin-top:40px;">
        <button class="lp-price-new__cta" style="max-width:420px;margin:0 auto;" onclick="openModal()">
          Platz in Hannover sichern — kostenlos prüfen
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
        <p style="font-size:.76rem;color:var(--gray-2);margin-top:10px;">Kein Druck · Antwort in 24 h · Kein Spam</p>
      </div>

    </div>
  </section>

  <!-- ════ TESTIMONIALS ════════════════════════════════════════════════ -->
  <section class="lp-tst-sec">
    <div class="container">
      <p class="lp-eyebrow" style="text-align:center">Was GaLaBau-Betriebe sagen</p>
      <h2 class="lp-offer-h2" style="text-align:center;margin-bottom:40px;">Erste Bewertungen folgen.<br>Deine könnte die erste sein.</h2>
      <div class="lp-tst-g">
        <div class="lp-tst-c reveal">
          <div class="lp-tst-tag">Folgt bald</div>
          <div class="lp-tst-stars">★★★★★</div>
          <p class="lp-tst-q">&nbsp;</p>
          <div class="lp-tst-a">
            <div class="lp-tst-av">G</div>
            <div><strong>GaLaBau-Betrieb</strong><span>Hannover</span></div>
          </div>
        </div>
        <div class="lp-tst-c reveal">
          <div class="lp-tst-tag">Folgt bald</div>
          <div class="lp-tst-stars">★★★★★</div>
          <p class="lp-tst-q">&nbsp;</p>
          <div class="lp-tst-a">
            <div class="lp-tst-av">G</div>
            <div><strong>GaLaBau-Betrieb</strong><span>Hannover</span></div>
          </div>
        </div>
        <div class="lp-tst-c reveal">
          <div class="lp-tst-tag">Folgt bald</div>
          <div class="lp-tst-stars">★★★★★</div>
          <p class="lp-tst-q">&nbsp;</p>
          <div class="lp-tst-a">
            <div class="lp-tst-av">G</div>
            <div><strong>GaLaBau-Betrieb</strong><span>Hannover</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════ DARK SECTION: FINAL CTA ═══════════════════════════════════ -->
  <section class="lp-testi-section">
    <div class="lp-testi__mesh" aria-hidden="true"></div>
    <div class="container" style="position:relative;z-index:1">

      <div class="lp-testi-card reveal">
        <div class="lp-testi-card__glow" aria-hidden="true"></div>
        <div class="lp-testi__stars" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="#4ade80" width="20" height="20"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4" fill="none" stroke="#06351e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <blockquote class="lp-testi__quote">
          "Jetzt gerade suchen Hannoveraner Hausbesitzer auf Google nach einem
          GaLaBau-Betrieb in ihrer Nähe. <strong>Wer steht da oben?
          Dein Wettbewerber — oder du.</strong>"
        </blockquote>
        <p style="font-size:.85rem;color:rgba(255,255,255,.45);margin-bottom:28px;line-height:1.65;">
          In 14 Tagen ist dein System live. Website, Anzeigen, Funnel — alles läuft.
          Du nimmst die Gespräche entgegen und wählst die besten Aufträge aus.
        </p>
        <div class="lp-testi__cta-row">
          <button class="lp-price-new__cta" style="max-width:400px" onclick="openModal()">
            Jetzt Platz sichern &amp; Eignung prüfen
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
        </div>
      </div>

      <div class="lp-final-cta reveal">
        <div class="lp-final-cta__text">
          <strong>Für Hannover &amp; Region</strong>
          <span>Kostenlos · 2 Minuten · Noch 1 Platz frei</span>
        </div>
        <button class="lp-final-cta__btn" onclick="openModal()">
          Platz sichern →
        </button>
      </div>

    </div>
  </section>

  <!-- ════ FOOTER ══════════════════════════════════════════════════════ -->
  <footer class="lp-footer">
    <p>
      © 2026 Fastra One · Paul Niklas Fasterding · Am Flachsgraben 9, 30657 Hannover ·
      <a href="/impressum">Impressum</a> ·
      <a href="/datenschutz">Datenschutz</a>
    </p>
  </footer>

  <!-- ════ MODAL (8-Step Quiz) ════════════════════════════════════════ -->
  <div class="lp-modal-bg" id="modal-bg" aria-hidden="true" onclick="closeModal(event)">
    <div class="lp-modal" role="dialog" aria-modal="true" aria-label="Eignung prüfen">
      <button class="lp-modal__close" onclick="closeModal()" aria-label="Schließen">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>

      <div class="lp-modal__inner">

        <div id="qz-prog-wrap" style="display:none">
          <div class="lp-progress" role="progressbar" aria-label="Fortschritt">
            <div class="lp-progress__fill" id="qz-fill" style="width:12.5%"></div>
          </div>
          <p class="lp-form-sub" id="qz-label">Schritt 1 von 8</p>
        </div>

        <!-- STEP 0: Intro -->
        <div class="lp-step-content lp-step-content--active" id="qz-0">
          <div class="lp-modal__head" style="text-align:center;padding-bottom:4px;">
            <div style="width:52px;height:52px;border-radius:16px;background:rgba(22,165,102,.1);display:flex;align-items:center;justify-content:center;margin:0 auto 18px;">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#16a566" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            </div>
            <div class="lp-modal__title">Prüfe deine Eignung.</div>
            <div class="lp-modal__sub">Wir nehmen nicht jeden an. 8 ehrliche Fragen — dann sagen wir dir klar, ob und wie wir dir helfen können.</div>
          </div>
          <div style="display:flex;align-items:center;gap:7px;padding:10px 14px;background:rgba(22,165,102,.07);border:1px solid rgba(22,165,102,.18);border-radius:10px;font-size:.8rem;font-weight:700;color:#16a566;margin:18px 0 24px;">
            <span style="width:7px;height:7px;border-radius:50%;background:#16a566;animation:lpPulse 1.5s infinite;flex:none;"></span>
            Hannover: Noch 1 von 5 Plätzen verfügbar
          </div>
          <button class="btn lp-btn-modal-next" onclick="qzStart()">
            Jetzt starten
            <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
          <p style="text-align:center;font-size:.75rem;color:var(--gray-2);margin-top:12px;">Dauert 2 Minuten · Kostenlos · Kein Spam</p>
        </div>

        <!-- STEP 1 -->
        <div class="lp-step-content" id="qz-1">
          <p class="lp-q">Wie groß ist dein Betrieb aktuell?</p>
          <div class="lp-choices">
            <button class="lp-choice" data-qz="betrieb" data-val="Solo (nur ich)">Solo (nur ich)</button>
            <button class="lp-choice" data-qz="betrieb" data-val="2–5 Mitarbeiter">2–5 Mitarbeiter</button>
            <button class="lp-choice" data-qz="betrieb" data-val="6–15 Mitarbeiter">6–15 Mitarbeiter</button>
            <button class="lp-choice" data-qz="betrieb" data-val="Mehr als 15">Mehr als 15</button>
          </div>
          <div class="lp-qnav"><button class="lp-qback" onclick="qzGo(0)">← Zurück</button><button class="lp-btn-modal-next lp-qnxt" id="qz-nxt-1" onclick="qzGo(2)" disabled>Weiter →</button></div>
        </div>

        <!-- STEP 2 -->
        <div class="lp-step-content" id="qz-2">
          <p class="lp-q">Aus welcher Region kommst du?</p>
          <p style="font-size:.8rem;color:var(--gray-2);margin:-6px 0 14px;">Wir prüfen, ob deine Region noch frei ist.</p>
          <div class="lp-choices">
            <button class="lp-choice" data-qz="region" data-val="Hannover & Region">Hannover &amp; Region<br><small style="font-weight:500;color:var(--gray-2)">Hannover, Langenhagen, Garbsen…</small></button>
            <button class="lp-choice" data-qz="region" data-val="Norddeutschland">Norddeutschland<br><small style="font-weight:500;color:var(--gray-2)">HH, HB, SH, MV, NI</small></button>
            <button class="lp-choice" data-qz="region" data-val="Westdeutschland">Westdeutschland<br><small style="font-weight:500;color:var(--gray-2)">NRW, RP, SL</small></button>
            <button class="lp-choice" data-qz="region" data-val="Süd/Mitteldeutschland">Süd / Mitte<br><small style="font-weight:500;color:var(--gray-2)">BY, BW, HE, SN…</small></button>
          </div>
          <div class="lp-qnav"><button class="lp-qback" onclick="qzGo(1)">← Zurück</button><button class="lp-btn-modal-next lp-qnxt" id="qz-nxt-2" onclick="qzGo(3)" disabled>Weiter →</button></div>
        </div>

        <!-- STEP 3 -->
        <div class="lp-step-content" id="qz-3">
          <p class="lp-q">Wie viele Kundenanfragen bekommst du pro Monat?</p>
          <div class="lp-choices" style="grid-template-columns:1fr;">
            <button class="lp-choice" data-qz="anfragen" data-val="Kaum welche (0–3)">Kaum welche (0–3)</button>
            <button class="lp-choice" data-qz="anfragen" data-val="Ein paar (4–10)">Ein paar (4–10)</button>
            <button class="lp-choice" data-qz="anfragen" data-val="Genug, aber oft unqualifiziert">Genug, aber oft unqualifiziert</button>
          </div>
          <div class="lp-qnav"><button class="lp-qback" onclick="qzGo(2)">← Zurück</button><button class="lp-btn-modal-next lp-qnxt" id="qz-nxt-3" onclick="qzGo(4)" disabled>Weiter →</button></div>
        </div>

        <!-- STEP 4 -->
        <div class="lp-step-content" id="qz-4">
          <p class="lp-q">Hast du bereits eine professionelle Website?</p>
          <div class="lp-choices" style="grid-template-columns:1fr;">
            <button class="lp-choice" data-qz="website" data-val="Noch keine Website">Noch keine</button>
            <button class="lp-choice" data-qz="website" data-val="Ja, veraltet oder ohne Ergebnis">Ja, aber veraltet oder ohne Ergebnis</button>
            <button class="lp-choice" data-qz="website" data-val="Ja, moderne Website">Ja, moderne Website</button>
          </div>
          <div class="lp-qnav"><button class="lp-qback" onclick="qzGo(3)">← Zurück</button><button class="lp-btn-modal-next lp-qnxt" id="qz-nxt-4" onclick="qzGo(5)" disabled>Weiter →</button></div>
        </div>

        <!-- STEP 5 -->
        <div class="lp-step-content" id="qz-5">
          <p class="lp-q">Hast du schon mal Google Ads ausprobiert?</p>
          <div class="lp-choices" style="grid-template-columns:1fr;">
            <button class="lp-choice" data-qz="ads_exp" data-val="Noch nie">Noch nie ausprobiert</button>
            <button class="lp-choice" data-qz="ads_exp" data-val="Ja, ohne Erfolg">Ja, aber ohne richtiges Ergebnis</button>
            <button class="lp-choice" data-qz="ads_exp" data-val="Ja, mit Erfolg">Ja, mit etwas Erfolg</button>
          </div>
          <div class="lp-qnav"><button class="lp-qback" onclick="qzGo(4)">← Zurück</button><button class="lp-btn-modal-next lp-qnxt" id="qz-nxt-5" onclick="qzGo(6)" disabled>Weiter →</button></div>
        </div>

        <!-- STEP 6 -->
        <div class="lp-step-content" id="qz-6">
          <p class="lp-q">Wann möchtest du starten?</p>
          <div class="lp-choices" style="grid-template-columns:1fr;">
            <button class="lp-choice" data-qz="start" data-val="Sofort / dringend">So schnell wie möglich</button>
            <button class="lp-choice" data-qz="start" data-val="In den nächsten 3 Monaten">In den nächsten 3 Monaten</button>
            <button class="lp-choice" data-qz="start" data-val="Erst mal informieren">Ich möchte mich erst informieren</button>
          </div>
          <div class="lp-qnav"><button class="lp-qback" onclick="qzGo(5)">← Zurück</button><button class="lp-btn-modal-next lp-qnxt" id="qz-nxt-6" onclick="qzGo(7)" disabled>Weiter →</button></div>
        </div>

        <!-- STEP 7 -->
        <div class="lp-step-content" id="qz-7">
          <p class="lp-q">Welches monatliche Budget planst du für Marketing?</p>
          <p style="font-size:.8rem;color:var(--gray-2);margin:-6px 0 14px;">Optional — hilft uns zur Vorbereitung.</p>
          <div class="lp-choices" style="grid-template-columns:1fr;">
            <button class="lp-choice" data-qz="budget" data-val="">Das ist noch offen</button>
            <button class="lp-choice" data-qz="budget" data-val="Bis 500 €/Monat">Bis 500 €/Monat</button>
            <button class="lp-choice" data-qz="budget" data-val="500–1.500 €/Monat">500–1.500 €/Monat</button>
            <button class="lp-choice" data-qz="budget" data-val="Über 1.500 €/Monat">Über 1.500 €/Monat</button>
          </div>
          <div class="lp-qnav"><button class="lp-qback" onclick="qzGo(6)">← Zurück</button><button class="lp-btn-modal-next lp-qnxt lp-qnxt--always" id="qz-nxt-7" onclick="qzGo(8)">Weiter →</button></div>
        </div>

        <!-- STEP 8: Kontakt -->
        <div class="lp-step-content" id="qz-8">
          <p class="lp-q">Fast geschafft — wohin sollen wir uns melden?</p>
          <p style="font-size:.8rem;color:var(--gray-2);margin:-6px 0 18px;">Wir melden uns persönlich in 24 h — nicht automatisch.</p>
          <input type="text"  class="lp-input" id="qz-vn"   placeholder="Vorname *" autocomplete="given-name">
          <input type="text"  class="lp-input" id="qz-nn"   placeholder="Nachname *" autocomplete="family-name">
          <input type="tel"   class="lp-input" id="qz-tel"  placeholder="Telefon * (+49 …)" autocomplete="tel">
          <input type="email" class="lp-input" id="qz-mail" placeholder="E-Mail (optional)" autocomplete="email">
          <label class="lp-privacy">
            <input type="checkbox" id="qz-priv">
            <span>Ich stimme der Verarbeitung meiner Daten gemäß der <a href="/datenschutz" target="_blank" rel="noopener">Datenschutzerklärung</a> zu.</span>
          </label>
          <div class="lp-qnav" style="margin-top:4px;">
            <button class="lp-qback" onclick="qzGo(7)">← Zurück</button>
            <button class="btn lp-btn-modal-next" id="qz-sub" onclick="qzSubmit()" style="flex:1;">Platz jetzt sichern →</button>
          </div>
        </div>

        <!-- SUCCESS -->
        <div class="lp-success" id="qz-succ" aria-live="polite">
          <span class="lp-success__icon" aria-hidden="true">✅</span>
          <h3>Platz gesichert!</h3>
          <p>Wir melden uns innerhalb von <strong>24 Stunden</strong> persönlich bei dir — nicht per Autoresponder.</p>
        </div>
      </div>
    </div>
  </div>

  <Fragment slot="scripts">
    <script is:inline>
    var _urlp = new URLSearchParams(window.location.search);
    var _utm = {
      utm_source:   _urlp.get('utm_source')   || undefined,
      utm_medium:   _urlp.get('utm_medium')   || undefined,
      utm_campaign: _urlp.get('utm_campaign') || undefined,
      utm_term:     _urlp.get('utm_term')     || undefined,
      utm_content:  _urlp.get('utm_content')  || undefined,
      referrer:     document.referrer         || undefined,
      geraet:       window.innerWidth < 768   ? 'mobil' : 'desktop'
    };
    var _qd = { betrieb:'', region:'', anfragen:'', website:'', ads_exp:'', start:'', budget:'' };
    var _qCur = 0;
    var QZTOTAL = 8;

    function openModal() {
      document.getElementById('modal-bg').classList.add('lp-modal-bg--open');
      document.body.style.overflow = 'hidden';
    }
    function closeModal(e) {
      if (e && e.target !== document.getElementById('modal-bg') && !e.target.closest('.lp-modal__close')) return;
      document.getElementById('modal-bg').classList.remove('lp-modal-bg--open');
      document.body.style.overflow = '';
    }
    document.addEventListener('keydown', function(e){ if(e.key==='Escape') closeModal({target:document.getElementById('modal-bg')}); });

    function qzStart() {
      document.getElementById('qz-prog-wrap').style.display = '';
      qzGo(1);
    }
    function qzGo(n) {
      document.getElementById('qz-' + _qCur).classList.remove('lp-step-content--active');
      _qCur = n;
      var el = document.getElementById('qz-' + n);
      el.classList.remove('lp-step-content--active');
      void el.offsetWidth;
      el.classList.add('lp-step-content--active');
      if (n > 0) {
        document.getElementById('qz-fill').style.width = Math.round((n / QZTOTAL) * 100) + '%';
        document.getElementById('qz-label').textContent = 'Schritt ' + n + ' von ' + QZTOTAL;
      }
      document.querySelector('.lp-modal').scrollTop = 0;
    }
    document.querySelectorAll('.lp-choice[data-qz]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var key = btn.dataset.qz;
        document.querySelectorAll('.lp-choice[data-qz="' + key + '"]').forEach(function(b){ b.classList.remove('lp-choice--selected'); });
        btn.classList.add('lp-choice--selected');
        _qd[key] = btn.dataset.val;
        var stepNum = parseInt(btn.closest('.lp-step-content').id.replace('qz-', ''), 10);
        var nxt = document.getElementById('qz-nxt-' + stepNum);
        if (nxt && !nxt.classList.contains('lp-qnxt--always')) nxt.disabled = false;
      });
    });
    /* Budget step: always-enabled next btn */
    var alwaysNxt = document.getElementById('qz-nxt-7');
    if (alwaysNxt) alwaysNxt.disabled = false;

    function qzSubmit() {
      var vn = document.getElementById('qz-vn').value.trim();
      var nn = document.getElementById('qz-nn').value.trim();
      var tel = document.getElementById('qz-tel').value.trim();
      var mail = document.getElementById('qz-mail').value.trim();
      var priv = document.getElementById('qz-priv').checked;
      if (!vn)   { alert('Bitte Vorname angeben.'); return; }
      if (!nn)   { alert('Bitte Nachname angeben.'); return; }
      if (!tel)  { alert('Bitte Telefonnummer angeben.'); return; }
      if (!priv) { alert('Bitte Datenschutzerklärung akzeptieren.'); return; }
      var sub = document.getElementById('qz-sub');
      sub.disabled = true; sub.textContent = 'Wird gesendet…';
      var nachricht = ['Betrieb: '+_qd.betrieb,'Region: '+_qd.region,'Anfragen: '+_qd.anfragen,'Website: '+_qd.website,'Ads: '+_qd.ads_exp,'Start: '+_qd.start,_qd.budget?'Budget: '+_qd.budget:''].filter(Boolean).join(' | ');
      var payload = Object.assign({ name:vn+' '+nn, email:mail||undefined, telefon:tel, betrieb:_qd.betrieb, ziel:'GaLaBau Komplettsystem Hannover', anfragen:_qd.anfragen, website_exists:_qd.website, zeitpunkt_wunsch:_qd.start, budget:_qd.budget||undefined, nachricht:nachricht, seite:'galabau-mehr-kunden' }, _utm);
      fetch('https://fastraone-admin.vercel.app/api/leads', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload) })
      .then(function(r){ if(!r.ok) throw new Error(r.status); })
      .then(function() {
        document.getElementById('qz-prog-wrap').style.display = 'none';
        document.getElementById('qz-8').classList.remove('lp-step-content--active');
        document.getElementById('qz-succ').style.display = 'block';
      }).catch(function() {
        sub.disabled = false; sub.textContent = 'Platz jetzt sichern →';
        alert('Fehler beim Senden. Ruf uns an: +49 163 3781657');
      });
    }
    var ro = new IntersectionObserver(function(entries) {
      entries.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('is-visible'); ro.unobserve(e.target); } });
    }, { threshold:0.07 });
    document.querySelectorAll('.reveal').forEach(function(el){ ro.observe(el); });
    </script>
  </Fragment>

</BaseLayout>

<style is:global>
.lp-topbar {
