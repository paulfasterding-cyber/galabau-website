---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Kostenloses Erstgespräch für GaLaBau-Betriebe buchen | Fastra One Hannover"
  description="Jetzt kostenloses Erstgespräch mit Fastra One buchen. Webdesign-Agentur aus Hannover für Garten- und Landschaftsbau. 15 Minuten, kein Verkaufsdruck."
  canonical="https://fastraone.de/kontakt.html"
  navVariant="minimal"
  footerVariant="full"
>
  <Fragment slot="head">
    <meta name="robots" content="index, follow" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%230a4ff0'/%3E%3Ctext x='50%25' y='53%25' dominant-baseline='middle' text-anchor='middle' font-family='Arial,sans-serif' font-size='36' font-weight='800' fill='white'%3EF%3C/text%3E%3C/svg%3E" />
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://fastraone.de/" },
            { "@type": "ListItem", "position": 2, "name": "Kontakt & Erstgespräch" }
          ]
        },
        {
          "@type": "ContactPage",
          "name": "Kostenloses Erstgespräch bei Fastra One Hannover",
          "url": "https://fastraone.de/kontakt.html",
          "description": "Termin für kostenloses Erstgespräch mit Fastra One buchen. Webdesign-Agentur aus Hannover für Garten- und Landschaftsbau.",
          "mainEntity": {
            "@type": "LocalBusiness",
            "name": "Fastra One",
            "telephone": "+49 163 3781657",
            "email": "paul.web@outlook.de",
            "address": {
              "@type": "PostalAddress",
              "streetAddress": "Am Flachsgraben 9",
              "postalCode": "30657",
              "addressLocality": "Hannover",
              "addressCountry": "DE"
            }
          }
        }
      ]
    }
    </script>
  </Fragment>

  <style is:global>
/* LIGHT PAGE, dark cards */
.container{max-width:760px}
.nav2{max-width:760px}
.head{padding:56px 0 36px;text-align:center}
.head h1{font-size:clamp(2rem,5.5vw,3rem);line-height:1.08;max-width:none;color:var(--ink)}
.head p{margin:14px auto 0;max-width:52ch;font-size:1.08rem;color:var(--gray)}

.choice{display:flex;justify-content:center;gap:8px;margin:30px auto 0;max-width:520px;background:rgba(0,0,0,.04);border:1px solid rgba(0,0,0,.08);padding:6px;border-radius:var(--pill)}
.choice__btn{flex:1;display:inline-flex;align-items:center;justify-content:center;gap:9px;border:none;cursor:pointer;background:transparent;color:rgba(0,0,0,.45);font-family:var(--f-body);font-weight:600;font-size:1rem;padding:13px 14px;border-radius:var(--pill);transition:background .2s,color .2s}
.choice__btn[aria-selected="true"]{background:rgba(110,236,157,.18);color:#1a7a45;box-shadow:none}
.choice__btn .ic{width:18px;height:18px}

.panel{max-width:620px;margin:28px auto 0}
.panel[hidden]{display:none}
.pcard{background:linear-gradient(145deg,rgba(18,24,50,.9),rgba(11,15,26,.9));border:1px solid rgba(255,255,255,.08);border-radius:24px;padding:clamp(24px,4vw,40px);box-shadow:0 8px 40px rgba(0,0,0,.45)}

.pcard h2{font-family:var(--f-head);font-size:1.5rem;font-weight:800;letter-spacing:-.02em;color:#fff}
.pcard>p{margin-top:10px;color:rgba(255,255,255,.52)}
.perks{list-style:none;margin:22px 0 26px;display:flex;flex-direction:column;gap:13px}
.perks li{position:relative;padding-left:30px;color:rgba(255,255,255,.7)}
.perks li::before{content:"";position:absolute;left:0;top:3px;width:18px;height:18px;-webkit-mask:var(--mask-check) center/contain no-repeat;mask:var(--mask-check) center/contain no-repeat;background:#6EEC9D}

.progress{height:7px;background:rgba(255,255,255,.07);border-radius:var(--pill);overflow:hidden;margin-bottom:6px}
.progress__bar{height:100%;width:0;background:linear-gradient(90deg,#56e592,#2bcf78);border-radius:var(--pill);transition:width .35s cubic-bezier(.16,1,.3,1)}
.progress__txt{font-size:.8rem;color:rgba(255,255,255,.32);font-weight:600;margin-bottom:22px}
.fstep{animation:fade .35s ease}
.fstep[hidden]{display:none}
@keyframes fade{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.fstep h3{font-family:var(--f-head);font-size:1.5rem;font-weight:800;letter-spacing:-.02em;line-height:1.2;color:#fff}
.fstep .hint{margin-top:6px;color:rgba(255,255,255,.45);font-size:.95rem}
.opts{display:grid;grid-template-columns:1fr;gap:11px;margin-top:22px}
.opt{display:flex;align-items:center;gap:12px;text-align:left;background:rgba(255,255,255,.04);border:1.5px solid rgba(255,255,255,.09);border-radius:14px;padding:16px 18px;font-family:var(--f-body);font-size:1rem;font-weight:600;color:rgba(255,255,255,.78);cursor:pointer;transition:border-color .15s,background .15s}
.opt:hover{border-color:rgba(110,236,157,.4);background:rgba(110,236,157,.06)}
.opt.is-sel{border-color:#6EEC9D;background:rgba(110,236,157,.08);box-shadow:0 0 0 3px rgba(110,236,157,.1)}
.opt__tick{width:22px;height:22px;border-radius:50%;border:2px solid rgba(255,255,255,.2);flex:none;display:grid;place-items:center;transition:all .15s}
.opt.is-sel .opt__tick{background:#6EEC9D;border-color:#6EEC9D}
.opt.is-sel .opt__tick::after{content:"";width:9px;height:9px;border-radius:50%;background:#0b0f1a}
@media(min-width:520px){.opts--2{grid-template-columns:1fr 1fr}}
.field{display:flex;flex-direction:column;gap:7px;margin-bottom:15px}
.field label{font-size:.9rem;font-weight:600;color:rgba(255,255,255,.55)}
.field input,.field textarea{width:100%;font-family:var(--f-body);font-size:1rem;color:#fff;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:12px;padding:13px 15px;transition:border-color .15s,box-shadow .15s}
.field input::placeholder,.field textarea::placeholder{color:rgba(255,255,255,.28)}
.field input:focus,.field textarea:focus{outline:none;border-color:#6EEC9D;box-shadow:0 0 0 3px rgba(110,236,157,.14)}
.field textarea{resize:vertical;min-height:96px}
.fnav{display:flex;gap:12px;margin-top:24px}
.fnav .btn{flex:1}
.consent{display:flex;align-items:flex-start;gap:10px;margin-top:4px;font-size:.85rem;color:rgba(255,255,255,.35);line-height:1.5}
.consent input{margin-top:3px;width:17px;height:17px;flex:none;accent-color:#6EEC9D}
.consent a{color:#6EEC9D;text-decoration:underline}
.done{text-align:center;padding:18px 0}
.done__ic{width:66px;height:66px;border-radius:50%;background:#6EEC9D;display:grid;place-items:center;margin:0 auto 18px}
.done__ic svg{width:32px;height:32px;stroke:#0b0f1a;stroke-width:3;fill:none}
.done h3{font-family:var(--f-head);font-size:1.6rem;font-weight:800;color:#fff}
.done p{margin-top:10px;color:rgba(255,255,255,.52)}

.cal-gate{text-align:center}
.cal-gate p{color:rgba(255,255,255,.52);font-size:.9rem;line-height:1.55;margin:0 auto 18px;max-width:46ch}
.cal-gate .cal-alt{display:inline-block;margin-top:14px;font-size:.85rem;color:rgba(255,255,255,.35);text-decoration:underline}
.cal-gate .cal-alt:hover{color:#6EEC9D}
.cal-embed{border-radius:14px;overflow:hidden;min-height:860px}
@media(max-width:560px){.cal-embed{min-height:1000px}}

.direct{margin:40px auto 72px;display:flex;flex-wrap:wrap;justify-content:center;gap:16px 36px}
.direct a{display:inline-flex;align-items:center;gap:9px;color:rgba(0,0,0,.45);font-weight:600}
.direct a:hover{color:#1a7a45}
.direct .ic{width:19px;height:19px;color:#6EEC9D}

html:not(.js) .fstep[hidden]{display:block!important}
  </style>

  <main>
    <section class="head">
      <div class="container">
        <h1>Lass uns über mehr Aufträge reden.</h1>
        <p>Wähle, was dir lieber ist: direkt einen Termin buchen oder in 30 Sekunden eine Anfrage starten. Beides unverbindlich.</p>
      </div>
    </section>

    <div class="container">
      <div class="choice" role="tablist" aria-label="Kontaktart">
        <button class="choice__btn" id="tab-termin" role="tab" aria-selected="false" aria-controls="panel-termin">
          <svg class="ic" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          Termin buchen
        </button>
        <button class="choice__btn" id="tab-anfrage" role="tab" aria-selected="true" aria-controls="panel-anfrage">
          <svg class="ic" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 13h6M9 17h4"/></svg>
          Anfrage starten
        </button>
      </div>

      <!-- TERMIN -->
      <div class="panel" id="panel-termin" role="tabpanel" aria-labelledby="tab-termin" hidden>
        <div class="pcard">
          <h2>Kostenloses Erstgespräch buchen</h2>
          <p>Such dir einen freien Slot, ca. 15 Minuten, unverbindlich. Wir schauen uns deinen Betrieb an und zeigen, wo Anfragen liegen bleiben.</p>
          <ul class="perks">
            <li>Konkrete Einschätzung statt allgemeiner Tipps</li>
            <li>Kostenlose Website- &amp; Sichtbarkeits-Analyse</li>
            <li>Kein Verkaufsdruck, du entscheidest in Ruhe</li>
          </ul>
          <div id="calGate" class="cal-gate">
            <p>Für die Online-Terminbuchung binden wir Calendly ein. Beim Laden wird eine Verbindung zu Calendly (Calendly LLC, USA) hergestellt und es können Cookies gesetzt werden. Details in der <a href="datenschutz.html" target="_blank" rel="noopener">Datenschutzerklärung</a>.</p>
            <button type="button" class="btn btn--primary btn--lg btn--block" id="calLoad">Kalender laden &amp; Termin wählen</button>
            <a id="calExternal" href="https://calendly.com/paul-web/30min" target="_blank" rel="noopener" class="cal-alt">… oder Kalender in neuem Tab öffnen</a>
          </div>
          <div id="calEmbed" class="cal-embed" hidden></div>
        </div>
      </div>

      <!-- ANFRAGE-FUNNEL -->
      <div class="panel" id="panel-anfrage" role="tabpanel" aria-labelledby="tab-anfrage">
        <div class="pcard">
          <div id="funnelBody">
            <div class="progress"><div class="progress__bar" id="pbar"></div></div>
            <div class="progress__txt" id="ptxt">Schritt 1 von 5</div>

            <form id="funnel" novalidate>
              <!-- Honeypot: von echten Nutzern nie ausgefüllt -->
              <div style="position:absolute;left:-9999px;top:-9999px;opacity:0;pointer-events:none" aria-hidden="true">
                <input type="text" name="website" id="hp_website" tabindex="-1" autocomplete="off" />
              </div>
              <div class="fstep" data-step="1">
                <h3>Was suchst du?</h3>
                <p class="hint">Damit wir direkt auf den Punkt kommen können.</p>
                <div class="opts">
                  <button type="button" class="opt" data-name="ziel" data-value="Neue Website"><span class="opt__tick"></span>Neue Website</button>
                  <button type="button" class="opt" data-name="ziel" data-value="Mehr Anfragen / Google Ads"><span class="opt__tick"></span>Mehr Anfragen / Google Ads</button>
                  <button type="button" class="opt" data-name="ziel" data-value="Komplettsystem (Website + Ads + KI)"><span class="opt__tick"></span>Komplettsystem (Website + Ads + KI)</button>
                  <button type="button" class="opt" data-name="ziel" data-value="Ich weiß noch nicht genau"><span class="opt__tick"></span>Ich weiß noch nicht genau</button>
                </div>
              </div>
              <div class="fstep" data-step="2" hidden>
                <h3>Wie viele Anfragen kommen bei dir pro Monat rein?</h3>
                <p class="hint">Grob geschätzt reicht.</p>
                <div class="opts">
                  <button type="button" class="opt" data-name="anfragen" data-value="Kaum welche (unter 5)"><span class="opt__tick"></span>Kaum welche (unter 5)</button>
                  <button type="button" class="opt" data-name="anfragen" data-value="Ein paar (5–15 / Monat)"><span class="opt__tick"></span>Ein paar (5–15 / Monat)</button>
                  <button type="button" class="opt" data-name="anfragen" data-value="Genug, aber zu wenig gute (über 15)"><span class="opt__tick"></span>Genug, aber zu wenig gute (über 15)</button>
                </div>
              </div>
              <div class="fstep" data-step="3" hidden>
                <h3>Was investierst du aktuell in Werbung / Marketing?</h3>
                <p class="hint">Pro Monat, ungefähr.</p>
                <div class="opts">
                  <button type="button" class="opt" data-name="budget" data-value="Noch gar nichts"><span class="opt__tick"></span>Noch gar nichts</button>
                  <button type="button" class="opt" data-name="budget" data-value="Bis 500 €/Monat"><span class="opt__tick"></span>Bis 500 €/Monat</button>
                  <button type="button" class="opt" data-name="budget" data-value="500–1.500 €/Monat"><span class="opt__tick"></span>500–1.500 €/Monat</button>
                  <button type="button" class="opt" data-name="budget" data-value="Über 1.500 €/Monat"><span class="opt__tick"></span>Über 1.500 €/Monat</button>
                </div>
              </div>
              <div class="fstep" data-step="4" hidden>
                <h3>Wann willst du loslegen?</h3>
                <div class="opts">
                  <button type="button" class="opt" data-name="zeitpunkt_wunsch" data-value="Sofort / dringend"><span class="opt__tick"></span>Sofort / dringend</button>
                  <button type="button" class="opt" data-name="zeitpunkt_wunsch" data-value="In den nächsten 3 Monaten"><span class="opt__tick"></span>In den nächsten 3 Monaten</button>
                  <button type="button" class="opt" data-name="zeitpunkt_wunsch" data-value="Erst mal informieren"><span class="opt__tick"></span>Erst mal informieren</button>
                </div>
              </div>
              <div class="fstep" data-step="5" hidden>
                <h3>Wie erreichen wir dich?</h3>
                <p class="hint">Wir melden uns innerhalb von 24 Stunden.</p>
                <div style="margin-top:20px">
                  <div class="field"><label for="name">Name</label><input id="name" name="name" type="text" autocomplete="name" required /></div>
                  <div class="field"><label for="betrieb">Betrieb (optional)</label><input id="betrieb" name="betrieb" type="text" /></div>
                  <div class="field"><label for="email">E-Mail</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
                  <div class="field"><label for="telefon">Telefon</label><input id="telefon" name="telefon" type="tel" autocomplete="tel" required /></div>
                  <div class="field"><label for="nachricht">Noch was mitgeben? <span style="font-weight:400;color:var(--gray-2)">(optional)</span></label><textarea id="nachricht" name="nachricht" placeholder="Erzähl uns kurz, worum es geht."></textarea></div>
                  <label class="consent"><input type="checkbox" id="consent" required /><span>Ich bin mit der Verarbeitung meiner Daten zur Bearbeitung der Anfrage einverstanden (<a href="datenschutz.html" target="_blank" rel="noopener">Datenschutz</a>).</span></label>
                </div>
              </div>

              <div class="fnav" id="fnav">
                <button type="button" class="btn btn--ghost" id="backBtn" hidden>Zurück</button>
                <button type="button" class="btn btn--primary" id="nextBtn" disabled>Weiter</button>
                <button type="submit" class="btn btn--primary" id="sendBtn" hidden>Anfrage senden</button>
              </div>
            </form>
          </div>

          <div class="done" id="funnelDone" hidden>
            <div class="done__ic"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div>
            <h3>Danke! Deine Anfrage ist da.</h3>
            <p>Wir melden uns innerhalb von 24 Stunden bei dir. Du kannst dir auch direkt einen Termin sichern:</p>
            <a href="https://calendly.com/paul-web/30min" target="_blank" rel="noopener" class="btn btn--primary btn--lg" style="margin-top:18px">Termin buchen</a>
          </div>
        </div>
      </div>

      <div class="direct">
        <a href="tel:+491633781657"><svg class="ic" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>+49 163 3781657</a>
        <a href="mailto:paul.web@outlook.de"><svg class="ic" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>paul.web@outlook.de</a>
      </div>
    </div>
  </main>

  <Fragment slot="scripts">
    <script is:inline>
    (function(){
      "use strict";
      var FORM_ENDPOINT = (window.location.hostname === "localhost" || window.location.hostname === "127.0.0.1")
        ? "http://localhost:3000/api/leads"
        : "https://fastraone-admin.vercel.app/api/leads";

      /* UTM-Parameter aus URL lesen */
      var _urlp = new URLSearchParams(window.location.search);
      var _utmSource = _urlp.get("utm_source") || "";
      var _utmCampaign = _urlp.get("utm_campaign") || "";
      var _quelle = _utmSource === "google" ? "Google Ads" : "Website";

      var tabs = document.querySelectorAll(".choice__btn");
      function selectTab(id){
        tabs.forEach(function(t){
          var on = t.id === id;
          t.setAttribute("aria-selected", String(on));
          var p = document.getElementById(t.getAttribute("aria-controls"));
          if (p) p.hidden = !on;
        });
      }
      tabs.forEach(function(t){ t.addEventListener("click", function(){ selectTab(t.id); }); });
      if (window.location.hash === "#termin") selectTab("tab-termin");

      var form = document.getElementById("funnel");
      var steps = Array.prototype.slice.call(form.querySelectorAll(".fstep"));
      var total = steps.length;
      var cur = 0;
      var answers = {};
      var bar = document.getElementById("pbar");
      var ptxt = document.getElementById("ptxt");
      var backBtn = document.getElementById("backBtn");
      var nextBtn = document.getElementById("nextBtn");
      var sendBtn = document.getElementById("sendBtn");

      function isChoice(step){ return !!step.querySelector(".opt"); }
      function stepValid(i){
        var step = steps[i];
        if (isChoice(step)){
          var name = step.querySelector(".opt").getAttribute("data-name");
          return !!answers[name];
        }
        if (step.getAttribute("data-step") === "5"){
          var okv = ["name","email","telefon"].every(function(id){ var el=document.getElementById(id); return el && el.value.trim(); });
          return okv && document.getElementById("email").checkValidity() && document.getElementById("consent").checked;
        }
        return true;
      }
      function render(){
        steps.forEach(function(s,i){ s.hidden = i !== cur; });
        bar.style.width = Math.round((cur/(total-1))*100) + "%";
        ptxt.textContent = "Schritt " + (cur+1) + " von " + total;
        backBtn.hidden = cur === 0;
        var last = cur === total-1;
        nextBtn.hidden = last;
        sendBtn.hidden = !last;
        refreshNext();
      }
      function refreshNext(){
        var ok = stepValid(cur);
        nextBtn.disabled = !ok;
        sendBtn.disabled = !ok;
      }
      form.querySelectorAll(".opt").forEach(function(opt){
        opt.addEventListener("click", function(){
          var name = opt.getAttribute("data-name");
          opt.parentNode.querySelectorAll(".opt").forEach(function(s){ s.classList.remove("is-sel"); });
          opt.classList.add("is-sel");
          answers[name] = opt.getAttribute("data-value");
          refreshNext();
        });
      });
      form.querySelectorAll("input, textarea").forEach(function(el){
        el.addEventListener("input", refreshNext);
        el.addEventListener("change", refreshNext);
      });
      nextBtn.addEventListener("click", function(){ if (stepValid(cur) && cur < total-1){ cur++; render(); } });
      backBtn.addEventListener("click", function(){ if (cur > 0){ cur--; render(); } });

      /* Calendly: DSGVO-konform erst nach Klick laden (Calendly = US-Dienst) */
      var CALENDLY_URL = "https://calendly.com/paul-web/30min";
      var CAL_CONSENT_KEY = "fastra_calendly_ok";
      var calGate = document.getElementById("calGate");
      var calEmbed = document.getElementById("calEmbed");
      var calLoadBtn = document.getElementById("calLoad");
      var calLoaded = false;
      function loadCalendly(){
        if (calLoaded || !calEmbed) return;
        calLoaded = true;
        if (calGate) calGate.hidden = true;
        calEmbed.hidden = false;
        calEmbed.innerHTML = '<div class="calendly-inline-widget" data-url="' + CALENDLY_URL + '" style="min-width:320px;height:860px;"></div>';
        var s = document.createElement("script");
        s.src = "https://assets.calendly.com/assets/external/widget.js"; s.async = true;
        document.body.appendChild(s);
      }
      if (calLoadBtn){
        calLoadBtn.addEventListener("click", function(){
          try { localStorage.setItem(CAL_CONSENT_KEY, "1"); } catch (e) {}
          loadCalendly();
        });
      }
      function maybeAutoLoadCal(){
        var ok = false; try { ok = localStorage.getItem(CAL_CONSENT_KEY) === "1"; } catch (e) {}
        if (ok) loadCalendly();
      }
      var tabTerminBtn = document.getElementById("tab-termin");
      if (tabTerminBtn) tabTerminBtn.addEventListener("click", maybeAutoLoadCal);
      if (window.location.hash === "#termin") maybeAutoLoadCal();

      form.addEventListener("submit", function(e){
        e.preventDefault();
        if (document.getElementById("hp_website") && document.getElementById("hp_website").value) return;
        if (!stepValid(cur)) return;
        ["name","betrieb","email","telefon","nachricht"].forEach(function(id){
          var el = document.getElementById(id); if (el) answers[id] = el.value.trim();
        });
        sendBtn.disabled = true; sendBtn.textContent = "Wird gesendet …";
        function showDone(){ document.getElementById("funnelBody").hidden = true; document.getElementById("funnelDone").hidden = false; }
        if (FORM_ENDPOINT.indexOf("http") !== 0){ console.warn("FORM_ENDPOINT fehlt – Daten:", answers); showDone(); return; }
        var payload = Object.assign({}, answers, {
          quelle: _quelle,
          utm_campaign: _utmCampaign || null,
          seite: window.location.pathname,
        });
        fetch(FORM_ENDPOINT, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        })
          .then(showDone)
          .catch(function(){ sendBtn.disabled=false; sendBtn.textContent="Anfrage senden"; alert("Da ist etwas schiefgelaufen. Bitte ruf uns an oder schreib an paul.web@outlook.de."); });
      });
      render();
    })();
    </script>
  </Fragment>
</BaseLayout>
