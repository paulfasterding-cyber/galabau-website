---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Ratgeber GaLaBau: Webdesign, Google Ads & SEO für mehr Aufträge | Fastra One"
  description="Praxis-Tipps für Garten- & Landschaftsbau-Betriebe in Hannover und DACH: Wie du mit professionellem Webdesign, Google Ads und lokalem SEO planbar mehr qualifizierte Anfragen gewinnst."
  canonical="https://fastraone.de/blog"
  navVariant="back"
  footerVariant="full"
>
  <Fragment slot="head">
    <meta property="og:title" content="Ratgeber für mehr Aufträge im Garten- & Landschaftsbau | Fastra One" />
    <meta property="og:description" content="Praxis-Tipps zu Website, Google Ads & lokalem SEO für GaLaBau-Betriebe." />
  </Fragment>

  <style is:global>
body{background:#0b0f1a}

/* POST-GRID */
.posts{display:grid;grid-template-columns:1fr;gap:26px;margin-top:46px}
.post{position:relative;display:flex;flex-direction:column;background:#fff;border:1px solid rgba(0,0,0,.07);border-radius:24px;overflow:hidden;box-shadow:var(--shadow-card);transition:transform .25s ease,box-shadow .25s ease}
.post:hover{transform:translateY(-6px);box-shadow:0 20px 50px rgba(0,0,0,.11);border-color:rgba(110,236,157,.4)}
.post--soon{pointer-events:none}
.post--soon .post__media{filter:grayscale(.6) brightness(.8)}
.post__media{position:relative;height:210px;overflow:hidden}
.post__media img{width:100%;height:100%;object-fit:cover}
.post__cat{position:absolute;top:16px;left:16px;display:inline-flex;align-items:center;gap:7px;background:rgba(0,0,0,.45);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);font-size:.76rem;font-weight:700;color:#fff;padding:6px 13px;border-radius:var(--pill);box-shadow:0 4px 12px rgba(0,0,0,.3)}
.post__body{padding:24px 26px 28px;display:flex;flex-direction:column;flex:1}
.post__meta{font-size:.82rem;color:var(--gray-2);font-weight:500}
.post__title{margin-top:8px;font-family:var(--f-head);font-size:1.3rem;font-weight:800;letter-spacing:-.02em;line-height:1.2;color:var(--ink)}
.post__title a{color:var(--ink)}
.post__title a:hover{color:var(--blue-strong)}
.post__excerpt{margin-top:11px;color:var(--ink-soft);font-size:.96rem;flex:1}
.post__link{margin-top:18px;display:inline-flex;align-items:center;gap:8px;font-weight:600;color:var(--blue-strong);font-size:.95rem}
.post__link svg{width:16px;height:16px;transition:transform .2s ease}
.post:hover .post__link svg{transform:translateX(4px)}
.post__soon{margin-top:18px;display:inline-flex;align-items:center;font-size:.82rem;font-weight:600;color:var(--gray-2);background:var(--bg);padding:6px 13px;border-radius:var(--pill);align-self:flex-start}
@media(min-width:760px){.posts{grid-template-columns:1fr 1fr}}
@media(min-width:1020px){.posts{grid-template-columns:repeat(3,1fr)}}

/* CTA */
.bcta{padding:80px 0}
.bcta__card{background:#fff;border:1px solid rgba(0,0,0,.07);border-radius:28px;padding:52px 26px;text-align:center;box-shadow:0 8px 30px rgba(0,0,0,.06)}
.bcta h2{font-family:var(--f-head);font-size:clamp(1.7rem,4.4vw,2.4rem);font-weight:800;letter-spacing:-.03em;line-height:1.12;max-width:20ch;margin-inline:auto;color:#0c0d10}
.bcta p{margin:14px auto 0;max-width:46ch;color:#565a66}
.bcta .btn{margin-top:24px}

@media(prefers-reduced-motion:reduce){.post:hover{transform:none}}
  </style>

  <main>
    <section class="head head--dark">
      <div class="hd-bg" aria-hidden="true"></div>
      <div class="container">
        <div class="head__pill"><span class="dot" aria-hidden="true"></span>Ratgeber für den Garten- &amp; Landschaftsbau</div>
        <h1>Mehr Aufträge im Gartenbau: so geht's</h1>
        <p>Praxisnahe Tipps zu Website, Google Ads und lokalem SEO. Damit dein Betrieb online gefunden wird und planbar neue Anfragen bekommt.</p>
      </div>
    </section>

    <div aria-hidden="true" style="line-height:0;background:#0b0f1a">
      <svg viewBox="0 0 1440 70" preserveAspectRatio="none" style="width:100%;height:70px;display:block">
        <path d="M0,35 C360,70 1080,0 1440,35 L1440,70 L0,70 Z" fill="#f5f5f5"/>
      </svg>
    </div>

    <div style="background:var(--bg)">
    <section class="section" style="padding:10px 0 0">
      <div class="container">
        <div class="posts">

          <!-- ARTIKEL 1 (live) -->
          <article class="post reveal">
            <a href="/blog-mehr-gartenbau-auftraege" class="post__media" aria-label="Artikel öffnen">
              <span class="post__cat">Akquise</span>
              <img src="assets/garden.jpg" alt="Gepflegter Garten als Sinnbild für mehr Gartenbau-Aufträge" width="1600" height="1067" loading="lazy" decoding="async" />
            </a>
            <div class="post__body">
              <span class="post__meta">22. Juni 2026 · 6 Min. Lesezeit</span>
              <h2 class="post__title"><a href="/blog-mehr-gartenbau-auftraege">7 Wege, wie GaLaBau-Betriebe 2026 mehr Aufträge gewinnen</a></h2>
              <p class="post__excerpt">Empfehlungen allein reichen nicht mehr. Diese 7 Hebel sorgen für einen planbaren Strom an qualifizierten Anfragen, ganz ohne Kaltakquise.</p>
              <a href="/blog-mehr-gartenbau-auftraege" class="post__link">Artikel lesen
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
              </a>
            </div>
          </article>

          <!-- ARTIKEL 2 (geplant) -->
          <article class="post post--soon reveal">
            <span class="post__media">
              <span class="post__cat">Google Ads</span>
              <img src="assets/person-window.jpg" alt="" width="6720" height="4480" loading="lazy" decoding="async" />
            </span>
            <div class="post__body">
              <span class="post__meta">In Vorbereitung</span>
              <h2 class="post__title">Google Ads für Gartenbau-Betriebe: Lohnt sich das?</h2>
              <p class="post__excerpt">Was Anzeigen wirklich kosten, welcher ROI realistisch ist und ab wann sich Werbung für deinen Betrieb rechnet.</p>
              <span class="post__soon">Bald verfügbar</span>
            </div>
          </article>

          <!-- ARTIKEL 3 (geplant) -->
          <article class="post post--soon reveal">
            <span class="post__media">
              <span class="post__cat">Lokales SEO</span>
              <img src="assets/laptop-person.jpg" alt="" width="5472" height="3648" loading="lazy" decoding="async" />
            </span>
            <div class="post__body">
              <span class="post__meta">In Vorbereitung</span>
              <h2 class="post__title">Lokales SEO für GaLaBau: in deiner Region gefunden werden</h2>
              <p class="post__excerpt">Google Business Profile, Bewertungen und lokale Keywords: die Basis, um bei „Gartenbau + Stadt" oben zu stehen.</p>
              <span class="post__soon">Bald verfügbar</span>
            </div>
          </article>

        </div>
      </div>
    </section>

    <section class="bcta">
      <div class="container">
        <div class="bcta__card reveal">
          <h2>Lieber direkt umsetzen statt selbst tüfteln?</h2>
          <p>Wir bauen dir das komplette System: Website, Werbung und Anfrage-Management. Im kostenlosen Erstgespräch zeigen wir, was für deinen Betrieb sinnvoll ist.</p>
          <a href="/kontakt" class="btn btn--primary btn--lg">Gratis Erstgespräch sichern <span class="btn__arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg></span></a>
        </div>
      </div>
    </section>
    </div>
  </main>

  <Fragment slot="scripts">
    <script is:inline>
    (function(){
      "use strict";
      if(!("IntersectionObserver" in window)){document.querySelectorAll(".reveal").forEach(function(e){e.classList.add("is-visible")});return;}
      var o=new IntersectionObserver(function(en){en.forEach(function(x){if(x.isIntersecting){x.target.classList.add("is-visible");o.unobserve(x.target);}})},{threshold:.15});
      document.querySelectorAll(".reveal").forEach(function(e){o.observe(e)});
    })();
    </script>
  </Fragment>
</BaseLayout>
