/* SCHLUSS-CTA */
/* --- SYSTEM ORBITAL VISUALIZER --- */
.sys-wrap{width:100%;max-width:860px}
.sys-top{text-align:center;margin-bottom:40px}
.sys-eyebrow{
  display:inline-flex;align-items:center;gap:7px;
  font-size:.6rem;font-weight:700;letter-spacing:.2em;text-transform:uppercase;
  color:rgba(255,255,255,.28);margin-bottom:12px;
}
.sys-eyebrow svg{width:11px;height:11px;stroke:currentColor;stroke-width:2;fill:none;stroke-linecap:round;stroke-linejoin:round}
.sys-top-title{
  font-family:var(--f-head);font-size:clamp(1.35rem,2.2vw,1.75rem);font-weight:800;
  color:#fff;letter-spacing:-.03em;line-height:1.18;
}
.sys-top-sub{margin-top:10px;font-size:.88rem;color:rgba(255,255,255,.34);max-width:50ch;margin-inline:auto;line-height:1.65}

/* Orbital container */
.orb-outer{position:relative;width:960px;height:620px;margin:0 auto;flex-shrink:0}


/* Orbital Ringe */
.orb-depth{
  position:absolute;top:50%;left:50%;
  border-radius:50%;pointer-events:none;
}
/* Äußerer Ring: rotierender Lichtbogen, zurückhaltend */
.orb-depth--xl{
  width:340px;height:340px;
  background:conic-gradient(
    from 0deg,
    transparent 0deg,
    rgba(110,236,157,.22) 70deg,
    rgba(110,236,157,.38) 90deg,
    rgba(110,236,157,.22) 110deg,
    transparent 200deg,
    transparent 360deg
  );
  -webkit-mask:radial-gradient(farthest-side, transparent calc(100% - 1px), #000 calc(100% - 1px));
  mask:radial-gradient(farthest-side, transparent calc(100% - 1px), #000 calc(100% - 1px));
  transform:translate(-50%,-50%) rotate(0deg);
  animation:orb-spin-xl 32s linear infinite;
}
/* Mittlerer Ring: clean, minimal */
.orb-depth--lg{
  width:240px;height:240px;
  background:transparent;
  border:1px solid rgba(110,236,157,.2);
  box-shadow:0 0 10px rgba(110,236,157,.1),inset 0 0 8px rgba(110,236,157,.06);
  transform:translate(-50%,-50%);
}
/* Innerer Ring: etwas präsenter */
.orb-depth--md{
  width:148px;height:148px;
  background:transparent;
  border:1px solid rgba(110,236,157,.32);
  box-shadow:0 0 10px rgba(110,236,157,.14),inset 0 0 6px rgba(110,236,157,.08);
  transform:translate(-50%,-50%);
}
@keyframes orb-spin-xl{
  to{transform:translate(-50%,-50%) rotate(360deg)}
}
@keyframes orb-spin-lg{
  to{transform:translate(-50%,-50%) rotate(360deg)}
}

/* Logo-Kreis */
.orb-center{
  position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
  width:120px;height:120px;border-radius:50%;
  background:radial-gradient(circle at 40% 35%, rgba(20,30,55,1) 0%, rgba(9,12,24,1) 100%);
  border:1.5px solid rgba(110,236,157,.55);
  box-shadow:
    0 0 0 4px rgba(110,236,157,.07),
    0 0 0 8px rgba(110,236,157,.03),
    0 0 28px rgba(110,236,157,.3),
    0 0 60px rgba(110,236,157,.14),
    0 0 100px rgba(110,236,157,.06),
    inset 0 1px 0 rgba(255,255,255,.08);
  display:flex;align-items:center;justify-content:center;
}
.orb-center img{display:block;height:42px;width:auto;filter:brightness(0) invert(1)}
.orb-card{
  position:absolute;top:50%;left:50%;
  display:flex;align-items:center;gap:11px;
  padding:12px 15px;
  background:rgba(12,18,38,.93);
  border:1px solid rgba(110,236,157,.18);
  border-top:1px solid rgba(255,255,255,.08);
  border-radius:16px;
  width:220px;
  pointer-events:none;
  box-shadow:
    0 4px 8px rgba(0,0,0,.3),
    0 16px 32px rgba(0,0,0,.45),
    0 32px 56px rgba(0,0,0,.2),
    inset 0 1px 0 rgba(255,255,255,.07);
  animation:card-float 3.5s ease-in-out infinite alternate;
}
.orb-outer>.orb-card:nth-child(5){animation-delay:0s}
.orb-outer>.orb-card:nth-child(6){animation-delay:-.65s}
.orb-outer>.orb-card:nth-child(7){animation-delay:-1.3s}
.orb-outer>.orb-card:nth-child(8){animation-delay:-1.95s}
.orb-outer>.orb-card:nth-child(9){animation-delay:-2.6s}
.orb-outer>.orb-card:nth-child(10){animation-delay:-3.25s}
@keyframes card-float{
  from{translate:0 0}
  to{translate:0 -8px}
}
/* grüner Notification-Punkt oben rechts */
.orb-card::after{
  content:'';position:absolute;top:10px;right:10px;
  width:7px;height:7px;border-radius:50%;
  background:#16a566;
  box-shadow:0 0 8px rgba(22,165,102,.7);
}
.orb-card__icon{
  width:36px;height:36px;flex-shrink:0;border-radius:9px;
  background:rgba(110,236,157,.1);
  border:1px solid rgba(110,236,157,.16);
  display:flex;align-items:center;justify-content:center;
}
.orb-card__icon svg{width:18px;height:18px}
.orb-card__text{min-width:0;flex:1;overflow:hidden}
.orb-card__title{font-size:.82rem;font-weight:700;color:#fff;line-height:1.2}
.orb-card__sub{font-size:.71rem;color:rgba(255,255,255,.38);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

/* --- VERGLEICH TABLE --- */
.vgl{margin-top:48px}
.vgl__table{width:100%;border-collapse:collapse;border-radius:14px;overflow:hidden;font-size:.95rem}
.vgl__table th,.vgl__table td{padding:14px 18px;text-align:left;border-bottom:1px solid rgba(0,0,0,0.06)}
.vgl__table thead th{font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:rgba(0,0,0,0.4);background:#f5f5f5;padding-top:10px;padding-bottom:10px}
.vgl__col-label{width:28%}
.vgl__col-them{width:36%}
.vgl__col-us{width:36%}
.vgl__table tbody tr:last-child td{border-bottom:none}
.vgl__table tbody tr:nth-child(even) td{background:rgba(0,0,0,0.02)}
.vgl__table tbody tr td:first-child{font-weight:600;color:#333}
.vgl__good{color:#0d7a45;background:rgba(22,165,102,0.06)!important;font-weight:500}
.vgl__bad{color:#888;font-weight:400}
.vgl__cta{margin-top:40px;display:flex;flex-direction:column;align-items:center;gap:10px}
.vgl__note{font-size:.85rem;color:#999}
@media(max-width:640px){
  .vgl__table th,.vgl__table td{padding:10px 12px;font-size:.85rem}
  .vgl__col-label{width:36%}
  .vgl__col-them,.vgl__col-us{width:32%}
}

.fcta { background:var(--bg); padding:100px 0; }
.fcta__wrap { width:100%; padding:0 48px; display:flex; justify-content:center; }
.fcta__card { position:relative; width:95%; max-width:1140px; min-height:467px; background:#fff; border-radius:20px; padding:40px; overflow:hidden; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:41px; box-shadow:0 18px 50px rgba(0,0,0,0.08); }
.fcta__deco { position:absolute; width:442px; height:306px; pointer-events:none; z-index:0; background-color:#6EEC9D; -webkit-mask:url("/assets/cta-deco.png") center / contain no-repeat; mask:url("/assets/cta-deco.png") center / contain no-repeat; }
.fcta__deco--br { right:-140px; bottom:-23px; }
.fcta__deco--tl { left:-140px; top:-23px; transform:rotate(180deg); }
.fcta__photo { position:absolute; z-index:1; pointer-events:none; }
.fcta__photo--left { left:63px; top:43%; transform:translateY(-50%) rotate(-10deg); animation:fctaFloatL 5s ease-in-out infinite; }
.fcta__photo--left img { width:148px; height:101px; border-radius:10px; object-fit:cover; }
.fcta__photo--right { right:24px; top:207px; transform:rotate(9deg); animation:fctaFloatR 6.5s ease-in-out infinite; animation-delay:-1.5s; }
.fcta__photo--right img { width:230px; height:157px; border-radius:10px; transform:rotate(-2deg); object-fit:cover; }
@keyframes fctaFloatL { 0%,100% { transform:translateY(-50%) rotate(-10deg); } 50% { transform:translateY(calc(-50% - 9px)) rotate(-10deg); } }
@keyframes fctaFloatR { 0%,100% { transform:translateY(0) rotate(9deg); } 50% { transform:translateY(-9px) rotate(9deg); } }
@media (prefers-reduced-motion: reduce){ .fcta__photo--left, .fcta__photo--right { animation:none; } }
.fcta__body { position:relative; z-index:2; display:flex; flex-direction:column; align-items:center; gap:10px; text-align:center; }
.fcta__heading { max-width:560px; font-family:'Inter',sans-serif; font-weight:500; font-size:clamp(1.5rem,3vw,2.1rem); line-height:1.2; color:#000; }
.fcta__sub { max-width:340px; font-size:0.95rem; color:#555; margin-top:10px; line-height:1.5; }
.fcta__tags { display:flex; flex-wrap:wrap; justify-content:center; gap:10px; margin-top:6px; }
.fcta__tag { display:inline-flex; align-items:center; gap:6px; background:#f5f5f5; border-radius:999px; padding:8px 16px 8px 8px; font-weight:500; font-size:0.85rem; color:#000; }
.fcta__btn { position:relative; z-index:2; display:inline-flex; align-items:center; gap:10px; padding:15px 30px; background:linear-gradient(180deg,#7ef0ab 0%,#54dd92 100%); color:#06351e; border-radius:999px; font-weight:700; font-size:1rem; box-shadow:0 5px 14px rgba(29,120,62,0.18); transition:transform .18s ease, box-shadow .18s ease; text-decoration:none; }
.fcta__btn:hover { background:linear-gradient(180deg,#8ff5b8 0%,#64e6a0 100%); transform:translateY(-2px); box-shadow:0 9px 20px rgba(29,120,62,.26); }
@media (max-width:768px){ .fcta__wrap { padding:0 16px; } .fcta__card { padding:40px 24px; min-height:0; } .fcta__photo, .fcta__deco { display:none; } }

/* FOOTER */
.footer { background:#0b0f1a; border-top:none; padding:64px 0 0; color:rgba(255,255,255,.6); }
.footer__inner { display:grid; grid-template-columns:1fr; gap:40px; padding-bottom:52px; }
.footer__brand .logo { height:42px; filter:brightness(0) invert(1); }
