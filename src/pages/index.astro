  --f-head:"Plus Jakarta Sans","Inter",sans-serif;
  --f-body:"Inter",sans-serif;
}
*,*::before,*::after { box-sizing:border-box; margin:0; padding:0; }
html { scroll-behavior:smooth; scroll-padding-top:110px; }
body { font-family:var(--f-body); color:var(--ink); background:var(--bg); line-height:1.6; -webkit-font-smoothing:antialiased; }
a { color:inherit; text-decoration:none; }
img,svg { display:block; }
.container { width:100%; max-width:var(--container); margin-inline:auto; padding-inline:22px; }
a,button,.btn { touch-action:manipulation; }

/* Buttons */
.btn { display:inline-flex; align-items:center; justify-content:center; gap:10px; font-weight:600; font-size:0.95rem; letter-spacing:-0.01em; border-radius:var(--pill); padding:12px 24px; border:1px solid transparent; cursor:pointer; transition:transform .18s ease, box-shadow .18s ease; }
.btn--lg { padding:15px 30px; font-size:1rem; }
.btn--primary { background:linear-gradient(180deg,#7ef0ab 0%,#54dd92 100%); color:#06351e; box-shadow:var(--shadow-blue); }
.btn--primary:hover { background:linear-gradient(180deg,#8ff5b8 0%,#64e6a0 100%); transform:translateY(-2px); box-shadow:0 14px 30px rgba(29,120,62,.45); }
.btn--light { background:#fff; color:var(--ink); border-color:transparent; box-shadow:0 10px 26px rgba(0,0,0,.13); }
.btn--light:hover { background:#f1fcf5; border-color:transparent; color:var(--blue-strong); transform:translateY(-2px); }
.ic { width:1.2em; height:1.2em; flex:none; stroke:currentColor; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; fill:none; }

/* Logo */
.logo { width:auto; display:block; }

/* NAV */
.navwrap { position:sticky; top:0; z-index:100; padding:14px 16px 0; }
.nav2 { max-width:880px; margin-inline:auto; display:flex; align-items:center; gap:14px; padding:9px 9px 9px 22px; background:rgba(28,30,36,0.82); border:1px solid rgba(255,255,255,0.08); border-radius:var(--pill); backdrop-filter:blur(6px); -webkit-backdrop-filter:blur(6px); box-shadow:0 10px 40px rgba(0,0,0,0.28); }
.nav2 .brand .logo { height:26px; filter:brightness(0) invert(1); }
.brand { display:inline-flex; align-items:center; }
.nav2__links { display:none; list-style:none; gap:18px; margin-inline:auto; }
.nav2__links a { color:rgba(255,255,255,0.82); font-weight:500; font-size:0.92rem; transition:color .18s ease; }
.nav2__links a:hover { color:#fff; }
.nav2__cta { margin-left:auto; }
.nav2__partner { background:rgba(110,236,157,.1)!important; border:1px solid rgba(110,236,157,.22)!important; border-radius:999px!important; padding:3px 13px!important; color:#6EEC9D!important; font-weight:700!important; text-decoration:none; transition:background .15s; }
.nav2__partner:hover { background:rgba(110,236,157,.2)!important; }
.nav2__burger { margin-left:auto; width:42px; height:42px; display:inline-flex; flex-direction:column; justify-content:center; align-items:center; gap:5px; background:transparent; border:none; cursor:pointer; }
.nav2__burger span { width:20px; height:2px; background:#fff; border-radius:2px; }
@media (min-width:900px){ .nav2__links{ display:flex; } .nav2__burger{ display:none; } .nav2__cta{ margin-left:0; } }

/* HERO – Unified Dark */
.hero{position:relative;padding:0;overflow:hidden;background:#0b0f1a;display:flex;flex-direction:column}
.hero::before{content:"";position:absolute;inset:0;z-index:0;background-image:linear-gradient(rgba(255,255,255,.02) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.02) 1px,transparent 1px);background-size:72px 72px;pointer-events:none}
.hero__bg{display:none}
.hero .container{position:relative;z-index:5;flex:1;display:flex;flex-direction:column}
.hero__grid{display:grid;grid-template-columns:1fr;gap:0px;margin:64px auto 0;max-width:1100px;width:100%;padding-bottom:0;align-items:center}
@media(min-width:960px){.hero__grid{grid-template-columns:1fr 380px}}
.hero__left{text-align:left}
.hero__pill{display:inline-flex;align-items:center;gap:9px;font-size:.86rem;font-weight:600;color:rgba(255,255,255,.82);background:rgba(110,236,157,.1);border:1px solid rgba(110,236,157,.22);padding:7px 16px 7px 12px;border-radius:var(--pill);box-shadow:none}
.hero__pill-dot{width:8px;height:8px;border-radius:50%;background:#3dd87a;flex:none;animation:pulseDot 2s ease-out infinite}
@keyframes pulseDot{0%{box-shadow:0 0 0 0 rgba(34,197,94,.55)}70%{box-shadow:0 0 0 8px rgba(34,197,94,0)}100%{box-shadow:0 0 0 0 rgba(34,197,94,0)}}
.hero__title{margin-top:24px;font-family:var(--f-head);font-weight:800;letter-spacing:-0.03em;line-height:1.04;font-size:clamp(2.4rem,4vw,3.8rem);color:#fff}
.hero__title .accent{background:linear-gradient(90deg,#5df09e 0%,#22c55e 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.hero__sub{margin:20px 0 0;max-width:52ch;color:rgba(255,255,255,.62);font-size:clamp(1rem,2vw,1.1rem);line-height:1.65}
.hero__left .hero__sub{margin-inline:0}
.hero__benefits{display:grid;grid-template-columns:1fr;gap:14px 22px;margin:28px 0 0;max-width:none;text-align:left}
@media(min-width:560px){.hero__benefits{grid-template-columns:1fr 1fr}}
.hero__benefit{display:flex;gap:11px;align-items:flex-start}
.hero__benefit-ic{width:34px;height:34px;border-radius:10px;background:rgba(110,236,157,.12);color:#6EEC9D;display:grid;place-items:center;flex:none}
.hero__benefit-ic svg{width:18px;height:18px;stroke:#6EEC9D;stroke-width:2;fill:none;stroke-linecap:round;stroke-linejoin:round}
.hero__benefit b{display:block;font-size:.92rem;color:#fff}
.hero__benefit span{font-size:.82rem;color:rgba(255,255,255,.46)}
.hero__cta{display:flex;flex-wrap:wrap;justify-content:flex-start;gap:14px;margin-top:32px}
.hero__cta .ic{width:18px;height:18px}
.hero__trust{display:flex;flex-wrap:wrap;justify-content:flex-start;gap:10px 22px;margin-top:20px}
.hero__trust span{display:inline-flex;align-items:center;gap:8px;font-size:.86rem;font-weight:600;color:rgba(255,255,255,.46)}
.hero__trust svg{width:16px;height:16px;stroke:#6EEC9D;stroke-width:2;fill:none;stroke-linecap:round;stroke-linejoin:round;flex:none}
/* Hero right: Glassmorphism Stats Card */
.hero__right{display:none}
@media(min-width:960px){.hero__right{display:flex;align-items:center;justify-content:center}}
.hcard{background:rgba(255,255,255,.055);border:1px solid rgba(255,255,255,.09);border-radius:28px;padding:30px;backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);width:100%;max-width:360px;box-shadow:0 40px 80px rgba(0,0,0,.5),0 0 0 1px rgba(110,236,157,.07);position:relative;overflow:hidden}
.hcard::before{content:"";position:absolute;top:-60px;right:-60px;width:180px;height:180px;background:radial-gradient(circle,rgba(110,236,157,.14) 0%,transparent 70%);pointer-events:none}
.hcard__header{display:flex;align-items:center;gap:8px;font-size:.75rem;color:rgba(255,255,255,.45);margin-bottom:22px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
.hcard__online{width:7px;height:7px;border-radius:50%;background:#22c55e;box-shadow:0 0 0 3px rgba(34,197,94,.2);animation:pulseDot 2s ease-out infinite;flex:none}
.hcard__num{font-family:var(--f-head);font-size:3.4rem;font-weight:800;color:#fff;line-height:1;letter-spacing:-0.04em}
.hcard__label{font-size:.82rem;color:rgba(255,255,255,.42);margin-top:6px}
.hcard__divider{height:1px;background:rgba(255,255,255,.08);margin:22px 0}
.hcard__stats{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.hcard__stat{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.06);border-radius:16px;padding:14px;text-align:center}
.hcard__stat strong{display:block;font-family:var(--f-head);font-size:1.3rem;font-weight:800;color:#6EEC9D;letter-spacing:-0.03em}
.hcard__stat span{font-size:.7rem;color:rgba(255,255,255,.38);line-height:1.3;display:block;margin-top:3px}
.hcard__notif{margin-top:14px;padding:11px 13px;background:rgba(110,236,157,.09);border:1px solid rgba(110,236,157,.15);border-radius:13px;font-size:.79rem;color:rgba(255,255,255,.72);display:flex;align-items:center;gap:9px;line-height:1.4}
.hcard__notif-dot{width:7px;height:7px;border-radius:50%;background:#22c55e;flex:none;animation:pulseDot 2s ease-out infinite}
/* Hero – Scarcity Badge */
.hero__scarcity { display:inline-flex; align-items:center; gap:8px; margin-top:14px; font-size:.82rem; font-weight:600; color:rgba(255,255,255,.55); background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.1); padding:7px 14px; border-radius:999px; }
.hero__scarcity-dot { width:6px; height:6px; border-radius:50%; background:#f97316; flex:none; animation:pulseDot 2s ease-out infinite; }
/* Hero – wave transition to light */
.hero__wave { position:absolute; bottom:-2px; left:0; right:0; z-index:6; pointer-events:none; line-height:0; }
.hero__wave svg { display:block; width:100%; height:120px; }
@media(max-width:959.98px){.hero__title{font-size:clamp(2.2rem,8vw,3.4rem)}}

/* ── NEW HERO CARDS ── */
/* Hero Split Layout */
.hero-split{display:grid;grid-template-columns:1fr 440px;gap:0 24px;align-items:center;padding:60px 0 0;position:relative;z-index:2}
.hero-split__text{display:flex;flex-direction:column;gap:20px;padding-bottom:24px}
.hero-split__title{font-family:var(--f-head);font-size:clamp(2.2rem,3.8vw,3.8rem);font-weight:800;color:#fff;line-height:1.08;letter-spacing:-.035em}
.hero-split__title span{background:linear-gradient(90deg,#6EEC9D 0%,#22c55e 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.hero-split__sub{font-size:1rem;color:rgba(255,255,255,.5);line-height:1.65;max-width:44ch}
.hero-split__cta{display:flex;flex-direction:column;align-items:flex-start;gap:8px}
.hero-split__note{font-size:.76rem;color:rgba(255,255,255,.3)}
.hero-split__trust{display:flex;align-items:center;gap:5px;margin-top:6px}
.hero-split__trust-txt{font-size:.76rem;color:rgba(255,255,255,.36);margin-left:3px}
/* Foto-Bereich */
.hero-split__photo{display:flex;align-items:center;justify-content:flex-end;position:relative}
.hero__location{position:absolute;top:80px;right:60px;display:inline-flex;align-items:center;gap:7px;background:rgba(8,12,24,.45);backdrop-filter:blur(24px) saturate(180%);-webkit-backdrop-filter:blur(24px) saturate(180%);border:1px solid rgba(255,255,255,.13);border-top:1px solid rgba(255,255,255,.2);border-radius:99px;padding:7px 14px 7px 10px;font-size:.73rem;font-weight:600;color:rgba(255,255,255,.92);letter-spacing:.01em;z-index:10;pointer-events:none;box-shadow:0 2px 16px rgba(0,0,0,.22),inset 0 1px 0 rgba(255,255,255,.15)}
.hero__location svg{width:12px;height:12px;stroke:#6EEC9D;stroke-width:2.2;fill:none;stroke-linecap:round;stroke-linejoin:round;flex:none}
.hero-split__photo-inner{
  width:440px;height:500px;
  border-radius:0;background:transparent;border:none;
  overflow:hidden;position:relative;
  -webkit-mask-image: radial-gradient(
    ellipse 52% 53% at 52% 52%,
    black 0%,
    black 24%,
    rgba(0,0,0,.93) 36%,
    rgba(0,0,0,.80) 46%,
    rgba(0,0,0,.62) 57%,
    rgba(0,0,0,.40) 68%,
    rgba(0,0,0,.20) 79%,
    rgba(0,0,0,.06) 90%,
    transparent 100%
  );
  mask-image: radial-gradient(
    ellipse 52% 53% at 52% 52%,
    black 0%,
    black 24%,
    rgba(0,0,0,.93) 36%,
    rgba(0,0,0,.80) 46%,
    rgba(0,0,0,.62) 57%,
    rgba(0,0,0,.40) 68%,
    rgba(0,0,0,.20) 79%,
    rgba(0,0,0,.06) 90%,
    transparent 100%
  );
}
.hero-split__photo-inner img{position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;object-position:center 12%;border-radius:0}
/* Orbit zentriert unten in der Hero Section */
.hero__orbit{display:flex;align-items:center;justify-content:center;overflow:visible;position:relative;z-index:1;margin-top:20px;padding-bottom:60px;padding-inline:32px}
@media(max-width:860px){
  .hero-split{grid-template-columns:1fr;padding-top:48px}
  .hero-split__photo{display:none}
  .hero__orbit{display:none}
}
.hc{border-radius:24px;border:1px solid rgba(255,255,255,.09);background:rgba(255,255,255,.04);overflow:hidden}
/* Karte 1 – Trust */
.hc--trust{display:flex;align-items:center;padding:22px 28px;gap:20px}
.hc__left{flex:1;display:flex;flex-direction:column;gap:14px;justify-content:center}
.hc__title{font-family:var(--f-head);font-size:clamp(1.15rem,2vw,1.65rem);font-weight:800;color:#fff;line-height:1.15;letter-spacing:-.03em}
.hc__sub{color:rgba(255,255,255,.55);font-size:.88rem;line-height:1.55;max-width:38ch}
.hc__cta{display:flex;flex-direction:column;align-items:flex-start;gap:6px}
.hc__note{font-size:.74rem;color:rgba(255,255,255,.3)}
.hc__photo{flex:none;width:130px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px}
.hc__photo-wrap{
  width:104px;height:104px;border-radius:50%;
  background:rgba(255,255,255,.05);
  border:2px solid rgba(255,255,255,.14);
  box-shadow:0 0 0 5px rgba(110,236,157,.07),0 8px 32px rgba(0,0,0,.4);
  display:flex;align-items:center;justify-content:center;overflow:hidden;
}
