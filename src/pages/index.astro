  <script is:inline>
  /* Burger-Menü */
  (function(){
    var burger = document.getElementById('burger-idx');
    var nav = burger && burger.closest('.nav2');
    var menu = document.getElementById('mobile-menu-idx');
    if (!burger || !nav || !menu) return;
    burger.addEventListener('click', function(){
