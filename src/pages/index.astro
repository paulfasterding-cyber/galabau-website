  <script is:inline>
  (function(){
    "use strict";
    var hasIO = "IntersectionObserver" in window;
    var els = document.querySelectorAll(".reveal");
    if (!hasIO){ els.forEach(function(e){e.classList.add("is-visible");}); return; }
    var o = new IntersectionObserver(function(en){en.forEach(function(x){ if(x.isIntersecting){ x.target.classList.add("is-visible"); o.unobserve(x.target); } });},{threshold:0.15, rootMargin:"0px 0px -8% 0px"});
    els.forEach(function(e){o.observe(e);});
  })();

  /* Vor/Nach Tacho – beim Scrollen drehen & umschalten */
  (function(){
    "use strict";
    var section = document.getElementById("unterschied");
    if (!section) return;
    var pointer = section.querySelector(".dial__pointer");
    var ticking = false;
    function update(){
      var rect = section.getBoundingClientRect();
      var vh = window.innerHeight || document.documentElement.clientHeight;
      var p = (vh * 0.58 - rect.top) / (rect.height * 0.82);
      p = Math.max(0, Math.min(1, p));
      if (pointer) pointer.style.transform = "rotate(" + (-52 + p * 104) + "deg)";
      section.classList.toggle("is-after", p >= 0.5);
      ticking = false;
    }
    window.addEventListener("scroll", function(){ if(!ticking){ requestAnimationFrame(update); ticking = true; } }, { passive:true });
    window.addEventListener("resize", update);
    update();
  })();


  /* FAQ – nur ein Eintrag offen */
  (function(){
    "use strict";
    var items = document.querySelectorAll(".faq__item");
    items.forEach(function(item){
      item.addEventListener("toggle", function(){
        if (item.open) items.forEach(function(o){ if(o!==item) o.open=false; });
      });
    });
  })();

  /* Ablauf – Sticky-Scroll Desktop Animation */
  (function(){
    "use strict";
    var wrapper = document.getElementById("ablaufScroll");
    if (!wrapper) return;
    var texts = [
      document.getElementById("astep0"),
      document.getElementById("astep1"),
      document.getElementById("astep2")
    ];
    var visuals = [
      document.getElementById("avis0"),
      document.getElementById("avis1"),
      document.getElementById("avis2")
    ];
    var n = texts.length;
    var reduced = window.matchMedia("(prefers-reduced-motion:reduce)").matches;

    function setEl(el, opacity, ty) {
      if (!el) return;
      el.style.opacity = opacity;
      el.style.transform = ty === 0 ? "none" : "translateY(" + ty + "px)";
    }

    function update() {
      var rect = wrapper.getBoundingClientRect();
      var wh = wrapper.offsetHeight;
      var vh = window.innerHeight;
      var raw = -rect.top / (wh - vh);
      var p = Math.max(0, Math.min(1, raw));

      for (var i = 0; i < n; i++) {
        var sp = p * n - i; // progress within this step: -∞ → 1+
        var opacity, ty;
        var isLast = i === n - 1;

        if (sp <= 0) {
          opacity = 0; ty = 44;
        } else if (sp < 0.22) {
          opacity = sp / 0.22;
          ty = 44 * (1 - sp / 0.22);
        } else if (sp < 0.78 || isLast) {
          opacity = 1; ty = 0;
        } else if (sp < 1) {
          var ep = (sp - 0.78) / 0.22;
          opacity = 1 - ep;
          ty = -26 * ep;
        } else {
          opacity = 0; ty = -26;
        }

        setEl(texts[i], opacity, ty);
        setEl(visuals[i], opacity, ty);
      }
    }

    if (reduced) {
      texts.concat(visuals).forEach(function(el){ if(el){ el.style.opacity=1; el.style.transform="none"; } });
      return;
    }

    // Set initial state
    texts.concat(visuals).forEach(function(el){ if(el){ el.style.opacity=0; el.style.transform="translateY(44px)"; } });

    var ticking = false;
    window.addEventListener("scroll", function(){
      if (!ticking) { requestAnimationFrame(function(){ update(); ticking = false; }); ticking = true; }
    }, { passive: true });
    window.addEventListener("resize", update);
    update();
  })();

  /* SHOWCASE – Cinematic GSAP Animation */
  (function() {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;
    gsap.registerPlugin(ScrollTrigger);

    var spacer = document.getElementById('showcase');
    var container = document.getElementById('ch-container');
    if (!spacer || !container) return;

    var q  = function(sel) { return container.querySelectorAll(sel); };
    var q1 = function(sel) { return container.querySelector(sel); };

    gsap.set(q('.ch-text-main'),  { autoAlpha:0, y:60, scale:.85, filter:'blur(20px)', rotationX:15 });
    gsap.set(q('.ch-text-sub'),   { autoAlpha:0, clipPath:'inset(0 100% 0 0)' });
    gsap.set(q('.ch-main-card'),  { y: window.innerHeight + 200, autoAlpha:0 });
    gsap.set(q('.ch-left, .ch-right, .ch-phone-wrap, .ch-badge'), { autoAlpha:0 });
    gsap.set(q('.ch-blur-overlay'),   { autoAlpha:0 });
    gsap.set(q('.ch-website-layer'),  { filter:'blur(0px) brightness(1)' });

    setTimeout(function() {
      gsap.timeline()
        .to(q('.ch-text-main'), { duration:1.4, autoAlpha:1, y:0, scale:1, filter:'blur(0px)', rotationX:0, ease:'expo.out' })
        .to(q('.ch-text-sub'),  { duration:1.1, autoAlpha:1, clipPath:'inset(0 0% 0 0)', ease:'power4.inOut' }, '-=0.8');
    }, 200);

    var tl = gsap.timeline({
      scrollTrigger: {
        trigger: spacer,
        start: 'top top',
        end: 'bottom bottom',
        scrub: 0.5
      }
    });

    tl
      .to([q1('.ch-hero-text'), q1('.ch-grid')], { scale:1.05, filter:'blur(24px)', autoAlpha:0, ease:'power2.in', duration:1.4 })
      .to(q('.ch-main-card'), { y:0, autoAlpha:1, ease:'expo.out', duration:1.6 }, '-=0.7')
      .to(q('.ch-main-card'), { width:'100%', height:'100%', borderRadius:'0px', ease:'expo.inOut', duration:1.2 })
      .to(q('.ch-website-layer'), { filter:'blur(22px) brightness(0.75)', ease:'power2.inOut', duration:1.4 }, '-=1.0')
      .to(q('.ch-blur-overlay'), { autoAlpha:1, ease:'power2.inOut', duration:1.4 }, '<')
      .fromTo(q('.ch-left'),  { x:-40, autoAlpha:0 }, { x:0, autoAlpha:1, ease:'power3.out', duration:0.9 }, '-=0.6')
      .fromTo(q('.ch-right'), { x:40,  autoAlpha:0 }, { x:0, autoAlpha:1, ease:'power3.out', duration:0.9 }, '<')
      .fromTo(q('.ch-phone-wrap'),
        { y:220, z:300, rotationX:18, autoAlpha:0, scale:.75 },
        { y:0, z:0, rotationX:0, autoAlpha:1, scale:1, ease:'expo.out', duration:1.8 }, '-=0.5')
      .fromTo(q('.ch-pw'), { y:14, autoAlpha:0 }, { y:0, autoAlpha:1, stagger:0.1, ease:'back.out(1.1)', duration:0.9 }, '-=1.4')
      .to(q('.ch-progress-ring'), { strokeDashoffset:0, duration:1.8, ease:'power3.inOut' }, '-=1.0')
      .to(q('.ch-cv'), { innerHTML:67, snap:{ innerHTML:1 }, duration:1.8, ease:'expo.out' }, '<')
      .fromTo(q('.ch-badge'), { y:40, autoAlpha:0, scale:.88 }, { y:0, autoAlpha:1, scale:1, stagger:0.14, ease:'back.out(1.3)', duration:1.0 }, '-=1.4')
      .to({}, { duration:1.0 })
      .to([...q('.ch-badge'), ...q('.ch-left'), ...q('.ch-right')], { y:-40, autoAlpha:0, ease:'power2.in', duration:0.8 })
      .to(q('.ch-phone-wrap'),     { y:-160, scale:.85, autoAlpha:0, ease:'power2.in', duration:1.0 }, '<')
      .to(q('.ch-blur-overlay'),   { autoAlpha:0, ease:'power2.inOut', duration:0.9 }, '<0.2')
      .to(q('.ch-website-layer'),  { filter:'blur(0px) brightness(1)', ease:'power2.inOut', duration:0.9 }, '<')
      .to(q('.ch-main-card'),      { scale:.94, autoAlpha:0, filter:'blur(16px)', ease:'power2.in', duration:1.0 }, '-=0.5');
  })();

  /* Pill-Orbit: rein CSS (pill-orbit / pill-counter keyframes), kein JS nötig */

  /* Partner Cards – CSS-only hover, kein JS-Tilt */
