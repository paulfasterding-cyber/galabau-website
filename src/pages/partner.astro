---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Vertriebspartner werden – Bis zu 30% Provision | Fastra One"
  description="Empfiehl GaLaBau-Betriebe an Fastra One und verdiene bis zu 30% Provision. Auszahlung in 14 Tagen, kein Mindestumsatz, kein Risiko."
  canonical="https://fastraone.de/partner"
  navVariant="back"
  footerVariant="full"
>
  <Fragment slot="head">
    <meta name="robots" content="index, follow" />
    <style is:global>

body { background: #0b0f1a; }

/* ════════════════════════════════════════
   HERO
════════════════════════════════════════ */
.ph-hero {
  position: relative;
  background: #0b0f1a;
  overflow: visible;
  padding-bottom: 0;
}
.ph-hero-grid-bg {
  position: absolute; inset: 0; z-index: 0; pointer-events: none;
  background-image:
    linear-gradient(rgba(255,255,255,.018) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.018) 1px, transparent 1px);
  background-size: 72px 72px;
}
.ph-hero-glow {
  position: absolute;
  top: -220px; left: 50%; transform: translateX(-50%);
  width: 1000px; height: 700px;
  background: radial-gradient(ellipse at top center,
    rgba(110,236,157,.26) 0%,
    rgba(110,236,157,.09) 32%,
    rgba(110,236,157,.02) 56%,
    transparent 70%);
  pointer-events: none; z-index: 0;
}
.ph-hero-inner {
  position: relative; z-index: 2;
  max-width: 1180px; margin: 0 auto;
  padding: clamp(90px,11vw,125px) clamp(22px,5vw,64px) clamp(70px,9vw,110px);
  display: grid;
  grid-template-columns: 1fr 500px;
  gap: clamp(32px,5vw,64px);
  align-items: center;
}

/* Pill */
.ph-pill {
  display: inline-flex; align-items: center; gap: 9px;
  font-size: .86rem; font-weight: 600; color: rgba(255,255,255,.82);
  background: rgba(110,236,157,.1); border: 1px solid rgba(110,236,157,.22);
  padding: 7px 16px 7px 12px; border-radius: 999px; margin-bottom: 24px;
}
.ph-pill-dot {
  width: 8px; height: 8px; border-radius: 50%;
  background: #3dd87a; flex: none;
  animation: phPulse 2s ease-out infinite;
}
@keyframes phPulse {
  0%   { box-shadow: 0 0 0 0 rgba(34,197,94,.55); }
  70%  { box-shadow: 0 0 0 8px rgba(34,197,94,0); }
  100% { box-shadow: 0 0 0 0 rgba(34,197,94,0); }
}
.ph-h1 {
  font-family: "Plus Jakarta Sans","Inter",sans-serif;
  font-size: clamp(2.4rem,4vw,3.8rem); font-weight: 800;
  letter-spacing: -.035em; line-height: 1.04; color: #fff; margin-bottom: 18px;
}
.ph-h1 .accent {
  background: linear-gradient(90deg,#6EEC9D 0%,#22c55e 100%);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text;
}
.ph-lead {
  font-size: clamp(.95rem,1.7vw,1.05rem); color: rgba(255,255,255,.5);
  line-height: 1.7; max-width: 50ch; margin-bottom: 32px;
}
.ph-btn {
  display: inline-flex; align-items: center; gap: 10px; padding: 14px 28px;
  background: linear-gradient(180deg,#7ef0ab 0%,#54dd92 100%);
  color: #06351e; border-radius: 999px; font-weight: 700; font-size: .95rem;
  text-decoration: none; box-shadow: 0 5px 14px rgba(29,120,62,.22);
  transition: transform .15s, box-shadow .15s;
}
.ph-btn:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(29,120,62,.3); }
.ph-btn-sub { font-size: .76rem; color: rgba(255,255,255,.24); margin-top: 12px; }

/* ── KARTEN: weiter auseinander, beide gut sichtbar ── */
.ph-cards-wrap {
  position: relative; display: flex; align-items: center; justify-content: center;
  min-height: 340px;
}
.ph-stage { position: relative; width: 460px; height: 320px; }
.ph-cw--front {
  position: absolute; top: 20px; left: 0;
  transform: rotate(-7deg); z-index: 3;
  filter: drop-shadow(0 44px 88px rgba(0,0,0,.78)) drop-shadow(0 0 1px rgba(255,255,255,.05));
}
.ph-cw--back {
  position: absolute; top: 60px; left: 150px;
  transform: rotate(11deg); z-index: 2;
  filter: drop-shadow(0 30px 64px rgba(0,0,0,.65));
}
.ph-card {
  width: 286px; height: 179px; border-radius: 15px;
  position: relative; overflow: hidden;
}
.ph-card::before {
  content: ''; position: absolute; top: 0; left: 8%; right: 8%; height: 1px;
  background: linear-gradient(90deg,transparent,rgba(255,255,255,.6),transparent);
  z-index: 10; pointer-events: none;
}
.ph-card--green {
  background: linear-gradient(148deg,
    #010c04 0%,#061a0e 8%,#0d2e1e 18%,#164534 28%,
    #1e6448 38%,#2e8a5c 46%,#52c87e 50%,#6EEC9D 52%,
    #52c87e 56%,#2e8a5c 64%,#1e6448 74%,#164534 84%,
    #0d2e1e 93%,#010c04 100%);
  box-shadow: 0 0 0 1px rgba(255,255,255,.08), inset 0 1px 0 rgba(255,255,255,.18);
}
.ph-card--dark {
  background: linear-gradient(148deg,
    rgba(14,18,40,.97) 0%,rgba(28,36,80,.97) 20%,
    rgba(60,80,150,.92) 42%,rgba(110,130,200,.90) 50%,
    rgba(60,80,150,.92) 58%,rgba(28,36,80,.97) 80%,
    rgba(14,18,40,.97) 100%);
  border: 1px solid rgba(160,180,255,.18);
}
.ph-card__shine {
  position: absolute; inset: 0; border-radius: 13px;
  background: linear-gradient(145deg,rgba(255,255,255,.12) 0%,rgba(255,255,255,.02) 40%,transparent 60%);
  pointer-events: none; z-index: 8; mix-blend-mode: screen;
}
.ph-card--green .ph-card__shine {
  background: linear-gradient(145deg,rgba(255,255,255,.10) 0%,rgba(110,236,157,.05) 38%,transparent 58%);
}
.ph-card__logo {
  position: absolute; top: 13px; left: 14px; height: 15px; width: auto;
  filter: brightness(0) invert(1); opacity: .65; z-index: 10;
}
.ph-card__level {
  position: absolute; top: 14px; right: 14px;
  font-size: .43rem; font-weight: 800; letter-spacing: .22em;
  color: rgba(255,255,255,.28); text-transform: uppercase; z-index: 10;
}
.ph-card__center {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%,-48%);
  text-align: center; z-index: 10;
}
.ph-card__pct {
  font-size: 2.4rem; font-weight: 900; letter-spacing: -.07em; line-height: 1;
  color: transparent;
  background: linear-gradient(158deg,rgba(255,255,255,.98) 0%,#6EEC9D 45%,rgba(255,255,255,.88) 78%);
  -webkit-background-clip: text; background-clip: text;
  filter: drop-shadow(0 0 18px rgba(110,236,157,.5));
}
.ph-card--dark .ph-card__pct {
  background: linear-gradient(158deg,rgba(255,255,255,.95) 0%,#a8beff 45%,rgba(255,255,255,.88) 78%);
  -webkit-background-clip: text; background-clip: text;
  filter: drop-shadow(0 0 14px rgba(140,160,255,.4));
}
.ph-card__sublabel {
  font-size: .44rem; font-weight: 700; letter-spacing: .2em;
  text-transform: uppercase; color: rgba(255,255,255,.24); margin-top: 5px;
}
.ph-card__foot {
  position: absolute; bottom: 12px; left: 14px; right: 14px; z-index: 10;
}
.ph-card__name { font-size: .44rem; text-transform: uppercase; letter-spacing: .1em; color: rgba(255,255,255,.18); margin-bottom: 2px; }
.ph-card__tier { font-size: .62rem; font-weight: 700; color: rgba(255,255,255,.62); }
.ph-card--dark .ph-card__tier { color: rgba(175,195,255,.62); }

/* Floating Chips */
.ph-chip {
  position: absolute; background: rgba(8,10,18,.88);
  border: 1px solid rgba(110,236,157,.15); border-radius: 999px;
  padding: 6px 13px; display: flex; align-items: center; gap: 7px;
  font-size: .68rem; color: rgba(255,255,255,.45); white-space: nowrap;
  box-shadow: 0 6px 20px rgba(0,0,0,.35); backdrop-filter: blur(12px); z-index: 15;
}
.ph-chip__dot { width: 5px; height: 5px; border-radius: 50%; background: #6EEC9D; flex-shrink: 0; box-shadow: 0 0 5px rgba(110,236,157,.5); }
.ph-chip--tl { top: 5px; left: -10px; }
.ph-chip--br { bottom: 15px; right: -10px; border-color: rgba(160,180,255,.14); }
.ph-chip--br .ph-chip__dot { background: #a8beff; box-shadow: 0 0 5px rgba(140,160,255,.45); }

/* Wave */
.ph-wave { display: block; line-height: 0; background: #f5f5f5; position: relative; z-index: 1; }
.ph-wave svg { display: block; width: 100%; height: 100px; }

/* ════════════════════════════════════════
   HELLER BEREICH
════════════════════════════════════════ */
.ph-light { background: #f5f5f5; }

/* Gemeinsame Section */
.ph-sect { padding: clamp(60px,8vw,100px) 0; }
.ph-sect-inner { max-width: 1180px; margin: 0 auto; padding: 0 clamp(22px,5vw,64px); }
.ph-label {
  font-size: .62rem; font-weight: 700; letter-spacing: .18em;
  text-transform: uppercase; color: #9ca3af; margin-bottom: 9px;
}
.ph-title {
  font-family: "Plus Jakarta Sans","Inter",sans-serif;
  font-size: clamp(1.4rem,2.6vw,2rem); font-weight: 800;
  color: #0a0c10; letter-spacing: -.04em; line-height: 1.12; margin-bottom: 32px;
}

/* ── TIERS ── */
.ph-tiers-grid {
  display: grid; grid-template-columns: repeat(3,1fr); gap: 16px;
}
.ph-tier {
  border-radius: 20px; padding: 32px 28px; position: relative; overflow: hidden;
  transition: transform .2s, box-shadow .2s;
}
.ph-tier:hover { transform: translateY(-3px); }

.ph-tier--starter {
  background: #fff; border: 1.5px solid #d1fae5;
  box-shadow: 0 2px 20px rgba(22,165,102,.07);
}
.ph-tier--gold {
  background: linear-gradient(160deg,#fffcf0 0%,#fffbeb 100%);
  border: 1.5px solid #fde68a; box-shadow: 0 2px 20px rgba(217,119,6,.09);
}
.ph-tier--platin {
  background: linear-gradient(160deg,#f5f6ff 0%,#eef0ff 100%);
  border: 1.5px solid #c7d2fe;
  box-shadow: 0 2px 20px rgba(99,102,241,.1);
}

.ph-tier-top-badge {
  position: absolute; top: 16px; right: 16px;
  font-size: .52rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
  background: rgba(99,102,241,.1); border: 1px solid rgba(99,102,241,.22);
  color: #3730a3; padding: 3px 9px; border-radius: 999px;
}

.ph-tier-badge {
  display: inline-flex; align-items: center; gap: 5px;
  font-size: .57rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase;
  border-radius: 999px; padding: 4px 11px; margin-bottom: 18px;
}
.ph-tier-badge--starter { color: #14532d; background: rgba(22,165,102,.1); border: 1px solid rgba(22,165,102,.2); }
.ph-tier-badge--gold    { color: #92400e; background: rgba(217,119,6,.1);  border: 1px solid rgba(217,119,6,.22); }
.ph-tier-badge--platin  { color: #3730a3; background: rgba(99,102,241,.1); border: 1px solid rgba(99,102,241,.22); }

.ph-tier-pct {
  font-family: "Plus Jakarta Sans","Inter",sans-serif; font-size: 2.7rem; font-weight: 900;
  letter-spacing: -.05em; margin-bottom: 4px; line-height: 1;
}
.ph-tier-pct--starter { color: #16a566; }
.ph-tier-pct--gold {
  background: linear-gradient(135deg,#f59e0b 0%,#d97706 100%);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
}
.ph-tier-pct--platin {
  background: linear-gradient(135deg,#4f46e5 0%,#818cf8 45%,#4f46e5 90%);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
}

.ph-tier-name { font-size: .95rem; font-weight: 700; color: #111827; margin-bottom: 10px; margin-top: 2px; }
.ph-tier--platin .ph-tier-name { color: #1e1b4b; }
.ph-tier-desc { font-size: .8rem; color: #6b7280; line-height: 1.7; margin-bottom: 20px; }
.ph-tier--platin .ph-tier-desc { color: #6b7280; }
.ph-tier-cond { font-size: .68rem; color: #9ca3af; padding-top: 16px; border-top: 1px solid rgba(0,0,0,.06); }
.ph-tier--platin .ph-tier-cond { color: #6366f1; border-top-color: rgba(99,102,241,.15); }

/* ── VERGLEICH ── */
.ph-compare-card {
  background: #fff; border: 1px solid rgba(0,0,0,.07); border-radius: 18px; overflow: hidden;
}
.ph-compare-head {
  display: grid; grid-template-columns: minmax(160px,2fr) repeat(4,1fr);
  padding: 13px 20px; background: #f9fafb;
  border-bottom: 1px solid rgba(0,0,0,.07); gap: 12px;
}
.ph-compare-head span {
  font-size: .62rem; font-weight: 700; letter-spacing: .08em;
  text-transform: uppercase; color: #9ca3af;
}
.ph-compare-head span:not(:first-child) { text-align: center; }
.ph-compare-row {
  display: grid; grid-template-columns: minmax(160px,2fr) repeat(4,1fr);
  padding: 13px 20px; gap: 12px;
  border-bottom: 1px solid rgba(0,0,0,.04);
}
.ph-compare-row:last-child { border-bottom: none; }
.ph-compare-row--us { background: #f0fdf4; }
.ph-compare-row > * { font-size: .83rem; color: #9ca3af; display: flex; align-items: center; }
.ph-compare-row > *:not(:first-child) { justify-content: center; }
.ph-compare-row--us > * { color: #374151; }
.ph-compare-row__name { font-weight: 600; color: #111827; }
.ph-compare-row--us .ph-compare-row__name { color: #14532d; }
.ph-ci { color: #16a566; font-weight: 700; }
.ph-xi { color: #d1d5db; }
.ph-compare-logo {
  height: 17px; width: auto;
  filter: brightness(0) saturate(100%) invert(41%) sepia(82%) saturate(456%) hue-rotate(118deg) brightness(95%);
}

/* ── 3 SCHRITTE ── */
.ph-how-grid {
  display: grid; grid-template-columns: repeat(3,1fr); gap: 0;
  border: 1px solid rgba(0,0,0,.07); border-radius: 20px; overflow: hidden;
}
.ph-how-step {
  background: #fff; padding: 36px 32px;
  border-right: 1px solid rgba(0,0,0,.07); position: relative;
}
.ph-how-step:last-child { border-right: none; }
.ph-how-step:not(:last-child)::after {
  content: '→'; position: absolute;
  top: 50%; right: -14px; transform: translateY(-50%);
  font-size: 1.1rem; color: #d1d5db; z-index: 3;
  background: #fff; width: 26px; height: 26px;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%; border: 1px solid rgba(0,0,0,.07);
}
.ph-how-num-circle {
  width: 48px; height: 48px; border-radius: 50%;
  background: linear-gradient(135deg,#f0fdf4,#dcfce7);
  border: 1.5px solid rgba(22,165,102,.22);
  display: flex; align-items: center; justify-content: center;
  font-size: .82rem; font-weight: 900; color: #16a566;
  margin-bottom: 20px; font-family: "Plus Jakarta Sans","Inter",sans-serif;
  box-shadow: 0 2px 10px rgba(22,165,102,.1);
}
.ph-how-title { font-size: 1rem; font-weight: 700; color: #111827; margin-bottom: 10px; }
.ph-how-text { font-size: .82rem; color: #6b7280; line-height: 1.75; }

/* ── CTA ── */
.ph-cta-card {
  background: #0b0f1a; border-radius: 24px;
  padding: clamp(48px,7vw,80px) clamp(28px,6vw,72px);
  text-align: center; position: relative; overflow: hidden;
}
.ph-cta-card::before {
  content: ''; position: absolute; top: -80px; left: 50%; transform: translateX(-50%);
  width: 600px; height: 400px;
  background: radial-gradient(ellipse at top, rgba(110,236,157,.12) 0%, transparent 65%);
  pointer-events: none;
}
.ph-cta-card h2 {
  font-family: "Plus Jakarta Sans","Inter",sans-serif;
  font-size: clamp(1.5rem,2.8vw,2.2rem); font-weight: 800;
  color: #fff; letter-spacing: -.04em; line-height: 1.1;
  margin-bottom: 14px; position: relative; z-index: 1;
}
.ph-cta-card p {
  font-size: .92rem; color: rgba(255,255,255,.38); line-height: 1.7;
  max-width: 48ch; margin: 0 auto 28px; position: relative; z-index: 1;
}
.ph-cta-card .ph-btn { position: relative; z-index: 1; }
.ph-cta-meta { margin-top: 14px; font-size: .72rem; color: rgba(255,255,255,.18); position: relative; z-index: 1; }

/* ── FAQ: 1:1 wie Homepage (Grid-Papier-Hintergrund) ── */
.ph-sect--grid { position: relative; }
.ph-sect--grid::before {
  content: ""; position: absolute; inset: 0; z-index: 0; pointer-events: none;
  background-image:
    linear-gradient(to right, rgba(110,236,157,.07) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(110,236,157,.07) 1px, transparent 1px);
  background-size: 30px 30px;
  -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 22%, #000 78%, transparent 100%);
  mask-image: linear-gradient(to bottom, transparent 0%, #000 22%, #000 78%, transparent 100%);
}
.ph-sect--grid > .ph-sect-inner { position: relative; z-index: 1; }
.pfaq { max-width: 820px; margin-inline: auto; }
.pfaq__item {
  background: #fff; border: 1px solid rgba(61,61,61,.12);
  border-radius: 18px; padding: 4px 24px;
  box-shadow: 0 1px 20px rgba(0,0,0,.05); margin-bottom: 14px;
}
.pfaq__item summary {
  list-style: none; cursor: pointer;
  display: flex; align-items: center; justify-content: space-between;
  gap: 16px; padding: 20px 0;
  font-size: 1.08rem; font-weight: 700; color: #0c0d10; letter-spacing: -.01em;
}
.pfaq__item summary::-webkit-details-marker { display: none; }
.pfaq__chev {
  width: 22px; height: 22px; flex: none; color: #737373;
  stroke: currentColor; stroke-width: 2; fill: none;
  stroke-linecap: round; stroke-linejoin: round;
  transition: transform .25s ease;
}
.pfaq__item[open] .pfaq__chev { transform: rotate(180deg); }
.pfaq__item p {
  padding: 0 0 22px; margin: 0; color: #737373; line-height: 1.65;
  animation: pfaqIn .22s ease both;
}
@keyframes pfaqIn {
  from { opacity: 0; transform: translateY(-6px); }
  to   { opacity: 1; transform: none; }
}

/* Responsive */
@media (max-width: 960px) {
  .ph-hero-inner { grid-template-columns: 1fr; }
  .ph-cards-wrap { min-height: 280px; }
  .ph-stage { transform: scale(.84); transform-origin: top center; }
}
@media (max-width: 680px) {
  .ph-tiers-grid { grid-template-columns: 1fr; }
  .ph-tier { border-right: none; border-bottom: 1px solid rgba(0,0,0,.07); }
  .ph-tier:last-child { border-bottom: none; }
  .ph-compare-head,
  .ph-compare-row { grid-template-columns: 1fr repeat(2,1fr); }
  .ph-compare-head span:nth-child(n+4),
  .ph-compare-row > *:nth-child(n+4) { display: none; }
  .ph-how-grid { grid-template-columns: 1fr; }
  .ph-how-step { border-right: none; border-bottom: 1px solid rgba(0,0,0,.07); }
  .ph-how-step:last-child { border-bottom: none; }
  .ph-stage { transform: scale(.74); transform-origin: top center; }
}

    </style>
  </Fragment>

  <!-- HERO -->
  <section class="ph-hero">
    <div class="ph-hero-grid-bg" aria-hidden="true"></div>
    <div class="ph-hero-glow" aria-hidden="true"></div>
    <div class="ph-hero-inner">

      <!-- Links: Text -->
      <div>
        <div class="ph-pill"><span class="ph-pill-dot"></span>Partnerprogramm ist geöffnet</div>
        <h1 class="ph-h1">Dein Netzwerk.<br><span class="accent">Deine Provision.</span></h1>
        <p class="ph-lead">
          Du kennst GaLaBau-Betriebe, die mehr Kunden brauchen? Stell den Kontakt her und wir übernehmen alles danach. Du verdienst bis zu 30&nbsp;% Provision, direkt ausgezahlt.
        </p>
        <a href="/partner-bewerbung" class="ph-btn">
          Jetzt bewerben
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
        <p class="ph-btn-sub">Kostenlos · Keine Laufzeit · Auszahlung in 14 Tagen</p>
      </div>

      <!-- Rechts: Karten -->
      <div class="ph-cards-wrap">
        <div class="ph-chip ph-chip--tl"><span class="ph-chip__dot"></span>Empfehlung aktiv</div>
        <div class="ph-chip ph-chip--br"><span class="ph-chip__dot"></span>Auszahlung in 14 Tagen</div>
        <div class="ph-stage">
          <div class="ph-cw--front">
            <div class="ph-card ph-card--green">
              <div class="ph-card__shine"></div>
              <img src="assets/logo.png" class="ph-card__logo" alt="Fastra One" width="946" height="482" loading="lazy" decoding="async" />
              <span class="ph-card__level">Starter</span>
              <div class="ph-card__center">
                <div class="ph-card__pct">20%</div>
                <div class="ph-card__sublabel">Provision</div>
              </div>
              <div class="ph-card__foot">
                <div class="ph-card__name">Empfehlungs-Programm</div>
                <div class="ph-card__tier">Starter Partner</div>
              </div>
            </div>
          </div>
          <div class="ph-cw--back">
            <div class="ph-card ph-card--dark">
              <div class="ph-card__shine"></div>
              <img src="assets/logo.png" class="ph-card__logo" alt="Fastra One" width="946" height="482" loading="lazy" decoding="async" />
              <span class="ph-card__level">Platin</span>
              <div class="ph-card__center">
                <div class="ph-card__pct">30%</div>
