---
interface Props {
  variant?: 'full' | 'back' | 'minimal';
  backHref?: string;
  backLabel?: string;
}
const { variant = 'full', backHref = 'index.html', backLabel = 'Startseite' } = Astro.props;
---

{variant === 'full' && (
  <header class="navwrap" id="top">
    <nav class="nav2" id="nav2-main" aria-label="Hauptnavigation">
      <a href="#top" class="brand" aria-label="Fastra One">
        <img class="logo logo--nav" src="assets/logo.png" alt="Fastra One" />
      </a>
      <ul class="nav2__links">
        <li><a href="#leistungen">Leistungen</a></li>
        <li><a href="#preise">Preise</a></li>
        <li><a href="case-studies.html">Case Studies</a></li>
        <li><a href="blog.html">Ratgeber</a></li>
        <li><a href="#faq">FAQ</a></li>
        <li><a href="partner.html" class="nav2__partner">Partner</a></li>
      </ul>
      <a href="kontakt.html" class="btn btn--primary nav2__cta">Kontaktiere Uns</a>
      <button class="nav2__burger" id="burger-main" aria-label="Menü" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </nav>
    <div class="nav2__mobile-menu" id="mobile-menu-main">
      <a href="#leistungen">Leistungen</a>
      <a href="#preise">Preise</a>
      <a href="case-studies.html">Case Studies</a>
      <a href="blog.html">Ratgeber</a>
      <a href="#faq">FAQ</a>
      <a href="partner.html">Partner</a>
      <a href="kontakt.html" class="btn btn--primary">Kontaktiere Uns</a>
    </div>
  </header>
)}

{variant === 'back' && (
  <header class="navwrap">
    <nav class="nav2" id="nav2-back" aria-label="Navigation">
      <a href="index.html" class="brand" aria-label="Fastra One – Start">
        <img class="logo" src="assets/logo.png" alt="Fastra One" />
      </a>
      <ul class="nav2__links">
        <li><a href="index.html#leistungen">Leistungen</a></li>
        <li><a href="index.html#preise">Preise</a></li>
        <li><a href="case-studies.html">Case Studies</a></li>
        <li><a href="blog.html">Ratgeber</a></li>
        <li><a href="index.html#faq">FAQ</a></li>
        <li><a href="partner.html" class="nav2__partner">Partner</a></li>
      </ul>
      <a href="kontakt.html" class="btn btn--primary nav2__cta">Kontaktiere Uns</a>
      <button class="nav2__burger" id="burger-back" aria-label="Menü" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </nav>
    <div class="nav2__mobile-menu" id="mobile-menu-back">
      <a href="index.html">← Zur Startseite</a>
      <a href="index.html#leistungen">Leistungen</a>
      <a href="index.html#preise">Preise</a>
      <a href="case-studies.html">Case Studies</a>
      <a href="blog.html">Ratgeber</a>
      <a href="index.html#faq">FAQ</a>
      <a href="partner.html">Partner</a>
      <a href="kontakt.html" class="btn btn--primary">Kontaktiere Uns</a>
    </div>
  </header>
)}

<style is:global>
  .nav2__partner {
    background: rgba(110,236,157,.1) !important;
    border: 1px solid rgba(110,236,157,.22) !important;
    border-radius: 999px !important;
    padding: 3px 13px !important;
    color: #6EEC9D !important;
    font-weight: 700 !important;
    transition: background .15s !important;
    text-decoration: none;
  }
  .nav2__partner:hover {
    background: rgba(110,236,157,.2) !important;
  }
  .nav2__back {
    display: inline-flex; align-items: center; gap: 7px; margin-left: auto;
    color: rgba(255,255,255,.6); font-size: .88rem; font-weight: 600;
    background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.1);
    border-radius: 999px; padding: 7px 15px 7px 11px;
    transition: background .15s, color .15s; text-decoration: none;
  }
  .nav2__back:hover { background: rgba(255,255,255,.13); color: #fff; }
  .nav2__back svg { flex: none; transition: transform .15s; }
  .nav2__back:hover svg { transform: translateX(-2px); }
</style>

<script is:inline>
(function(){
  var burger = document.getElementById('burger-main') || document.getElementById('burger-back');
  var nav = burger && burger.closest('.nav2');
  if (!burger || !nav) return;
  burger.addEventListener('click', function(){
    var open = nav.classList.toggle('is-open');
    burger.setAttribute('aria-expanded', String(open));
  });
  // Menü schließen wenn Link angeklickt
  var menu = nav.nextElementSibling;
  if (menu) menu.querySelectorAll('a').forEach(function(a){
    a.addEventListener('click', function(){ nav.classList.remove('is-open'); burger.setAttribute('aria-expanded','false'); });
  });
})();
</script>

{variant === 'minimal' && (
  <header class="navwrap">
    <nav class="nav2" aria-label="Navigation">
      <a href="index.html" class="home" aria-label="Fastra One – Start">
        <img class="logo" src="assets/logo.png" alt="Fastra One" />
      </a>
      <a href={backHref} class="nav2__back" aria-label={`Zurück zu ${backLabel}`}>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
        {backLabel}
      </a>
    </nav>
  </header>
)}
